# Kora Payment Gateway & Webhook Orchestrator Configuration
PORT=7582
HOST=0.0.0.0
ENVIRONMENT=production

# Database & Ledger Storage
DATABASE_URL=postgres://kora_pay_user:kora_pay_secret_password@localhost:5432/payment_gateway_db
REDIS_URL=redis://:kora_redis_payment_pass@localhost:6379/0

# Provider Webhook Signing Secrets
STRIPE_WEBHOOK_SECRET=whsec_stripe_test_secret_key_32chars
ADYEN_HMAC_KEY=adyen_hex_hmac_secret_key_64chars
PAYPAL_WEBHOOK_ID=webhook_paypal_production_id_9921

# PSD2 & 3D Secure 2.0 Invariants
THREEDS_SCA_THRESHOLD_EUR_CENTS=5000
HIGH_VALUE_THRESHOLD_USD_CENTS=1000000
