// ============================================================================
// Unit Test Suite: Service Mesh Sidecar Proxy & Traffic Director
// Verifies Consensus Invariants, Quorum Validation, and Heartbeats
// ============================================================================

import { CreateServiceMeshProxyTaskRequest } from "../models/service_mesh_proxy_request.dto"
import { ServiceMeshProxyClusterRepository } from "../repositories/service_mesh_proxy_cluster.repository"
import { ServiceMeshProxyCoreService } from "../services/service_mesh_proxy_core.service"
import { ServiceMeshProxyHeartbeatService } from "../services/service_mesh_proxy_heartbeat.service"

class ServiceMeshProxyUnitTestSuite {
    service: ServiceMeshProxyCoreService
    heartbeat: ServiceMeshProxyHeartbeatService

    init(service: ServiceMeshProxyCoreService, heartbeat: ServiceMeshProxyHeartbeatService) {
        this.service = service
        this.heartbeat = heartbeat
    }

    fn test_consensus_command_processing() -> Bool {
        let req = CreateServiceMeshProxyTaskRequest {
            taskKey: "TASK-REPLICATE-101",
            originatingNodeId: 1,
            payloadVolume: 500,
            targetCluster: "ProductionClusterEast",
        }
        let res = this.service.processConsensusCommand(req)
        return match res {
            Ok(state) => state.id == 1 && state.isLeader,
            Err(e) => false,
        }
    }

    fn test_invalid_originating_node_rejected() -> Bool {
        let req = CreateServiceMeshProxyTaskRequest {
            taskKey: "TASK-INVALID",
            originatingNodeId: -1,
            payloadVolume: 100,
            targetCluster: "ProductionClusterEast",
        }
        let res = this.service.processConsensusCommand(req)
        return match res {
            Ok(s) => false,
            Err(e) => e == "Originating node ID must be strictly positive",
        }
    }

    fn test_quorum_evaluation() -> Bool {
        return this.service.evaluateClusterQuorum()
    }

    fn test_heartbeat_ping() -> Bool {
        return this.heartbeat.pingPeer(2)
    }

    fn run() -> Unit {
        let t1 = this.test_consensus_command_processing()
        let t2 = this.test_invalid_originating_node_rejected()
        let t3 = this.test_quorum_evaluation()
        let t4 = this.test_heartbeat_ping()

        if t1 && t2 && t3 && t4 {
            print("  ✓ Service Mesh Sidecar Proxy & Traffic Director Unit Tests: 4/4 passed (Quorum, Invariants & Heartbeats Verified)")
        } else {
            print("  ✗ Service Mesh Sidecar Proxy & Traffic Director Unit Tests: failed")
        }
    }
}

let repo = ServiceMeshProxyClusterRepository()
let service = ServiceMeshProxyCoreService(repo)
let heartbeat = ServiceMeshProxyHeartbeatService()
let suite = ServiceMeshProxyUnitTestSuite(service, heartbeat)
suite.run()
