// Example 31: Inter-Bank Reconciliation & Settlement
// Command Controller (Mutations & Writes)

import { CreateReconciliationSettlementRequest } from "../models/reconciliation_settlement_request.dto"
import { ReconciliationSettlementResponse } from "../models/reconciliation_settlement_response.dto"
import { ReconciliationSettlementCoreService } from "../services/reconciliation_settlement_core.service"

class ReconciliationSettlementCommandController {
    service: ReconciliationSettlementCoreService

    init(service: ReconciliationSettlementCoreService) {
        this.service = service
    }

    fn handleCreate(req: CreateReconciliationSettlementRequest) -> ReconciliationSettlementResponse {
        let outcome = this.service.processRequest(req)
        return match outcome {
            Ok(rec) => ReconciliationSettlementResponse {
                id: rec.id,
                reference: rec.reference,
                success: true,
                statusCode: 201,
                message: "Created successfully",
            },
            Err(reason) => ReconciliationSettlementResponse {
                id: -1,
                reference: req.reference,
                success: false,
                statusCode: 400,
                message: reason,
            },
        }
    }
}
