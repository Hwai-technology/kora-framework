// Example 59: Reverse Logistics & RMA Inspection Engine
// Presentation Controller

import { CreateReturnsRmaManagementTaskRequest } from "../models/returns_rma_management_request.dto"
import { ReturnsRmaManagementResponseDto } from "../models/returns_rma_management_response.dto"
import { ReturnsRmaManagementCoreService } from "../services/returns_rma_management_core.service"

class ReturnsRmaManagementController {
    service: ReturnsRmaManagementCoreService

    init(service: ReturnsRmaManagementCoreService) {
        this.service = service
    }

    fn handleTaskSubmission(req: CreateReturnsRmaManagementTaskRequest) -> ReturnsRmaManagementResponseDto {
        let outcome = this.service.executeTask(req)
        return match outcome {
            Ok(rec) => ReturnsRmaManagementResponseDto {
                operationId: "TX-" + req.taskKey,
                entityId: rec.id,
                status: "EXECUTION_SUCCESSFUL",
                isVerified: true,
                message: "Operation completed under Clean Architecture invariants",
            },
            Err(reason) => ReturnsRmaManagementResponseDto {
                operationId: "TX-FAILED",
                entityId: req.targetEntityId,
                status: "EXECUTION_REJECTED",
                isVerified: false,
                message: reason,
            },
        }
    }

    fn inspectHealth(entityId: Int) -> String {
        return this.service.evaluateHealth(entityId)
    }
}
