// Example 86: SIEM High-Throughput Log Ingestion & CEF Normalizer
// Core Domain Service Implementation

import { SiemLogIngestionPipelinePrimaryRecord } from "../entities/siem_log_ingestion_pipeline_primary.entity"
import { CreateSiemLogIngestionPipelineTaskRequest } from "../models/siem_log_ingestion_pipeline_request.dto"
import { SiemLogIngestionPipelineRepository } from "../interfaces/siem_log_ingestion_pipeline_repository.interface"
import { SiemLogIngestionPipelineDomainContract } from "../interfaces/siem_log_ingestion_pipeline_service.interface"

class SiemLogIngestionPipelineCoreService implements SiemLogIngestionPipelineDomainContract {
    repo: SiemLogIngestionPipelineRepository

    init(repo: SiemLogIngestionPipelineRepository) {
        this.repo = repo
    }

    fn executeTask(req: CreateSiemLogIngestionPipelineTaskRequest) -> Result<SiemLogIngestionPipelinePrimaryRecord, String> {
        if req.targetEntityId <= 0 {
            return Err("Target entity ID must be strictly positive")
        }
        if req.workloadCapacity <= 0 {
            return Err("Workload capacity must be strictly positive")
        }

        let record = SiemLogIngestionPipelinePrimaryRecord {
            id: req.targetEntityId,
            referenceCode: req.taskKey,
            capacityScore: req.workloadCapacity,
            operationalStatus: "COMMITTED_HEALTHY",
            active: true,
        }
        return this.repo.save(record)
    }

    fn evaluateHealth(entityId: Int) -> String {
        let opt = this.repo.findById(entityId)
        let isPresent = match opt {
            Some(r) => true,
            None => false,
        }
        if !isPresent {
            return "ENTITY_NOT_FOUND"
        }
        let record = match opt {
            Some(r) => r,
            None => SiemLogIngestionPipelinePrimaryRecord { id: 0, referenceCode: "", capacityScore: 0, operationalStatus: "", active: false },
        }
        if record.capacityScore > 80 {
            return "OPTIMUM_PERFORMANCE"
        }
        if record.capacityScore > 40 {
            return "MODERATE_NORMAL"
        }
        return "LOW_CAPACITY"
    }
}
