// Example 86: SIEM High-Throughput Log Ingestion & CEF Normalizer
// Persistent Database Entity: Primary Record

@table("siem_log_ingestion_pipeline_records")
model SiemLogIngestionPipelinePrimaryRecord {
    @id
    id: Int
    @unique
    referenceCode: String
    capacityScore: Int
    operationalStatus: String
    active: Bool
}
