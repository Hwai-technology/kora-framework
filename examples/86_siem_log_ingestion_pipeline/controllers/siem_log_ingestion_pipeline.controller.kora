// Example 86: SIEM High-Throughput Log Ingestion & CEF Normalizer
// Presentation Controller

import { CreateSiemLogIngestionPipelineTaskRequest } from "../models/siem_log_ingestion_pipeline_request.dto"
import { SiemLogIngestionPipelineResponseDto } from "../models/siem_log_ingestion_pipeline_response.dto"
import { SiemLogIngestionPipelineCoreService } from "../services/siem_log_ingestion_pipeline_core.service"

class SiemLogIngestionPipelineController {
    service: SiemLogIngestionPipelineCoreService

    init(service: SiemLogIngestionPipelineCoreService) {
        this.service = service
    }

    fn handleTaskSubmission(req: CreateSiemLogIngestionPipelineTaskRequest) -> SiemLogIngestionPipelineResponseDto {
        let outcome = this.service.executeTask(req)
        return match outcome {
            Ok(rec) => SiemLogIngestionPipelineResponseDto {
                operationId: "TX-" + req.taskKey,
                entityId: rec.id,
                status: "EXECUTION_SUCCESSFUL",
                isVerified: true,
                message: "Operation completed under Clean Architecture invariants",
            },
            Err(reason) => SiemLogIngestionPipelineResponseDto {
                operationId: "TX-FAILED",
                entityId: req.targetEntityId,
                status: "EXECUTION_REJECTED",
                isVerified: false,
                message: reason,
            },
        }
    }

    fn inspectHealth(entityId: Int) -> String {
        return this.service.evaluateHealth(entityId)
    }
}
