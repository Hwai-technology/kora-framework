// ============================================================================
// Order Event Routing
// ============================================================================

import { OrderEventsController } from "../controllers/order_events.controller"

class OrderEventsRoutes {
    controller: OrderEventsController

    init(controller: OrderEventsController) {
        this.controller = controller
    }

    fn register() -> Unit {
        post("/events/orders/publish/:type", this.controller.publish)
        post("/events/orders/consume/:id", this.controller.consume)
        get("/events/orders/telemetry", this.controller.telemetry)
    }
}
