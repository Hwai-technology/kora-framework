// ============================================================================
// Distributed Event Publisher & Retry / DLQ Dispatcher Service
// Implements Transactional Outbox, Idempotency, and Exponential Backoff
// ============================================================================

import { EventEnvelope, ConsumerAck, OutboxTelemetry } from "../models/event_envelope.model"
import { EventStoreRepository } from "../repositories/event_store.repository"

class EventPublisherService {
    repo: EventStoreRepository
    sequenceCounter: Int

    init(repo: EventStoreRepository) {
        this.repo = repo
        this.sequenceCounter = 5000
    }

    fn publishOrderEvent(
        eventType: String,
        partitionKey: String,
        idempotencyKey: String,
        payload: String
    ) -> Result<EventEnvelope, String> {
        this.sequenceCounter = this.sequenceCounter + 1
        let eid = "evt_" + this.sequenceCounter.toString()
        let cid = "corr_" + this.sequenceCounter.toString()

        let envelope = EventEnvelope {
            eventId: eid,
            correlationId: cid,
            idempotencyKey: idempotencyKey,
            eventType: eventType,
            partitionKey: partitionKey,
            payload: payload,
            sequenceNumber: this.sequenceCounter,
            attempts: 0,
            status: "PendingOutbox",
            timestamp: 1710000000,
        }

        return this.repo.saveToOutbox(envelope)
    }

    fn processIncomingDelivery(eventId: String, isPoisonPill: Bool) -> ConsumerAck {
        let optEnv = this.repo.findById(eventId)
        let isPresent = match optEnv {
            Some(e) => true,
            None => false,
        }
        if !isPresent {
            return ConsumerAck {
                eventId: eventId,
                success: false,
                retryAfterMs: 0,
                routedToDlq: false,
                errorReason: "ERR_EVENT_NOT_FOUND",
            }
        }

        if !isPoisonPill {
            this.repo.markDelivered(eventId)
            return ConsumerAck {
                eventId: eventId,
                success: true,
                retryAfterMs: 0,
                routedToDlq: false,
                errorReason: "NONE",
            }
        }

        // Poisonous event failure path: Increment retry attempts
        let attempt = this.repo.recordRetryAttempt(eventId)
        if attempt >= 3 {
            // Threshold exceeded: Route to Dead Letter Queue (DLQ)
            this.repo.moveToDeadLetterQueue(eventId, "MAX_RETRY_ATTEMPTS_EXCEEDED")
            return ConsumerAck {
                eventId: eventId,
                success: false,
                retryAfterMs: 0,
                routedToDlq: true,
                errorReason: "DEAD_LETTER_QUEUE: Maximum 3 retries exceeded",
            }
        }

        // Exponential backoff: 100ms * 2^(attempt)
        var backoffMs = 100
        if attempt == 2 {
            backoffMs = 200
        } else if attempt == 3 {
            backoffMs = 400
        }

        return ConsumerAck {
            eventId: eventId,
            success: false,
            retryAfterMs: backoffMs,
            routedToDlq: false,
            errorReason: "TRANSIENT_FAILURE: Scheduled retry",
        }
    }

    fn getTelemetry() -> OutboxTelemetry {
        return this.repo.getTelemetry()
    }
}
