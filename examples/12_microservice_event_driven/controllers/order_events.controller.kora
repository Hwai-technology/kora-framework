// ============================================================================
// Order Events — Presentation Controller Layer
// ============================================================================

import { EventPublisherService } from "../services/event_publisher.service"

class OrderEventsController {
    service: EventPublisherService

    init(service: EventPublisherService) {
        this.service = service
    }

    fn publish(request: Request) -> Response {
        let eventType = request.params["type"]
        let partitionKey = request.headers["X-Partition-Key"]
        let idempotencyKey = request.headers["Idempotency-Key"]
        let payload = request.body

        let result = this.service.publishOrderEvent(eventType, partitionKey, idempotencyKey, payload)
        let isSuccess = match result {
            Ok(env) => true,
            Err(e) => false,
        }

        if isSuccess {
            return match result {
                Ok(e) => Response.status(202).json(e),
                Err(err) => Response.status(500).json(err),
            }
        }

        let errMsg = match result {
            Ok(e) => "UNKNOWN",
            Err(err) => err,
        }
        return Response.status(409).json(errMsg)
    }

    fn consume(request: Request) -> Response {
        let eventId = request.params["id"]
        let isPoison = request.headers["X-Simulate-Poison"] == "true"
        let ack = this.service.processIncomingDelivery(eventId, isPoison)
        return Response.json(ack)
    }

    fn telemetry(request: Request) -> Response {
        let stats = this.service.getTelemetry()
        return Response.json(stats)
    }
}
