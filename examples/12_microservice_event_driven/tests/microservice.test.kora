// ============================================================================
// Integration Test: 12_microservice_event_driven
// Validates end-to-end Outbox Publication, Consumption, and Lifecycle
// ============================================================================

import { EventStoreRepository } from "../repositories/event_store.repository"
import { EventPublisherService } from "../services/event_publisher.service"

class MicroserviceIntegrationSuite {
    service: EventPublisherService

    init(service: EventPublisherService) {
        this.service = service
    }

    fn run() -> Unit {
        // 1. Publish order event
        let res = this.service.publishOrderEvent("OrderCreated", "orders_partition_east", "e2e_idemp_key_001", "{\"orderId\": \"ORD-7711\"}")
        let eid = match res {
            Ok(e) => e.eventId,
            Err(err) => "FAIL",
        }
        print("Outbox event stored with id: " + eid)

        // 2. Consume order event
        let ack = this.service.processIncomingDelivery(eid, false)
        if ack.success {
            print("Event delivered successfully to subscriber.")
        }

        // 3. Telemetry
        let stats = this.service.getTelemetry()
        print("Telemetry total published: " + stats.totalPublished.toString())
    }
}

let repo = EventStoreRepository()
let service = EventPublisherService(repo)
let testSuite = MicroserviceIntegrationSuite(service)
testSuite.run()
