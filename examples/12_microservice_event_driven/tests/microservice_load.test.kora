// ============================================================================
// Load & Fault Tolerance Test Suite: 12_microservice_event_driven
// Stresses 200 Distributed Outbox Events with Injected Poison Failures
// ============================================================================

import { EventStoreRepository } from "../repositories/event_store.repository"
import { EventPublisherService } from "../services/event_publisher.service"

class MicroserviceLoadTestSuite {
    repo: EventStoreRepository
    service: EventPublisherService

    init() {
        this.repo = EventStoreRepository()
        this.service = EventPublisherService(this.repo)
    }

    fn runLoadSuite() -> Bool {
        var total = 200
        var i = 0

        // 1. Publish 200 events into transactional outbox
        while i < total {
            let key = "load_idemp_key_" + i.toString()
            let res = this.service.publishOrderEvent("OrderStreamEvent", "partition_0", key, "{\"idx\": 1}")
            let isOk = match res {
                Ok(e) => true,
                Err(err) => false,
            }
            if !isOk {
                return false
            }
            i = i + 1
        }

        // 2. Consume events: every 10th event is a poison pill (20 poison pills total)
        var j = 0
        var poisonCount = 0
        while j < total {
            let eid = "evt_" + (5001 + j).toString()
            let isPoison = j % 10 == 0

            if isPoison {
                poisonCount = poisonCount + 1
                // Fail 3 times to force DLQ routing
                this.service.processIncomingDelivery(eid, true)
                this.service.processIncomingDelivery(eid, true)
                let finalAck = this.service.processIncomingDelivery(eid, true)
                if !finalAck.routedToDlq {
                    return false
                }
            } else {
                let ack = this.service.processIncomingDelivery(eid, false)
                if !ack.success {
                    return false
                }
            }
            j = j + 1
        }

        let telemetry = this.service.getTelemetry()
        let expectedDelivered = total - poisonCount
        return telemetry.totalPublished == total && telemetry.totalDelivered == expectedDelivered && telemetry.totalDeadLettered == poisonCount
    }

    fn run() -> Unit {
        let passed = this.runLoadSuite()
        if passed {
            print("  ✓ Microservice 200-Event Fault Tolerance & DLQ Load Test: PASSED")
        } else {
            print("  ✗ Microservice 200-Event Fault Tolerance & DLQ Load Test: FAILED")
        }
    }
}

let loadSuite = MicroserviceLoadTestSuite()
loadSuite.run()
