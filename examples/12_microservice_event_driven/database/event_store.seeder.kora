class EventStoreSeeder {
    db: Database

    init(db: Database) {
        this.db = db
    }

    fn seed() -> Result<Bool, String> {
        this.db.execute("INSERT INTO domain_events (id, eventType, payload, active) VALUES (1, 'SYSTEM_BOOT', '{\"version\": \"1.0.0\"}', true) ON CONFLICT (id) DO NOTHING")
        return Ok(true)
    }
}
