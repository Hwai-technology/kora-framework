# Kora Distributed Microservice & Event Bus Configuration
PORT=7582
HOST=0.0.0.0
ENVIRONMENT=production

# Apache Kafka / Message Broker
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=kora_orders_microservice
KAFKA_TOPIC_ORDERS=orders.events.v1
KAFKA_TOPIC_DLQ=orders.events.dlq

# Transactional Outbox Database
DATABASE_URL=postgres://kora_user:kora_event_pass@localhost:5432/events_db

# Idempotency & Retry Backoff Invariants
MAX_RETRY_ATTEMPTS=3
RETRY_BACKOFF_BASE_MS=100
IDEMPOTENCY_TTL_SECONDS=86400
