// Example 90: WebRTC SFU Media Router & SDP Signaling
// Presentation Controller

import { CreateWebrtcSignalingSfuTaskRequest } from "../models/webrtc_signaling_sfu_request.dto"
import { WebrtcSignalingSfuResponseDto } from "../models/webrtc_signaling_sfu_response.dto"
import { WebrtcSignalingSfuCoreService } from "../services/webrtc_signaling_sfu_core.service"

class WebrtcSignalingSfuController {
    service: WebrtcSignalingSfuCoreService

    init(service: WebrtcSignalingSfuCoreService) {
        this.service = service
    }

    fn handleTaskSubmission(req: CreateWebrtcSignalingSfuTaskRequest) -> WebrtcSignalingSfuResponseDto {
        let outcome = this.service.executeTask(req)
        return match outcome {
            Ok(rec) => WebrtcSignalingSfuResponseDto {
                operationId: "TX-" + req.taskKey,
                entityId: rec.id,
                status: "EXECUTION_SUCCESSFUL",
                isVerified: true,
                message: "Operation completed under Clean Architecture invariants",
            },
            Err(reason) => WebrtcSignalingSfuResponseDto {
                operationId: "TX-FAILED",
                entityId: req.targetEntityId,
                status: "EXECUTION_REJECTED",
                isVerified: false,
                message: reason,
            },
        }
    }

    fn inspectHealth(entityId: Int) -> String {
        return this.service.evaluateHealth(entityId)
    }
}
