// Example 90: WebRTC SFU Media Router & SDP Signaling
// Core Domain Service Implementation

import { WebrtcSignalingSfuPrimaryRecord } from "../entities/webrtc_signaling_sfu_primary.entity"
import { CreateWebrtcSignalingSfuTaskRequest } from "../models/webrtc_signaling_sfu_request.dto"
import { WebrtcSignalingSfuRepository } from "../interfaces/webrtc_signaling_sfu_repository.interface"
import { WebrtcSignalingSfuDomainContract } from "../interfaces/webrtc_signaling_sfu_service.interface"

class WebrtcSignalingSfuCoreService implements WebrtcSignalingSfuDomainContract {
    repo: WebrtcSignalingSfuRepository

    init(repo: WebrtcSignalingSfuRepository) {
        this.repo = repo
    }

    fn executeTask(req: CreateWebrtcSignalingSfuTaskRequest) -> Result<WebrtcSignalingSfuPrimaryRecord, String> {
        if req.targetEntityId <= 0 {
            return Err("Target entity ID must be strictly positive")
        }
        if req.workloadCapacity <= 0 {
            return Err("Workload capacity must be strictly positive")
        }

        let record = WebrtcSignalingSfuPrimaryRecord {
            id: req.targetEntityId,
            referenceCode: req.taskKey,
            capacityScore: req.workloadCapacity,
            operationalStatus: "COMMITTED_HEALTHY",
            active: true,
        }
        return this.repo.save(record)
    }

    fn evaluateHealth(entityId: Int) -> String {
        let opt = this.repo.findById(entityId)
        let isPresent = match opt {
            Some(r) => true,
            None => false,
        }
        if !isPresent {
            return "ENTITY_NOT_FOUND"
        }
        let record = match opt {
            Some(r) => r,
            None => WebrtcSignalingSfuPrimaryRecord { id: 0, referenceCode: "", capacityScore: 0, operationalStatus: "", active: false },
        }
        if record.capacityScore > 80 {
            return "OPTIMUM_PERFORMANCE"
        }
        if record.capacityScore > 40 {
            return "MODERATE_NORMAL"
        }
        return "LOW_CAPACITY"
    }
}
