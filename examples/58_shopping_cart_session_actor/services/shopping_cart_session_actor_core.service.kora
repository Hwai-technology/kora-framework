// Example 58: Distributed Shopping Cart Session Actor
// Core Domain Service Implementation

import { ShoppingCartSessionActorPrimaryRecord } from "../entities/shopping_cart_session_actor_primary.entity"
import { CreateShoppingCartSessionActorTaskRequest } from "../models/shopping_cart_session_actor_request.dto"
import { ShoppingCartSessionActorRepository } from "../interfaces/shopping_cart_session_actor_repository.interface"
import { ShoppingCartSessionActorDomainContract } from "../interfaces/shopping_cart_session_actor_service.interface"

class ShoppingCartSessionActorCoreService implements ShoppingCartSessionActorDomainContract {
    repo: ShoppingCartSessionActorRepository

    init(repo: ShoppingCartSessionActorRepository) {
        this.repo = repo
    }

    fn executeTask(req: CreateShoppingCartSessionActorTaskRequest) -> Result<ShoppingCartSessionActorPrimaryRecord, String> {
        if req.targetEntityId <= 0 {
            return Err("Target entity ID must be strictly positive")
        }
        if req.workloadCapacity <= 0 {
            return Err("Workload capacity must be strictly positive")
        }

        let record = ShoppingCartSessionActorPrimaryRecord {
            id: req.targetEntityId,
            referenceCode: req.taskKey,
            capacityScore: req.workloadCapacity,
            operationalStatus: "COMMITTED_HEALTHY",
            active: true,
        }
        return this.repo.save(record)
    }

    fn evaluateHealth(entityId: Int) -> String {
        let opt = this.repo.findById(entityId)
        let isPresent = match opt {
            Some(r) => true,
            None => false,
        }
        if !isPresent {
            return "ENTITY_NOT_FOUND"
        }
        let record = match opt {
            Some(r) => r,
            None => ShoppingCartSessionActorPrimaryRecord { id: 0, referenceCode: "", capacityScore: 0, operationalStatus: "", active: false },
        }
        if record.capacityScore > 80 {
            return "OPTIMUM_PERFORMANCE"
        }
        if record.capacityScore > 40 {
            return "MODERATE_NORMAL"
        }
        return "LOW_CAPACITY"
    }
}
