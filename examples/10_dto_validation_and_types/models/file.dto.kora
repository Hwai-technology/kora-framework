// ============================================================================
// File & Image Upload DTOs (Pure Data Envelopes - E5002 Enforced)
// ============================================================================

model ImageMetadataDto {
    width: Int
    height: Int
    aspectRatio: String
    hasAlphaChannel: Bool
}

model FileUploadDto {
    @required
    @min(1)
    fileName: String

    @required
    mimeType: String

    @min(1)
    @max(10485760) // 10 MB maximum
    sizeBytes: Int

    @required
    sha256Checksum: String

    isPublic: Bool
    imageMeta: Option<ImageMetadataDto>
}

