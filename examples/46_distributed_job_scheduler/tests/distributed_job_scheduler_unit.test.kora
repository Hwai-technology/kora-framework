// ============================================================================
// Unit Test Suite: Distributed Task Scheduler & Leader Lease
// Verifies Consensus Invariants, Quorum Validation, and Heartbeats
// ============================================================================

import { CreateDistributedJobSchedulerTaskRequest } from "../models/distributed_job_scheduler_request.dto"
import { DistributedJobSchedulerClusterRepository } from "../repositories/distributed_job_scheduler_cluster.repository"
import { DistributedJobSchedulerCoreService } from "../services/distributed_job_scheduler_core.service"
import { DistributedJobSchedulerHeartbeatService } from "../services/distributed_job_scheduler_heartbeat.service"

class DistributedJobSchedulerUnitTestSuite {
    service: DistributedJobSchedulerCoreService
    heartbeat: DistributedJobSchedulerHeartbeatService

    init(service: DistributedJobSchedulerCoreService, heartbeat: DistributedJobSchedulerHeartbeatService) {
        this.service = service
        this.heartbeat = heartbeat
    }

    fn test_consensus_command_processing() -> Bool {
        let req = CreateDistributedJobSchedulerTaskRequest {
            taskKey: "TASK-REPLICATE-101",
            originatingNodeId: 1,
            payloadVolume: 500,
            targetCluster: "ProductionClusterEast",
        }
        let res = this.service.processConsensusCommand(req)
        return match res {
            Ok(state) => state.id == 1 && state.isLeader,
            Err(e) => false,
        }
    }

    fn test_invalid_originating_node_rejected() -> Bool {
        let req = CreateDistributedJobSchedulerTaskRequest {
            taskKey: "TASK-INVALID",
            originatingNodeId: -1,
            payloadVolume: 100,
            targetCluster: "ProductionClusterEast",
        }
        let res = this.service.processConsensusCommand(req)
        return match res {
            Ok(s) => false,
            Err(e) => e == "Originating node ID must be strictly positive",
        }
    }

    fn test_quorum_evaluation() -> Bool {
        return this.service.evaluateClusterQuorum()
    }

    fn test_heartbeat_ping() -> Bool {
        return this.heartbeat.pingPeer(2)
    }

    fn run() -> Unit {
        let t1 = this.test_consensus_command_processing()
        let t2 = this.test_invalid_originating_node_rejected()
        let t3 = this.test_quorum_evaluation()
        let t4 = this.test_heartbeat_ping()

        if t1 && t2 && t3 && t4 {
            print("  ✓ Distributed Task Scheduler & Leader Lease Unit Tests: 4/4 passed (Quorum, Invariants & Heartbeats Verified)")
        } else {
            print("  ✗ Distributed Task Scheduler & Leader Lease Unit Tests: failed")
        }
    }
}

let repo = DistributedJobSchedulerClusterRepository()
let service = DistributedJobSchedulerCoreService(repo)
let heartbeat = DistributedJobSchedulerHeartbeatService()
let suite = DistributedJobSchedulerUnitTestSuite(service, heartbeat)
suite.run()
