// Example 46: Distributed Task Scheduler & Leader Lease
// Core Domain Service Implementation

import { DistributedJobSchedulerNodeState } from "../entities/distributed_job_scheduler_primary.entity"
import { CreateDistributedJobSchedulerTaskRequest } from "../models/distributed_job_scheduler_request.dto"
import { DistributedJobSchedulerRepository } from "../interfaces/distributed_job_scheduler_repository.interface"
import { DistributedJobSchedulerConsensusContract } from "../interfaces/distributed_job_scheduler_service.interface"

class DistributedJobSchedulerCoreService implements DistributedJobSchedulerConsensusContract {
    repo: DistributedJobSchedulerRepository

    init(repo: DistributedJobSchedulerRepository) {
        this.repo = repo
    }

    fn processConsensusCommand(req: CreateDistributedJobSchedulerTaskRequest) -> Result<DistributedJobSchedulerNodeState, String> {
        if req.originatingNodeId <= 0 {
            return Err("Originating node ID must be strictly positive")
        }
        if req.payloadVolume <= 0 {
            return Err("Payload volume must be positive")
        }

        let state = DistributedJobSchedulerNodeState {
            id: req.originatingNodeId,
            nodeIdentifier: "CLUSTER-NODE-" + req.originatingNodeId.toString(),
            currentEpochTerm: 5,
            votedForCandidate: req.originatingNodeId,
            isLeader: true,
            active: true,
        }
        return this.repo.saveNodeState(state)
    }

    fn evaluateClusterQuorum() -> Bool {
        let quorum = this.repo.getActiveQuorumCount()
        return quorum >= 3
    }
}
