// Example 30: Credit Underwriting & Risk Assessment
// Command Controller (Mutations & Writes)

import { CreateCreditScoringUnderwritingRequest } from "../models/credit_scoring_underwriting_request.dto"
import { CreditScoringUnderwritingResponse } from "../models/credit_scoring_underwriting_response.dto"
import { CreditScoringUnderwritingCoreService } from "../services/credit_scoring_underwriting_core.service"

class CreditScoringUnderwritingCommandController {
    service: CreditScoringUnderwritingCoreService

    init(service: CreditScoringUnderwritingCoreService) {
        this.service = service
    }

    fn handleCreate(req: CreateCreditScoringUnderwritingRequest) -> CreditScoringUnderwritingResponse {
        let outcome = this.service.processRequest(req)
        return match outcome {
            Ok(rec) => CreditScoringUnderwritingResponse {
                id: rec.id,
                reference: rec.reference,
                success: true,
                statusCode: 201,
                message: "Created successfully",
            },
            Err(reason) => CreditScoringUnderwritingResponse {
                id: -1,
                reference: req.reference,
                success: false,
                statusCode: 400,
                message: reason,
            },
        }
    }
}
