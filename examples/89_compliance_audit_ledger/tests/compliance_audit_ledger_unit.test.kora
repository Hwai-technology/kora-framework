// ============================================================================
// Unit Test Suite: Immutable Cryptographic Audit Trail (SOC 2 / ISO 27001)
// Verifies Domain Invariants, Boundary Calculations & Liveness
// ============================================================================

import { CreateComplianceAuditLedgerTaskRequest } from "../models/compliance_audit_ledger_request.dto"
import { ComplianceAuditLedgerInMemoryRepository } from "../repositories/compliance_audit_ledger_inmemory.repository"
import { ComplianceAuditLedgerCoreService } from "../services/compliance_audit_ledger_core.service"
import { ComplianceAuditLedgerTelemetryService } from "../services/compliance_audit_ledger_telemetry.service"

class ComplianceAuditLedgerUnitTestSuite {
    service: ComplianceAuditLedgerCoreService
    telemetry: ComplianceAuditLedgerTelemetryService

    init(service: ComplianceAuditLedgerCoreService, telemetry: ComplianceAuditLedgerTelemetryService) {
        this.service = service
        this.telemetry = telemetry
    }

    fn test_valid_task_execution() -> Bool {
        let req = CreateComplianceAuditLedgerTaskRequest {
            taskKey: "UNIT-TASK-101",
            targetEntityId: 10,
            workloadCapacity: 95,
            domainContext: "Cybersecurity",
        }
        let res = this.service.executeTask(req)
        return match res {
            Ok(rec) => rec.id == 10 && rec.capacityScore == 95,
            Err(e) => false,
        }
    }

    fn test_invalid_negative_target_rejected() -> Bool {
        let req = CreateComplianceAuditLedgerTaskRequest {
            taskKey: "INVALID-TASK",
            targetEntityId: -1,
            workloadCapacity: 50,
            domainContext: "Cybersecurity",
        }
        let res = this.service.executeTask(req)
        return match res {
            Ok(r) => false,
            Err(e) => e == "Target entity ID must be strictly positive",
        }
    }

    fn test_health_evaluation() -> Bool {
        let health = this.service.evaluateHealth(10)
        return health == "OPTIMUM_PERFORMANCE" || health == "MODERATE_NORMAL"
    }

    fn test_telemetry_ping() -> Bool {
        return this.telemetry.ping()
    }

    fn run() -> Unit {
        let t1 = this.test_valid_task_execution()
        let t2 = this.test_invalid_negative_target_rejected()
        let t3 = this.test_health_evaluation()
        let t4 = this.test_telemetry_ping()

        if t1 && t2 && t3 && t4 {
            print("  ✓ Immutable Cryptographic Audit Trail (SOC 2 / ISO 27001) Unit Tests: 4/4 passed (Domain Invariants Verified)")
        } else {
            print("  ✗ Immutable Cryptographic Audit Trail (SOC 2 / ISO 27001) Unit Tests: failed")
        }
    }
}

let repo = ComplianceAuditLedgerInMemoryRepository()
let service = ComplianceAuditLedgerCoreService(repo)
let telemetry = ComplianceAuditLedgerTelemetryService()
let suite = ComplianceAuditLedgerUnitTestSuite(service, telemetry)
suite.run()
