// Example 38: Radiology PACS DICOM Metadata Indexer
// Transport Model: Standard Responses

model RadiologyPacsMetadataResponseDto {
    recordId: Int
    patientId: Int
    status: String
    isComplianceVerified: Bool
    message: String
}

model RadiologyPacsMetadataSummaryDto {
    patientId: Int
    totalEntries: Int
    severityCategory: String
    lastReviewedTimestamp: Int
}
