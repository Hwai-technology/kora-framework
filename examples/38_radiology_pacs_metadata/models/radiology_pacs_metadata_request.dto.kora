// Example 38: Radiology PACS DICOM Metadata Indexer
// Transport Model: Command Requests

model CreateRadiologyPacsMetadataRecordRequest {
    patientId: Int
    clinicianId: Int
    domainContext: String
    clinicalMetricScore: Int
    confidentialNotes: String
}

model QueryRadiologyPacsMetadataFilterRequest {
    patientId: Int
    limit: Int
    includeHistorical: Bool
}
