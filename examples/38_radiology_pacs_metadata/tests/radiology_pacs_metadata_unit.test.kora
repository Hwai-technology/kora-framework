// ============================================================================
// Unit Test Suite: Radiology PACS DICOM Metadata Indexer
// Invariants, Clinical Risk Scoring, and HIPAA Boundary Verification
// ============================================================================

import { CreateRadiologyPacsMetadataRecordRequest } from "../models/radiology_pacs_metadata_request.dto"
import { RadiologyPacsMetadataInMemoryRepository } from "../repositories/radiology_pacs_metadata_inmemory.repository"
import { RadiologyPacsMetadataCoreService } from "../services/radiology_pacs_metadata_core.service"
import { RadiologyPacsMetadataComplianceService } from "../services/radiology_pacs_metadata_compliance.service"

class RadiologyPacsMetadataUnitTestSuite {
    service: RadiologyPacsMetadataCoreService
    compliance: RadiologyPacsMetadataComplianceService

    init(service: RadiologyPacsMetadataCoreService, compliance: RadiologyPacsMetadataComplianceService) {
        this.service = service
        this.compliance = compliance
    }

    fn test_valid_clinical_record_processing() -> Bool {
        let req = CreateRadiologyPacsMetadataRecordRequest {
            patientId: 101,
            clinicianId: 202,
            domainContext: "Clinical Inpatient Encounter",
            clinicalMetricScore: 75,
            confidentialNotes: "Vitals stable, continuing observation",
        }
        let res = this.service.processClinicalRecord(req)
        return match res {
            Ok(rec) => rec.patientId == 101 && rec.clinicalMetricScore == 75,
            Err(e) => false,
        }
    }

    fn test_invalid_negative_score_rejected() -> Bool {
        let req = CreateRadiologyPacsMetadataRecordRequest {
            patientId: 102,
            clinicianId: 202,
            domainContext: "Error Check",
            clinicalMetricScore: -5,
            confidentialNotes: "Invalid payload test",
        }
        let res = this.service.processClinicalRecord(req)
        return match res {
            Ok(r) => false,
            Err(e) => e == "Clinical metric score cannot be negative",
        }
    }

    fn test_risk_evaluation() -> Bool {
        let risk = this.service.evaluateClinicalRisk(101)
        return risk == "CRITICAL_OBSERVATION" || risk == "MODERATE_ATTENTION"
    }

    fn test_compliance_authorization() -> Bool {
        let auth = this.compliance.verifyPhiAccessAuthorization(42, false)
        let emergencyAuth = this.compliance.verifyPhiAccessAuthorization(-1, true)
        return auth && emergencyAuth
    }

    fn run() -> Unit {
        let t1 = this.test_valid_clinical_record_processing()
        let t2 = this.test_invalid_negative_score_rejected()
        let t3 = this.test_risk_evaluation()
        let t4 = this.test_compliance_authorization()

        if t1 && t2 && t3 && t4 {
            print("  ✓ Radiology PACS DICOM Metadata Indexer Unit Tests: 4/4 passed (HIPAA, Risk & Invariants Verified)")
        } else {
            print("  ✗ Radiology PACS DICOM Metadata Indexer Unit Tests: failed")
        }
    }
}

let repo = RadiologyPacsMetadataInMemoryRepository()
let service = RadiologyPacsMetadataCoreService(repo)
let compliance = RadiologyPacsMetadataComplianceService()
let suite = RadiologyPacsMetadataUnitTestSuite(service, compliance)
suite.run()
