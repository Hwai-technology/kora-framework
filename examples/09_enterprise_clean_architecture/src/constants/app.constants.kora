// ============================================================================
// System Constants & Configuration Provider
// ============================================================================

import { AppLimits, SecurityConstants } from "../models/config.models"

class SystemConfig {
    fn getLimits() -> AppLimits {
        return AppLimits {
            maxRateLimitRpm: 120,
            maxBurstCapacity: 30,
            compressionThresholdBytes: 1024,
            defaultPageSize: 10,
            maxPageSize: 100,
        }
    }

    fn getSecurity() -> SecurityConstants {
        return SecurityConstants {
            headerAuthorization: "Authorization",
            headerNonce: "X-Nonce",
            headerTraceId: "X-Trace-Id",
            tokenExpirySeconds: 86400,
        }
    }
}
