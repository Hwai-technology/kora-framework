// ============================================================================
// Automatic Schema Reflection Migrator & Database Seeder
// Executes real DDL migrations, schema synchronization, truncation, and seeding
// ============================================================================

import { AmbientDatabasePool } from "database/database_pool";

class AutoMigrator {
    pool: AmbientDatabasePool

    init(pool: AmbientDatabasePool) {
        this.pool = pool
    }

    fn runAllMigrations() -> Result<Int, String> {
        let connAcquired = this.pool.acquireConnection()
        if !connAcquired {
            return Err("Unable to acquire connection for schema migrations")
        }

        let qUsers = this.pool.executeQuery("CREATE TABLE IF NOT EXISTS users (id INT PRIMARY KEY AUTO_INCREMENT, email VARCHAR(255) UNIQUE NOT NULL, full_name VARCHAR(255) NOT NULL, role VARCHAR(50) DEFAULT 'customer', balance INT DEFAULT 0, is_active BOOLEAN DEFAULT TRUE, created_at BIGINT DEFAULT 0)")
        let qProducts = this.pool.executeQuery("CREATE TABLE IF NOT EXISTS products (id INT PRIMARY KEY AUTO_INCREMENT, sku VARCHAR(100) UNIQUE NOT NULL, title VARCHAR(255) NOT NULL, price_cents INT NOT NULL, stock_quantity INT NOT NULL, is_published BOOLEAN DEFAULT TRUE)")
        let qOrders = this.pool.executeQuery("CREATE TABLE IF NOT EXISTS orders (id INT PRIMARY KEY AUTO_INCREMENT, order_number VARCHAR(100) UNIQUE NOT NULL, user_id INT NOT NULL, total_amount INT NOT NULL, status VARCHAR(50) NOT NULL, payment_status VARCHAR(50) NOT NULL, created_at BIGINT DEFAULT 0)")
        let qOrderItems = this.pool.executeQuery("CREATE TABLE IF NOT EXISTS order_items (id INT PRIMARY KEY AUTO_INCREMENT, order_id INT NOT NULL, product_id INT NOT NULL, quantity INT NOT NULL, unit_price INT NOT NULL, subtotal INT NOT NULL)")

        let connReleased = this.pool.releaseConnection()

        return match qUsers {
            Ok(c1) => match qProducts {
                Ok(c2) => match qOrders {
                    Ok(c3) => match qOrderItems {
                        Ok(c4) => Ok(c1 + c2 + c3 + c4 + 4),
                        Err(e4) => Err("Order items migration failed: " + e4),
                    },
                    Err(e3) => Err("Orders table migration failed: " + e3),
                },
                Err(e2) => Err("Products table migration failed: " + e2),
            },
            Err(e1) => Err("Users table migration failed: " + e1),
        }
    }

    fn syncSchemaWithEntities() -> Result<Int, String> {
        let connAcquired = this.pool.acquireConnection()
        if !connAcquired {
            return Err("Unable to acquire connection for schema synchronization")
        }

        // Auto-reconcile schema differences between Entity Models and database tables
        let alter1 = this.pool.executeQuery("ALTER TABLE users ADD COLUMN IF NOT EXISTS phone VARCHAR(50) DEFAULT NULL")
        let alter2 = this.pool.executeQuery("ALTER TABLE orders ADD COLUMN IF NOT EXISTS currency VARCHAR(10) DEFAULT 'USD'")
        let alter3 = this.pool.executeQuery("ALTER TABLE products ADD COLUMN IF NOT EXISTS description TEXT DEFAULT NULL")
        let idx1 = this.pool.executeQuery("CREATE INDEX IF NOT EXISTS idx_orders_user_id ON orders(user_id)")
        let idx2 = this.pool.executeQuery("CREATE INDEX IF NOT EXISTS idx_order_items_order ON order_items(order_id)")

        let connReleased = this.pool.releaseConnection()

        return match alter1 {
            Ok(c1) => match alter2 {
                Ok(c2) => match alter3 {
                    Ok(c3) => Ok(c1 + c2 + c3 + 5),
                    Err(e3) => Err("Schema sync failed on products: " + e3),
                },
                Err(e2) => Err("Schema sync failed on orders: " + e2),
            },
            Err(e1) => Err("Schema sync failed on users: " + e1),
        }
    }

    fn dropAllTables() -> Result<Int, String> {
        let connAcquired = this.pool.acquireConnection()
        if !connAcquired {
            return Err("Unable to acquire connection for dropping tables")
        }

        let qFkOff = this.pool.executeQuery("SET FOREIGN_KEY_CHECKS = 0")
        let qDropItems = this.pool.executeQuery("DROP TABLE IF EXISTS order_items")
        let qDropOrders = this.pool.executeQuery("DROP TABLE IF EXISTS orders")
        let qDropProducts = this.pool.executeQuery("DROP TABLE IF EXISTS products")
        let qDropUsers = this.pool.executeQuery("DROP TABLE IF EXISTS users")
        let qFkOn = this.pool.executeQuery("SET FOREIGN_KEY_CHECKS = 1")

        let connReleased = this.pool.releaseConnection()

        return match qDropUsers {
            Ok(c) => Ok(4),
            Err(e) => Err("Drop tables failed: " + e),
        }
    }

    fn truncateAllData() -> Result<Int, String> {
        let connAcquired = this.pool.acquireConnection()
        if !connAcquired {
            return Err("Unable to acquire connection for truncating tables")
        }

        let qFkOff = this.pool.executeQuery("SET FOREIGN_KEY_CHECKS = 0")
        let qTruncItems = this.pool.executeQuery("TRUNCATE TABLE order_items")
        let qTruncOrders = this.pool.executeQuery("TRUNCATE TABLE orders")
        let qTruncProducts = this.pool.executeQuery("TRUNCATE TABLE products")
        let qTruncUsers = this.pool.executeQuery("TRUNCATE TABLE users")
        let qFkOn = this.pool.executeQuery("SET FOREIGN_KEY_CHECKS = 1")

        let connReleased = this.pool.releaseConnection()

        return match qTruncUsers {
            Ok(c) => Ok(4),
            Err(e) => Err("Truncate tables failed: " + e),
        }
    }

    fn destroy() -> Bool {
        return this.pool.destroy()
    }
}

class DatabaseSeeder {
    pool: AmbientDatabasePool

    init(pool: AmbientDatabasePool) {
        this.pool = pool
    }

    fn seedInitialData() -> Result<Int, String> {
        let connAcquired = this.pool.acquireConnection()
        if !connAcquired {
            return Err("Unable to acquire connection for initial seeding")
        }

        let seedAdmin = this.pool.executeQuery("INSERT IGNORE INTO users (email, full_name, role, balance, is_active) VALUES ('admin@kora-lang.org', 'Admin Architect', 'admin', 1000000, 1)")
        let seedCustomer = this.pool.executeQuery("INSERT IGNORE INTO users (email, full_name, role, balance, is_active) VALUES ('ahmet@kora-lang.org', 'Ahmet Customer', 'customer', 50000, 1)")
        let seedCatalog = this.pool.executeQuery("INSERT IGNORE INTO products (sku, title, price_cents, stock_quantity, is_published) VALUES ('SKU-NODE-01', 'Enterprise Cluster Node', 499900, 50, 1)")
        let seedCatalog2 = this.pool.executeQuery("INSERT IGNORE INTO products (sku, title, price_cents, stock_quantity, is_published) VALUES ('SKU-SSD-02', 'NVMe Storage Blade 4TB', 129900, 100, 1)")

        let connReleased = this.pool.releaseConnection()

        return match seedAdmin {
            Ok(c1) => match seedCustomer {
                Ok(c2) => match seedCatalog {
                    Ok(c3) => Ok(c1 + c2 + c3 + 4),
                    Err(e3) => Err("Product seeding failed: " + e3),
                },
                Err(e2) => Err("Customer seeding failed: " + e2),
            },
            Err(e1) => Err("Admin user seeding failed: " + e1),
        }
    }

    fn wipeData() -> Result<Int, String> {
        let connAcquired = this.pool.acquireConnection()
        if !connAcquired {
            return Err("Unable to acquire connection for wiping data")
        }

        let qFkOff = this.pool.executeQuery("SET FOREIGN_KEY_CHECKS = 0")
        let qTruncItems = this.pool.executeQuery("TRUNCATE TABLE order_items")
        let qTruncOrders = this.pool.executeQuery("TRUNCATE TABLE orders")
        let qTruncProducts = this.pool.executeQuery("TRUNCATE TABLE products")
        let qTruncUsers = this.pool.executeQuery("TRUNCATE TABLE users")
        let qFkOn = this.pool.executeQuery("SET FOREIGN_KEY_CHECKS = 1")

        let connReleased = this.pool.releaseConnection()

        return match qTruncUsers {
            Ok(c) => Ok(4),
            Err(e) => Err("Wipe data failed: " + e),
        }
    }

    fn destroy() -> Bool {
        return this.pool.destroy()
    }
}
