// ============================================================================
// Orders Module: Realtime Events & Lifecycle Emitter
// ============================================================================

import { DomainEvent } from "models/response_envelope.model";

class OrderEventEmitter {
    fn emitOrderPlaced(orderId: Int) -> DomainEvent {
        let eid = "evt_ord_" + orderId.toString()
        let summary = "Order #" + orderId.toString() + " successfully placed and persisted"
        let ts = 1773000000 + orderId
        return DomainEvent {
            eventId: eid,
            eventType: "OrderPlacedEvent",
            aggregateId: orderId,
            payloadSummary: summary,
            emittedAt: ts,
        }
    }

    fn emitOrderCancelled(orderId: Int) -> DomainEvent {
        let eid = "evt_cancel_" + orderId.toString()
        let summary = "Order #" + orderId.toString() + " successfully cancelled and refunded"
        let ts = 1773000000 + orderId
        return DomainEvent {
            eventId: eid,
            eventType: "OrderCancelledEvent",
            aggregateId: orderId,
            payloadSummary: summary,
            emittedAt: ts,
        }
    }

    fn destroy() -> Bool {
        return true
    }
}
