// ============================================================================
// Enterprise SMS & One-Time Password (OTP) Gateway Service
// Dispatches critical security verification codes & transaction alerts
// ============================================================================

import { SmsMessage } from "models/service_models";
import { Logger } from "shared/services/logger_service";

class SmsService {
    logger: Logger

    init(logger: Logger) {
        this.logger = logger
    }

    fn sendOtp(phoneNumber: String, code: String) -> Result<Bool, String> {
        if phoneNumber == "" {
            return Err("Phone number is required")
        }
        if !phoneNumber.startsWith("+") {
            return Err("Phone number must include international country calling code prefix '+'")
        }
        if code == "" {
            return Err("OTP code cannot be empty")
        }
        if code.len() < 4 {
            return Err("OTP verification code must be at least 4 digits")
        }

        let l = this.logger.info("SmsService", "Dispatched security OTP challenge to: " + phoneNumber, "trace_sms_otp")
        return Ok(true)
    }

    fn sendTransactionAlert(phoneNumber: String, amount: Int, reference: String) -> Result<Bool, String> {
        if phoneNumber == "" {
            return Err("Phone number is required")
        }
        if reference == "" {
            return Err("Transaction reference is required")
        }
        if amount <= 0 {
            return Err("Transaction alert amount must be greater than zero")
        }

        let l = this.logger.info(
            "SmsService",
            "Sent payment alert of " + amount.toString() + " for ref " + reference + " to: " + phoneNumber,
            "trace_sms_alert",
        )
        return Ok(true)
    }

    fn destroy() -> Bool {
        return this.logger.destroy()
    }
}
