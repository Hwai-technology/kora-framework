// ============================================================================
// Kora Modular Clean Architecture Enterprise Showcase — Main Entrypoint
// Pure Architectural Discipline: Imports models & enums from dedicated modules
// Everything is Class-Based Architecture with Compile-Time Dependency Injection
// ============================================================================

import { SecureApiResponse } from "models/response_envelope.model";
import { ApiRouter } from "routes/api.routes";
import { DatabaseRouter } from "routes/database.routes";
import { AuthRouter } from "routes/auth.routes";
import { OrderRouter } from "routes/order.routes";

// ============================================================================
// Enterprise Application Container (Class-based Lifecycle & Orchestration)
// ============================================================================

class Application {
    router: ApiRouter
    database: DatabaseRouter
    auth: AuthRouter
    orders: OrderRouter

    init(
        router: ApiRouter,
        database: DatabaseRouter,
        auth: AuthRouter,
        orders: OrderRouter,
    ) {
        this.router = router
        this.database = database
        this.auth = auth
        this.orders = orders
    }

    fn health() -> SecureApiResponse {
        return this.router.health()
    }
}

// ============================================================================
// Server Bootstrap & REST Routing via Modular Clean Routers
// ============================================================================

let app = run()

// 1. Healthcheck & Banner Endpoints
get("/health", (router: ApiRouter) => {
    return router.health()
})

// 2. Database Management & Schema Auto-Sync Endpoints
get("/api/v1/database/migrate", (dbRoutes: DatabaseRouter) => {
    return dbRoutes.migrateDatabase()
})

post("/api/v1/database/sync", (dbRoutes: DatabaseRouter) => {
    return dbRoutes.syncDatabaseSchema()
})

post("/api/v1/database/seed", (dbRoutes: DatabaseRouter) => {
    return dbRoutes.seedDatabase()
})

post("/api/v1/database/truncate", (dbRoutes: DatabaseRouter) => {
    return dbRoutes.truncateDatabase()
})

post("/api/v1/database/drop", (dbRoutes: DatabaseRouter) => {
    return dbRoutes.dropDatabaseTables()
})

post("/api/v1/database/refresh", (dbRoutes: DatabaseRouter) => {
    return dbRoutes.refreshDatabase()
})

// 3. Auth Routes
post("/api/v1/auth/login", (authRoutes: AuthRouter) => {
    return authRoutes.login("ahmet@kora-lang.org", "secretPassword")
})

post("/api/v1/auth/register", (authRoutes: AuthRouter) => {
    return authRoutes.register("newuser@kora-lang.org", "New User")
})

// 4. Orders Routes
get("/api/v1/orders/{id}", (id: Int, orderRoutes: OrderRouter) => {
    return orderRoutes.getOrder(id)
})

post("/api/v1/orders", (orderRoutes: OrderRouter) => {
    return orderRoutes.createOrder(1, 5, 500000)
})

post("/api/v1/orders/{id}/cancel", (id: Int, orderRoutes: OrderRouter) => {
    return orderRoutes.cancelOrder(id)
})
