// ============================================================================
// User Repository Interface Contract
// ============================================================================

model User {
    id: Int
    email: String
    fullName: String
    role: String
    balance: Int
    isActive: Bool
}

model UserRegisterInput {
    email: String
    fullName: String
    initialBalance: Int
}

interface IUserRepository {
    fn findById(id: Int) -> Option<User>
    fn findByEmail(email: String) -> Option<User>
    fn createUser(input: UserRegisterInput) -> Result<User, String>
    fn destroy() -> Bool
}

