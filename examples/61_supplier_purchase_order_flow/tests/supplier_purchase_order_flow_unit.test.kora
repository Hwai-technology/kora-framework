// ============================================================================
// Unit Test Suite: Supplier Purchase Order & 3-Way Invoice Matcher
// Verifies Domain Invariants, Boundary Calculations & Liveness
// ============================================================================

import { CreateSupplierPurchaseOrderFlowTaskRequest } from "../models/supplier_purchase_order_flow_request.dto"
import { SupplierPurchaseOrderFlowInMemoryRepository } from "../repositories/supplier_purchase_order_flow_inmemory.repository"
import { SupplierPurchaseOrderFlowCoreService } from "../services/supplier_purchase_order_flow_core.service"
import { SupplierPurchaseOrderFlowTelemetryService } from "../services/supplier_purchase_order_flow_telemetry.service"

class SupplierPurchaseOrderFlowUnitTestSuite {
    service: SupplierPurchaseOrderFlowCoreService
    telemetry: SupplierPurchaseOrderFlowTelemetryService

    init(service: SupplierPurchaseOrderFlowCoreService, telemetry: SupplierPurchaseOrderFlowTelemetryService) {
        this.service = service
        this.telemetry = telemetry
    }

    fn test_valid_task_execution() -> Bool {
        let req = CreateSupplierPurchaseOrderFlowTaskRequest {
            taskKey: "UNIT-TASK-101",
            targetEntityId: 10,
            workloadCapacity: 95,
            domainContext: "E-Commerce",
        }
        let res = this.service.executeTask(req)
        return match res {
            Ok(rec) => rec.id == 10 && rec.capacityScore == 95,
            Err(e) => false,
        }
    }

    fn test_invalid_negative_target_rejected() -> Bool {
        let req = CreateSupplierPurchaseOrderFlowTaskRequest {
            taskKey: "INVALID-TASK",
            targetEntityId: -1,
            workloadCapacity: 50,
            domainContext: "E-Commerce",
        }
        let res = this.service.executeTask(req)
        return match res {
            Ok(r) => false,
            Err(e) => e == "Target entity ID must be strictly positive",
        }
    }

    fn test_health_evaluation() -> Bool {
        let health = this.service.evaluateHealth(10)
        return health == "OPTIMUM_PERFORMANCE" || health == "MODERATE_NORMAL"
    }

    fn test_telemetry_ping() -> Bool {
        return this.telemetry.ping()
    }

    fn run() -> Unit {
        let t1 = this.test_valid_task_execution()
        let t2 = this.test_invalid_negative_target_rejected()
        let t3 = this.test_health_evaluation()
        let t4 = this.test_telemetry_ping()

        if t1 && t2 && t3 && t4 {
            print("  ✓ Supplier Purchase Order & 3-Way Invoice Matcher Unit Tests: 4/4 passed (Domain Invariants Verified)")
        } else {
            print("  ✗ Supplier Purchase Order & 3-Way Invoice Matcher Unit Tests: failed")
        }
    }
}

let repo = SupplierPurchaseOrderFlowInMemoryRepository()
let service = SupplierPurchaseOrderFlowCoreService(repo)
let telemetry = SupplierPurchaseOrderFlowTelemetryService()
let suite = SupplierPurchaseOrderFlowUnitTestSuite(service, telemetry)
suite.run()
