// Example 61: Supplier Purchase Order & 3-Way Invoice Matcher
// Core Domain Service Implementation

import { SupplierPurchaseOrderFlowPrimaryRecord } from "../entities/supplier_purchase_order_flow_primary.entity"
import { CreateSupplierPurchaseOrderFlowTaskRequest } from "../models/supplier_purchase_order_flow_request.dto"
import { SupplierPurchaseOrderFlowRepository } from "../interfaces/supplier_purchase_order_flow_repository.interface"
import { SupplierPurchaseOrderFlowDomainContract } from "../interfaces/supplier_purchase_order_flow_service.interface"

class SupplierPurchaseOrderFlowCoreService implements SupplierPurchaseOrderFlowDomainContract {
    repo: SupplierPurchaseOrderFlowRepository

    init(repo: SupplierPurchaseOrderFlowRepository) {
        this.repo = repo
    }

    fn executeTask(req: CreateSupplierPurchaseOrderFlowTaskRequest) -> Result<SupplierPurchaseOrderFlowPrimaryRecord, String> {
        if req.targetEntityId <= 0 {
            return Err("Target entity ID must be strictly positive")
        }
        if req.workloadCapacity <= 0 {
            return Err("Workload capacity must be strictly positive")
        }

        let record = SupplierPurchaseOrderFlowPrimaryRecord {
            id: req.targetEntityId,
            referenceCode: req.taskKey,
            capacityScore: req.workloadCapacity,
            operationalStatus: "COMMITTED_HEALTHY",
            active: true,
        }
        return this.repo.save(record)
    }

    fn evaluateHealth(entityId: Int) -> String {
        let opt = this.repo.findById(entityId)
        let isPresent = match opt {
            Some(r) => true,
            None => false,
        }
        if !isPresent {
            return "ENTITY_NOT_FOUND"
        }
        let record = match opt {
            Some(r) => r,
            None => SupplierPurchaseOrderFlowPrimaryRecord { id: 0, referenceCode: "", capacityScore: 0, operationalStatus: "", active: false },
        }
        if record.capacityScore > 80 {
            return "OPTIMUM_PERFORMANCE"
        }
        if record.capacityScore > 40 {
            return "MODERATE_NORMAL"
        }
        return "LOW_CAPACITY"
    }
}
