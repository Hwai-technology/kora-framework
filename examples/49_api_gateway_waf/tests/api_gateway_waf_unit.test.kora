// ============================================================================
// Unit Test Suite: API Gateway & Web Application Firewall
// Verifies Consensus Invariants, Quorum Validation, and Heartbeats
// ============================================================================

import { CreateApiGatewayWafTaskRequest } from "../models/api_gateway_waf_request.dto"
import { ApiGatewayWafClusterRepository } from "../repositories/api_gateway_waf_cluster.repository"
import { ApiGatewayWafCoreService } from "../services/api_gateway_waf_core.service"
import { ApiGatewayWafHeartbeatService } from "../services/api_gateway_waf_heartbeat.service"

class ApiGatewayWafUnitTestSuite {
    service: ApiGatewayWafCoreService
    heartbeat: ApiGatewayWafHeartbeatService

    init(service: ApiGatewayWafCoreService, heartbeat: ApiGatewayWafHeartbeatService) {
        this.service = service
        this.heartbeat = heartbeat
    }

    fn test_consensus_command_processing() -> Bool {
        let req = CreateApiGatewayWafTaskRequest {
            taskKey: "TASK-REPLICATE-101",
            originatingNodeId: 1,
            payloadVolume: 500,
            targetCluster: "ProductionClusterEast",
        }
        let res = this.service.processConsensusCommand(req)
        return match res {
            Ok(state) => state.id == 1 && state.isLeader,
            Err(e) => false,
        }
    }

    fn test_invalid_originating_node_rejected() -> Bool {
        let req = CreateApiGatewayWafTaskRequest {
            taskKey: "TASK-INVALID",
            originatingNodeId: -1,
            payloadVolume: 100,
            targetCluster: "ProductionClusterEast",
        }
        let res = this.service.processConsensusCommand(req)
        return match res {
            Ok(s) => false,
            Err(e) => e == "Originating node ID must be strictly positive",
        }
    }

    fn test_quorum_evaluation() -> Bool {
        return this.service.evaluateClusterQuorum()
    }

    fn test_heartbeat_ping() -> Bool {
        return this.heartbeat.pingPeer(2)
    }

    fn run() -> Unit {
        let t1 = this.test_consensus_command_processing()
        let t2 = this.test_invalid_originating_node_rejected()
        let t3 = this.test_quorum_evaluation()
        let t4 = this.test_heartbeat_ping()

        if t1 && t2 && t3 && t4 {
            print("  ✓ API Gateway & Web Application Firewall Unit Tests: 4/4 passed (Quorum, Invariants & Heartbeats Verified)")
        } else {
            print("  ✗ API Gateway & Web Application Firewall Unit Tests: failed")
        }
    }
}

let repo = ApiGatewayWafClusterRepository()
let service = ApiGatewayWafCoreService(repo)
let heartbeat = ApiGatewayWafHeartbeatService()
let suite = ApiGatewayWafUnitTestSuite(service, heartbeat)
suite.run()
