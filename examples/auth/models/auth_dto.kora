// ============================================================================
// Authentication Data Transfer Objects & Domain Models
// ============================================================================

model AuthUser {
    id: Int
    username: String
    passwordHash: String
    role: String
}

model RegisterRequest {
    username: String
    plainPassword: String
}

model LoginRequest {
    username: String
    plainPassword: String
}

model AuthTokenResponse {
    token: String
    tokenType: String
    expiresInSeconds: Int
}

