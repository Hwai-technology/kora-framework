// Example 51: Distributed Lock Manager & Fencing Tokens
// Core Domain Service Implementation

import { DistributedLockManagerNodeState } from "../entities/distributed_lock_manager_primary.entity"
import { CreateDistributedLockManagerTaskRequest } from "../models/distributed_lock_manager_request.dto"
import { DistributedLockManagerRepository } from "../interfaces/distributed_lock_manager_repository.interface"
import { DistributedLockManagerConsensusContract } from "../interfaces/distributed_lock_manager_service.interface"

class DistributedLockManagerCoreService implements DistributedLockManagerConsensusContract {
    repo: DistributedLockManagerRepository

    init(repo: DistributedLockManagerRepository) {
        this.repo = repo
    }

    fn processConsensusCommand(req: CreateDistributedLockManagerTaskRequest) -> Result<DistributedLockManagerNodeState, String> {
        if req.originatingNodeId <= 0 {
            return Err("Originating node ID must be strictly positive")
        }
        if req.payloadVolume <= 0 {
            return Err("Payload volume must be positive")
        }

        let state = DistributedLockManagerNodeState {
            id: req.originatingNodeId,
            nodeIdentifier: "CLUSTER-NODE-" + req.originatingNodeId.toString(),
            currentEpochTerm: 5,
            votedForCandidate: req.originatingNodeId,
            isLeader: true,
            active: true,
        }
        return this.repo.saveNodeState(state)
    }

    fn evaluateClusterQuorum() -> Bool {
        let quorum = this.repo.getActiveQuorumCount()
        return quorum >= 3
    }
}
