// ============================================================================
// Unit Test Suite: Distributed Lock Manager & Fencing Tokens
// Verifies Consensus Invariants, Quorum Validation, and Heartbeats
// ============================================================================

import { CreateDistributedLockManagerTaskRequest } from "../models/distributed_lock_manager_request.dto"
import { DistributedLockManagerClusterRepository } from "../repositories/distributed_lock_manager_cluster.repository"
import { DistributedLockManagerCoreService } from "../services/distributed_lock_manager_core.service"
import { DistributedLockManagerHeartbeatService } from "../services/distributed_lock_manager_heartbeat.service"

class DistributedLockManagerUnitTestSuite {
    service: DistributedLockManagerCoreService
    heartbeat: DistributedLockManagerHeartbeatService

    init(service: DistributedLockManagerCoreService, heartbeat: DistributedLockManagerHeartbeatService) {
        this.service = service
        this.heartbeat = heartbeat
    }

    fn test_consensus_command_processing() -> Bool {
        let req = CreateDistributedLockManagerTaskRequest {
            taskKey: "TASK-REPLICATE-101",
            originatingNodeId: 1,
            payloadVolume: 500,
            targetCluster: "ProductionClusterEast",
        }
        let res = this.service.processConsensusCommand(req)
        return match res {
            Ok(state) => state.id == 1 && state.isLeader,
            Err(e) => false,
        }
    }

    fn test_invalid_originating_node_rejected() -> Bool {
        let req = CreateDistributedLockManagerTaskRequest {
            taskKey: "TASK-INVALID",
            originatingNodeId: -1,
            payloadVolume: 100,
            targetCluster: "ProductionClusterEast",
        }
        let res = this.service.processConsensusCommand(req)
        return match res {
            Ok(s) => false,
            Err(e) => e == "Originating node ID must be strictly positive",
        }
    }

    fn test_quorum_evaluation() -> Bool {
        return this.service.evaluateClusterQuorum()
    }

    fn test_heartbeat_ping() -> Bool {
        return this.heartbeat.pingPeer(2)
    }

    fn run() -> Unit {
        let t1 = this.test_consensus_command_processing()
        let t2 = this.test_invalid_originating_node_rejected()
        let t3 = this.test_quorum_evaluation()
        let t4 = this.test_heartbeat_ping()

        if t1 && t2 && t3 && t4 {
            print("  ✓ Distributed Lock Manager & Fencing Tokens Unit Tests: 4/4 passed (Quorum, Invariants & Heartbeats Verified)")
        } else {
            print("  ✗ Distributed Lock Manager & Fencing Tokens Unit Tests: failed")
        }
    }
}

let repo = DistributedLockManagerClusterRepository()
let service = DistributedLockManagerCoreService(repo)
let heartbeat = DistributedLockManagerHeartbeatService()
let suite = DistributedLockManagerUnitTestSuite(service, heartbeat)
suite.run()
