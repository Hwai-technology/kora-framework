// Example 51: Distributed Lock Manager & Fencing Tokens
// Presentation Controller

import { CreateDistributedLockManagerTaskRequest } from "../models/distributed_lock_manager_request.dto"
import { DistributedLockManagerResponseDto } from "../models/distributed_lock_manager_response.dto"
import { DistributedLockManagerCoreService } from "../services/distributed_lock_manager_core.service"

class DistributedLockManagerController {
    service: DistributedLockManagerCoreService

    init(service: DistributedLockManagerCoreService) {
        this.service = service
    }

    fn handleTaskProposal(req: CreateDistributedLockManagerTaskRequest) -> DistributedLockManagerResponseDto {
        let outcome = this.service.processConsensusCommand(req)
        return match outcome {
            Ok(state) => DistributedLockManagerResponseDto {
                operationId: "CONSENSUS-TX-" + req.taskKey,
                nodeId: state.id,
                status: "QUORUM_COMMITTED",
                isQuorumSatisfied: true,
                message: "Log entry replicated and committed across cluster quorum",
            },
            Err(reason) => DistributedLockManagerResponseDto {
                operationId: "CONSENSUS-FAILED",
                nodeId: req.originatingNodeId,
                status: "QUORUM_REJECTED",
                isQuorumSatisfied: false,
                message: reason,
            },
        }
    }

    fn checkQuorumStatus() -> Bool {
        return this.service.evaluateClusterQuorum()
    }
}
