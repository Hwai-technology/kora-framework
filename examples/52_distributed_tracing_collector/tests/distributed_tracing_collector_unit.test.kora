// ============================================================================
// Unit Test Suite: Distributed Tracing & OpenTelemetry Collector
// Verifies Consensus Invariants, Quorum Validation, and Heartbeats
// ============================================================================

import { CreateDistributedTracingCollectorTaskRequest } from "../models/distributed_tracing_collector_request.dto"
import { DistributedTracingCollectorClusterRepository } from "../repositories/distributed_tracing_collector_cluster.repository"
import { DistributedTracingCollectorCoreService } from "../services/distributed_tracing_collector_core.service"
import { DistributedTracingCollectorHeartbeatService } from "../services/distributed_tracing_collector_heartbeat.service"

class DistributedTracingCollectorUnitTestSuite {
    service: DistributedTracingCollectorCoreService
    heartbeat: DistributedTracingCollectorHeartbeatService

    init(service: DistributedTracingCollectorCoreService, heartbeat: DistributedTracingCollectorHeartbeatService) {
        this.service = service
        this.heartbeat = heartbeat
    }

    fn test_consensus_command_processing() -> Bool {
        let req = CreateDistributedTracingCollectorTaskRequest {
            taskKey: "TASK-REPLICATE-101",
            originatingNodeId: 1,
            payloadVolume: 500,
            targetCluster: "ProductionClusterEast",
        }
        let res = this.service.processConsensusCommand(req)
        return match res {
            Ok(state) => state.id == 1 && state.isLeader,
            Err(e) => false,
        }
    }

    fn test_invalid_originating_node_rejected() -> Bool {
        let req = CreateDistributedTracingCollectorTaskRequest {
            taskKey: "TASK-INVALID",
            originatingNodeId: -1,
            payloadVolume: 100,
            targetCluster: "ProductionClusterEast",
        }
        let res = this.service.processConsensusCommand(req)
        return match res {
            Ok(s) => false,
            Err(e) => e == "Originating node ID must be strictly positive",
        }
    }

    fn test_quorum_evaluation() -> Bool {
        return this.service.evaluateClusterQuorum()
    }

    fn test_heartbeat_ping() -> Bool {
        return this.heartbeat.pingPeer(2)
    }

    fn run() -> Unit {
        let t1 = this.test_consensus_command_processing()
        let t2 = this.test_invalid_originating_node_rejected()
        let t3 = this.test_quorum_evaluation()
        let t4 = this.test_heartbeat_ping()

        if t1 && t2 && t3 && t4 {
            print("  ✓ Distributed Tracing & OpenTelemetry Collector Unit Tests: 4/4 passed (Quorum, Invariants & Heartbeats Verified)")
        } else {
            print("  ✗ Distributed Tracing & OpenTelemetry Collector Unit Tests: failed")
        }
    }
}

let repo = DistributedTracingCollectorClusterRepository()
let service = DistributedTracingCollectorCoreService(repo)
let heartbeat = DistributedTracingCollectorHeartbeatService()
let suite = DistributedTracingCollectorUnitTestSuite(service, heartbeat)
suite.run()
