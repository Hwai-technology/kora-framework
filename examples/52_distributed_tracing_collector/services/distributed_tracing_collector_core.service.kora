// Example 52: Distributed Tracing & OpenTelemetry Collector
// Core Domain Service Implementation

import { DistributedTracingCollectorNodeState } from "../entities/distributed_tracing_collector_primary.entity"
import { CreateDistributedTracingCollectorTaskRequest } from "../models/distributed_tracing_collector_request.dto"
import { DistributedTracingCollectorRepository } from "../interfaces/distributed_tracing_collector_repository.interface"
import { DistributedTracingCollectorConsensusContract } from "../interfaces/distributed_tracing_collector_service.interface"

class DistributedTracingCollectorCoreService implements DistributedTracingCollectorConsensusContract {
    repo: DistributedTracingCollectorRepository

    init(repo: DistributedTracingCollectorRepository) {
        this.repo = repo
    }

    fn processConsensusCommand(req: CreateDistributedTracingCollectorTaskRequest) -> Result<DistributedTracingCollectorNodeState, String> {
        if req.originatingNodeId <= 0 {
            return Err("Originating node ID must be strictly positive")
        }
        if req.payloadVolume <= 0 {
            return Err("Payload volume must be positive")
        }

        let state = DistributedTracingCollectorNodeState {
            id: req.originatingNodeId,
            nodeIdentifier: "CLUSTER-NODE-" + req.originatingNodeId.toString(),
            currentEpochTerm: 5,
            votedForCandidate: req.originatingNodeId,
            isLeader: true,
            active: true,
        }
        return this.repo.saveNodeState(state)
    }

    fn evaluateClusterQuorum() -> Bool {
        let quorum = this.repo.getActiveQuorumCount()
        return quorum >= 3
    }
}
