// ============================================================================
// Example 01: Core Language Basics, Enums, Match, Models & Class Architecture
// ============================================================================

import { Coordinates } from "./models/coordinates.model"
import { CustomerProfile } from "./models/customer_profile.model"
import { OrderStatus } from "./enums/order_status.enum"
import { CustomerTier } from "./enums/customer_tier.enum"
import { OrderProcessor } from "./services/order_processor.service"

class Application {
    processor: OrderProcessor

    init(processor: OrderProcessor) {
        this.processor = processor
    }

    fn bootstrap() -> Unit {
        let developer = "Ahmet"
        let location = Coordinates { lat: 41.0082, lng: 28.9784 }
        let customer = CustomerProfile {
            id: 101,
            fullName: "Enterprise Client",
            email: "client@kora.dev",
            tier: "Enterprise",
            loyaltyPoints: 500,
        }

        let baseAmount = 1200
        let discountPercent = this.processor.resolveTierDiscount(CustomerTier.Enterprise)
        let discountedSubtotal = this.processor.calculateDiscountedSubtotal(baseAmount, discountPercent)
        let finalAmount = this.processor.calculateTotal(discountedSubtotal, 18)

        let currentStatus = OrderStatus.Paid(finalAmount)
        let message = this.processor.describeOrder(currentStatus)

        print(developer)
        print(message)
    }
}

let processor = OrderProcessor()
let app = Application(processor)
app.bootstrap()
