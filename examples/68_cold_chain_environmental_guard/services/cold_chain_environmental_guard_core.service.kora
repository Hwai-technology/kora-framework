// Example 68: Cold Chain Vaccine Temperature Monitoring
// Core Domain Service Implementation

import { ColdChainEnvironmentalGuardPrimaryRecord } from "../entities/cold_chain_environmental_guard_primary.entity"
import { CreateColdChainEnvironmentalGuardTaskRequest } from "../models/cold_chain_environmental_guard_request.dto"
import { ColdChainEnvironmentalGuardRepository } from "../interfaces/cold_chain_environmental_guard_repository.interface"
import { ColdChainEnvironmentalGuardDomainContract } from "../interfaces/cold_chain_environmental_guard_service.interface"

class ColdChainEnvironmentalGuardCoreService implements ColdChainEnvironmentalGuardDomainContract {
    repo: ColdChainEnvironmentalGuardRepository

    init(repo: ColdChainEnvironmentalGuardRepository) {
        this.repo = repo
    }

    fn executeTask(req: CreateColdChainEnvironmentalGuardTaskRequest) -> Result<ColdChainEnvironmentalGuardPrimaryRecord, String> {
        if req.targetEntityId <= 0 {
            return Err("Target entity ID must be strictly positive")
        }
        if req.workloadCapacity <= 0 {
            return Err("Workload capacity must be strictly positive")
        }

        let record = ColdChainEnvironmentalGuardPrimaryRecord {
            id: req.targetEntityId,
            referenceCode: req.taskKey,
            capacityScore: req.workloadCapacity,
            operationalStatus: "COMMITTED_HEALTHY",
            active: true,
        }
        return this.repo.save(record)
    }

    fn evaluateHealth(entityId: Int) -> String {
        let opt = this.repo.findById(entityId)
        let isPresent = match opt {
            Some(r) => true,
            None => false,
        }
        if !isPresent {
            return "ENTITY_NOT_FOUND"
        }
        let record = match opt {
            Some(r) => r,
            None => ColdChainEnvironmentalGuardPrimaryRecord { id: 0, referenceCode: "", capacityScore: 0, operationalStatus: "", active: false },
        }
        if record.capacityScore > 80 {
            return "OPTIMUM_PERFORMANCE"
        }
        if record.capacityScore > 40 {
            return "MODERATE_NORMAL"
        }
        return "LOW_CAPACITY"
    }
}
