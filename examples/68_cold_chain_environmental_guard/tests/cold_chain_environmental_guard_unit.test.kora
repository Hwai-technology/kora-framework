// ============================================================================
// Unit Test Suite: Cold Chain Vaccine Temperature Monitoring
// Verifies Domain Invariants, Boundary Calculations & Liveness
// ============================================================================

import { CreateColdChainEnvironmentalGuardTaskRequest } from "../models/cold_chain_environmental_guard_request.dto"
import { ColdChainEnvironmentalGuardInMemoryRepository } from "../repositories/cold_chain_environmental_guard_inmemory.repository"
import { ColdChainEnvironmentalGuardCoreService } from "../services/cold_chain_environmental_guard_core.service"
import { ColdChainEnvironmentalGuardTelemetryService } from "../services/cold_chain_environmental_guard_telemetry.service"

class ColdChainEnvironmentalGuardUnitTestSuite {
    service: ColdChainEnvironmentalGuardCoreService
    telemetry: ColdChainEnvironmentalGuardTelemetryService

    init(service: ColdChainEnvironmentalGuardCoreService, telemetry: ColdChainEnvironmentalGuardTelemetryService) {
        this.service = service
        this.telemetry = telemetry
    }

    fn test_valid_task_execution() -> Bool {
        let req = CreateColdChainEnvironmentalGuardTaskRequest {
            taskKey: "UNIT-TASK-101",
            targetEntityId: 10,
            workloadCapacity: 95,
            domainContext: "IoT & Robotics",
        }
        let res = this.service.executeTask(req)
        return match res {
            Ok(rec) => rec.id == 10 && rec.capacityScore == 95,
            Err(e) => false,
        }
    }

    fn test_invalid_negative_target_rejected() -> Bool {
        let req = CreateColdChainEnvironmentalGuardTaskRequest {
            taskKey: "INVALID-TASK",
            targetEntityId: -1,
            workloadCapacity: 50,
            domainContext: "IoT & Robotics",
        }
        let res = this.service.executeTask(req)
        return match res {
            Ok(r) => false,
            Err(e) => e == "Target entity ID must be strictly positive",
        }
    }

    fn test_health_evaluation() -> Bool {
        let health = this.service.evaluateHealth(10)
        return health == "OPTIMUM_PERFORMANCE" || health == "MODERATE_NORMAL"
    }

    fn test_telemetry_ping() -> Bool {
        return this.telemetry.ping()
    }

    fn run() -> Unit {
        let t1 = this.test_valid_task_execution()
        let t2 = this.test_invalid_negative_target_rejected()
        let t3 = this.test_health_evaluation()
        let t4 = this.test_telemetry_ping()

        if t1 && t2 && t3 && t4 {
            print("  ✓ Cold Chain Vaccine Temperature Monitoring Unit Tests: 4/4 passed (Domain Invariants Verified)")
        } else {
            print("  ✗ Cold Chain Vaccine Temperature Monitoring Unit Tests: failed")
        }
    }
}

let repo = ColdChainEnvironmentalGuardInMemoryRepository()
let service = ColdChainEnvironmentalGuardCoreService(repo)
let telemetry = ColdChainEnvironmentalGuardTelemetryService()
let suite = ColdChainEnvironmentalGuardUnitTestSuite(service, telemetry)
suite.run()
