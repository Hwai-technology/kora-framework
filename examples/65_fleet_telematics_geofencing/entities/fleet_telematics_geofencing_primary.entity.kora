// Example 65: Fleet Telematics & Polygonal Geofence Monitor
// Persistent Database Entity: Primary Record

@table("fleet_telematics_geofencing_records")
model FleetTelematicsGeofencingPrimaryRecord {
    @id
    id: Int
    @unique
    referenceCode: String
    capacityScore: Int
    operationalStatus: String
    active: Bool
}
