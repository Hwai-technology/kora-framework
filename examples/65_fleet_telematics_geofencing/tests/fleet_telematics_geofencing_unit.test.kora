// ============================================================================
// Unit Test Suite: Fleet Telematics & Polygonal Geofence Monitor
// Verifies Domain Invariants, Boundary Calculations & Liveness
// ============================================================================

import { CreateFleetTelematicsGeofencingTaskRequest } from "../models/fleet_telematics_geofencing_request.dto"
import { FleetTelematicsGeofencingInMemoryRepository } from "../repositories/fleet_telematics_geofencing_inmemory.repository"
import { FleetTelematicsGeofencingCoreService } from "../services/fleet_telematics_geofencing_core.service"
import { FleetTelematicsGeofencingTelemetryService } from "../services/fleet_telematics_geofencing_telemetry.service"

class FleetTelematicsGeofencingUnitTestSuite {
    service: FleetTelematicsGeofencingCoreService
    telemetry: FleetTelematicsGeofencingTelemetryService

    init(service: FleetTelematicsGeofencingCoreService, telemetry: FleetTelematicsGeofencingTelemetryService) {
        this.service = service
        this.telemetry = telemetry
    }

    fn test_valid_task_execution() -> Bool {
        let req = CreateFleetTelematicsGeofencingTaskRequest {
            taskKey: "UNIT-TASK-101",
            targetEntityId: 10,
            workloadCapacity: 95,
            domainContext: "IoT & Robotics",
        }
        let res = this.service.executeTask(req)
        return match res {
            Ok(rec) => rec.id == 10 && rec.capacityScore == 95,
            Err(e) => false,
        }
    }

    fn test_invalid_negative_target_rejected() -> Bool {
        let req = CreateFleetTelematicsGeofencingTaskRequest {
            taskKey: "INVALID-TASK",
            targetEntityId: -1,
            workloadCapacity: 50,
            domainContext: "IoT & Robotics",
        }
        let res = this.service.executeTask(req)
        return match res {
            Ok(r) => false,
            Err(e) => e == "Target entity ID must be strictly positive",
        }
    }

    fn test_health_evaluation() -> Bool {
        let health = this.service.evaluateHealth(10)
        return health == "OPTIMUM_PERFORMANCE" || health == "MODERATE_NORMAL"
    }

    fn test_telemetry_ping() -> Bool {
        return this.telemetry.ping()
    }

    fn run() -> Unit {
        let t1 = this.test_valid_task_execution()
        let t2 = this.test_invalid_negative_target_rejected()
        let t3 = this.test_health_evaluation()
        let t4 = this.test_telemetry_ping()

        if t1 && t2 && t3 && t4 {
            print("  ✓ Fleet Telematics & Polygonal Geofence Monitor Unit Tests: 4/4 passed (Domain Invariants Verified)")
        } else {
            print("  ✗ Fleet Telematics & Polygonal Geofence Monitor Unit Tests: failed")
        }
    }
}

let repo = FleetTelematicsGeofencingInMemoryRepository()
let service = FleetTelematicsGeofencingCoreService(repo)
let telemetry = FleetTelematicsGeofencingTelemetryService()
let suite = FleetTelematicsGeofencingUnitTestSuite(service, telemetry)
suite.run()
