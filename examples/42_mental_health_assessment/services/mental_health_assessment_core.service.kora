// Example 42: Mental Health Longitudinal Assessment Engine
// Core Domain Service Implementation

import { MentalHealthAssessmentClinicalEntity } from "../entities/mental_health_assessment_primary.entity"
import { CreateMentalHealthAssessmentRecordRequest } from "../models/mental_health_assessment_request.dto"
import { MentalHealthAssessmentRepository } from "../interfaces/mental_health_assessment_repository.interface"
import { MentalHealthAssessmentDomainContract } from "../interfaces/mental_health_assessment_service.interface"

class MentalHealthAssessmentCoreService implements MentalHealthAssessmentDomainContract {
    repo: MentalHealthAssessmentRepository

    init(repo: MentalHealthAssessmentRepository) {
        this.repo = repo
    }

    fn processClinicalRecord(req: CreateMentalHealthAssessmentRecordRequest) -> Result<MentalHealthAssessmentClinicalEntity, String> {
        if req.patientId <= 0 {
            return Err("Patient ID must be strictly positive")
        }
        if req.clinicalMetricScore < 0 {
            return Err("Clinical metric score cannot be negative")
        }

        let entity = MentalHealthAssessmentClinicalEntity {
            id: req.patientId + 5000,
            patientId: req.patientId,
            clinicianId: req.clinicianId,
            clinicalMetricScore: req.clinicalMetricScore,
            complianceState: "AUDITED_SECURE",
            active: true,
        }
        return this.repo.save(entity)
    }

    fn evaluateClinicalRisk(patientId: Int) -> String {
        let opt = this.repo.findByPatientId(patientId)
        let isPresent = match opt {
            Some(r) => true,
            None => false,
        }
        if !isPresent {
            return "RECORD_NOT_FOUND"
        }
        let record = match opt {
            Some(r) => r,
            None => MentalHealthAssessmentClinicalEntity { id: 0, patientId: 0, clinicianId: 0, clinicalMetricScore: 0, complianceState: "", active: false },
        }
        if record.clinicalMetricScore > 80 {
            return "CRITICAL_OBSERVATION"
        }
        if record.clinicalMetricScore > 40 {
            return "MODERATE_ATTENTION"
        }
        return "NOMINAL_STABLE"
    }
}
