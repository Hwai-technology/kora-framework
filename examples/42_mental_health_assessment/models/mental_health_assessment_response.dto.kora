// Example 42: Mental Health Longitudinal Assessment Engine
// Transport Model: Standard Responses

model MentalHealthAssessmentResponseDto {
    recordId: Int
    patientId: Int
    status: String
    isComplianceVerified: Bool
    message: String
}

model MentalHealthAssessmentSummaryDto {
    patientId: Int
    totalEntries: Int
    severityCategory: String
    lastReviewedTimestamp: Int
}
