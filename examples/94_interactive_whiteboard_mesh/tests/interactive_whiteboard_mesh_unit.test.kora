// ============================================================================
// Unit Test Suite: Interactive Vector Whiteboard & Delta Sync
// Verifies Domain Invariants, Boundary Calculations & Liveness
// ============================================================================

import { CreateInteractiveWhiteboardMeshTaskRequest } from "../models/interactive_whiteboard_mesh_request.dto"
import { InteractiveWhiteboardMeshInMemoryRepository } from "../repositories/interactive_whiteboard_mesh_inmemory.repository"
import { InteractiveWhiteboardMeshCoreService } from "../services/interactive_whiteboard_mesh_core.service"
import { InteractiveWhiteboardMeshTelemetryService } from "../services/interactive_whiteboard_mesh_telemetry.service"

class InteractiveWhiteboardMeshUnitTestSuite {
    service: InteractiveWhiteboardMeshCoreService
    telemetry: InteractiveWhiteboardMeshTelemetryService

    init(service: InteractiveWhiteboardMeshCoreService, telemetry: InteractiveWhiteboardMeshTelemetryService) {
        this.service = service
        this.telemetry = telemetry
    }

    fn test_valid_task_execution() -> Bool {
        let req = CreateInteractiveWhiteboardMeshTaskRequest {
            taskKey: "UNIT-TASK-101",
            targetEntityId: 10,
            workloadCapacity: 95,
            domainContext: "Media & Realtime",
        }
        let res = this.service.executeTask(req)
        return match res {
            Ok(rec) => rec.id == 10 && rec.capacityScore == 95,
            Err(e) => false,
        }
    }

    fn test_invalid_negative_target_rejected() -> Bool {
        let req = CreateInteractiveWhiteboardMeshTaskRequest {
            taskKey: "INVALID-TASK",
            targetEntityId: -1,
            workloadCapacity: 50,
            domainContext: "Media & Realtime",
        }
        let res = this.service.executeTask(req)
        return match res {
            Ok(r) => false,
            Err(e) => e == "Target entity ID must be strictly positive",
        }
    }

    fn test_health_evaluation() -> Bool {
        let health = this.service.evaluateHealth(10)
        return health == "OPTIMUM_PERFORMANCE" || health == "MODERATE_NORMAL"
    }

    fn test_telemetry_ping() -> Bool {
        return this.telemetry.ping()
    }

    fn run() -> Unit {
        let t1 = this.test_valid_task_execution()
        let t2 = this.test_invalid_negative_target_rejected()
        let t3 = this.test_health_evaluation()
        let t4 = this.test_telemetry_ping()

        if t1 && t2 && t3 && t4 {
            print("  ✓ Interactive Vector Whiteboard & Delta Sync Unit Tests: 4/4 passed (Domain Invariants Verified)")
        } else {
            print("  ✗ Interactive Vector Whiteboard & Delta Sync Unit Tests: failed")
        }
    }
}

let repo = InteractiveWhiteboardMeshInMemoryRepository()
let service = InteractiveWhiteboardMeshCoreService(repo)
let telemetry = InteractiveWhiteboardMeshTelemetryService()
let suite = InteractiveWhiteboardMeshUnitTestSuite(service, telemetry)
suite.run()
