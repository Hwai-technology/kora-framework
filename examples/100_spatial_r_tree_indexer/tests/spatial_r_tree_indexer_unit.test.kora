// ============================================================================
// Unit Test Suite: Spatial 2D R-Tree & k-Nearest Neighbors (k-NN)
// Verifies Domain Invariants, Boundary Calculations & Liveness
// ============================================================================

import { CreateSpatialRTreeIndexerTaskRequest } from "../models/spatial_r_tree_indexer_request.dto"
import { SpatialRTreeIndexerInMemoryRepository } from "../repositories/spatial_r_tree_indexer_inmemory.repository"
import { SpatialRTreeIndexerCoreService } from "../services/spatial_r_tree_indexer_core.service"
import { SpatialRTreeIndexerTelemetryService } from "../services/spatial_r_tree_indexer_telemetry.service"

class SpatialRTreeIndexerUnitTestSuite {
    service: SpatialRTreeIndexerCoreService
    telemetry: SpatialRTreeIndexerTelemetryService

    init(service: SpatialRTreeIndexerCoreService, telemetry: SpatialRTreeIndexerTelemetryService) {
        this.service = service
        this.telemetry = telemetry
    }

    fn test_valid_task_execution() -> Bool {
        let req = CreateSpatialRTreeIndexerTaskRequest {
            taskKey: "UNIT-TASK-101",
            targetEntityId: 10,
            workloadCapacity: 95,
            domainContext: "Algorithms & Kernels",
        }
        let res = this.service.executeTask(req)
        return match res {
            Ok(rec) => rec.id == 10 && rec.capacityScore == 95,
            Err(e) => false,
        }
    }

    fn test_invalid_negative_target_rejected() -> Bool {
        let req = CreateSpatialRTreeIndexerTaskRequest {
            taskKey: "INVALID-TASK",
            targetEntityId: -1,
            workloadCapacity: 50,
            domainContext: "Algorithms & Kernels",
        }
        let res = this.service.executeTask(req)
        return match res {
            Ok(r) => false,
            Err(e) => e == "Target entity ID must be strictly positive",
        }
    }

    fn test_health_evaluation() -> Bool {
        let health = this.service.evaluateHealth(10)
        return health == "OPTIMUM_PERFORMANCE" || health == "MODERATE_NORMAL"
    }

    fn test_telemetry_ping() -> Bool {
        return this.telemetry.ping()
    }

    fn run() -> Unit {
        let t1 = this.test_valid_task_execution()
        let t2 = this.test_invalid_negative_target_rejected()
        let t3 = this.test_health_evaluation()
        let t4 = this.test_telemetry_ping()

        if t1 && t2 && t3 && t4 {
            print("  ✓ Spatial 2D R-Tree & k-Nearest Neighbors (k-NN) Unit Tests: 4/4 passed (Domain Invariants Verified)")
        } else {
            print("  ✗ Spatial 2D R-Tree & k-Nearest Neighbors (k-NN) Unit Tests: failed")
        }
    }
}

let repo = SpatialRTreeIndexerInMemoryRepository()
let service = SpatialRTreeIndexerCoreService(repo)
let telemetry = SpatialRTreeIndexerTelemetryService()
let suite = SpatialRTreeIndexerUnitTestSuite(service, telemetry)
suite.run()
