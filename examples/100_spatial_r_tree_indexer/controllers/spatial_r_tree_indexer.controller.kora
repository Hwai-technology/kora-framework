// Example 100: Spatial 2D R-Tree & k-Nearest Neighbors (k-NN)
// Presentation Controller

import { CreateSpatialRTreeIndexerTaskRequest } from "../models/spatial_r_tree_indexer_request.dto"
import { SpatialRTreeIndexerResponseDto } from "../models/spatial_r_tree_indexer_response.dto"
import { SpatialRTreeIndexerCoreService } from "../services/spatial_r_tree_indexer_core.service"

class SpatialRTreeIndexerController {
    service: SpatialRTreeIndexerCoreService

    init(service: SpatialRTreeIndexerCoreService) {
        this.service = service
    }

    fn handleTaskSubmission(req: CreateSpatialRTreeIndexerTaskRequest) -> SpatialRTreeIndexerResponseDto {
        let outcome = this.service.executeTask(req)
        return match outcome {
            Ok(rec) => SpatialRTreeIndexerResponseDto {
                operationId: "TX-" + req.taskKey,
                entityId: rec.id,
                status: "EXECUTION_SUCCESSFUL",
                isVerified: true,
                message: "Operation completed under Clean Architecture invariants",
            },
            Err(reason) => SpatialRTreeIndexerResponseDto {
                operationId: "TX-FAILED",
                entityId: req.targetEntityId,
                status: "EXECUTION_REJECTED",
                isVerified: false,
                message: reason,
            },
        }
    }

    fn inspectHealth(entityId: Int) -> String {
        return this.service.evaluateHealth(entityId)
    }
}
