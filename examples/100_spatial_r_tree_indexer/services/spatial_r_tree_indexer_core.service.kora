// Example 100: Spatial 2D R-Tree & k-Nearest Neighbors (k-NN)
// Core Domain Service Implementation

import { SpatialRTreeIndexerPrimaryRecord } from "../entities/spatial_r_tree_indexer_primary.entity"
import { CreateSpatialRTreeIndexerTaskRequest } from "../models/spatial_r_tree_indexer_request.dto"
import { SpatialRTreeIndexerRepository } from "../interfaces/spatial_r_tree_indexer_repository.interface"
import { SpatialRTreeIndexerDomainContract } from "../interfaces/spatial_r_tree_indexer_service.interface"

class SpatialRTreeIndexerCoreService implements SpatialRTreeIndexerDomainContract {
    repo: SpatialRTreeIndexerRepository

    init(repo: SpatialRTreeIndexerRepository) {
        this.repo = repo
    }

    fn executeTask(req: CreateSpatialRTreeIndexerTaskRequest) -> Result<SpatialRTreeIndexerPrimaryRecord, String> {
        if req.targetEntityId <= 0 {
            return Err("Target entity ID must be strictly positive")
        }
        if req.workloadCapacity <= 0 {
            return Err("Workload capacity must be strictly positive")
        }

        let record = SpatialRTreeIndexerPrimaryRecord {
            id: req.targetEntityId,
            referenceCode: req.taskKey,
            capacityScore: req.workloadCapacity,
            operationalStatus: "COMMITTED_HEALTHY",
            active: true,
        }
        return this.repo.save(record)
    }

    fn evaluateHealth(entityId: Int) -> String {
        let opt = this.repo.findById(entityId)
        let isPresent = match opt {
            Some(r) => true,
            None => false,
        }
        if !isPresent {
            return "ENTITY_NOT_FOUND"
        }
        let record = match opt {
            Some(r) => r,
            None => SpatialRTreeIndexerPrimaryRecord { id: 0, referenceCode: "", capacityScore: 0, operationalStatus: "", active: false },
        }
        if record.capacityScore > 80 {
            return "OPTIMUM_PERFORMANCE"
        }
        if record.capacityScore > 40 {
            return "MODERATE_NORMAL"
        }
        return "LOW_CAPACITY"
    }
}
