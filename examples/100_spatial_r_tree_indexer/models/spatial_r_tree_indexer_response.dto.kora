// Example 100: Spatial 2D R-Tree & k-Nearest Neighbors (k-NN)
// Transport Model: Standard Response

model SpatialRTreeIndexerResponseDto {
    operationId: String
    entityId: Int
    status: String
    isVerified: Bool
    message: String
}

model SpatialRTreeIndexerSummaryDto {
    totalProcessed: Int
    healthyNodesCount: Int
    systemState: String
}
