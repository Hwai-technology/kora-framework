// ============================================================================
// Kora Example 3: Full CRUD RESTful API with Dynamic SEO & Geo Location Meta
// ============================================================================

model SeoMetadata {
    title: String
    description: String
    canonicalUrl: String
    ogTitle: String
    ogDescription: String
}

model GeoLocation {
    clientIp: String
    country: String
    city: String
    region: String
    timezone: String
}

model Product {
    id: Int
    sku: String
    title: String
    priceCents: Int
    inStock: Bool
}

model ProductDetailsResponse {
    product: Product
    seo: SeoMetadata
    geo: GeoLocation
}

model ProductCatalogResponse {
    products: List<Product>
    total: Int
    seo: SeoMetadata
    geo: GeoLocation
}

model CreateProductRequest {
    sku: String
    title: String
    priceCents: Int
}

model UpdateProductRequest {
    title: String
    priceCents: Int
    inStock: Bool
}

interface ProductRepository {
    fn listAll() -> List<Product>
    fn findById(id: Int) -> Option<Product>
    fn create(req: CreateProductRequest) -> Result<Product, String>
    fn update(id: Int, req: UpdateProductRequest) -> Result<Product, String>
    fn deleteById(id: Int) -> Bool
    fn getCatalogSeo() -> SeoMetadata
    fn getProductSeo(product: Product) -> SeoMetadata
    fn getGeoLocation() -> GeoLocation
}

class ProductService implements ProductRepository {
    db: Database

    init(db: Database) {
        this.db = db
    }

    fn listAll() -> List<Product> {
        return [
            Product {
                id: 1,
                sku: "PRD-001",
                title: "Mechanical Keyboard",
                priceCents: 12900,
                inStock: true,
            },
            Product {
                id: 2,
                sku: "PRD-002",
                title: "Wireless Gaming Mouse",
                priceCents: 7900,
                inStock: true,
            }
        ]
    }

    fn findById(id: Int) -> Option<Product> {
        if id <= 0 {
            return None
        }
        return Some(Product {
            id: id,
            sku: "PRD-001",
            title: "Mechanical Keyboard",
            priceCents: 12900,
            inStock: true,
        })
    }

    fn getCatalogSeo() -> SeoMetadata {
        return SeoMetadata {
            title: "Hardware & Accessories Catalog | Kora Official Store",
            description: "Browse premium gaming keyboards, ergonomic mice, and hardware with live stock updates and instant dispatch.",
            canonicalUrl: "http://127.0.0.1:7582/products",
            ogTitle: "Hardware & Accessories Catalog - Kora Store",
            ogDescription: "High-performance developer peripherals and equipment.",
        }
    }

    fn getProductSeo(product: Product) -> SeoMetadata {
        return SeoMetadata {
            title: product.title + " | Kora Store",
            description: "Official specifications and stock availability for " + product.title + " (SKU: " + product.sku + ").",
            canonicalUrl: "http://127.0.0.1:7582/products/" + product.id.toString(),
            ogTitle: product.title + " - Buy Online",
            ogDescription: "In stock with instant global delivery.",
        }
    }

    fn getGeoLocation() -> GeoLocation {
        return GeoLocation {
            clientIp: "127.0.0.1",
            country: "United States",
            city: "San Francisco",
            region: "California",
            timezone: "UTC",
        }
    }

    fn create(req: CreateProductRequest) -> Result<Product, String> {
        if req.sku == "" {
            return Err("SKU is required")
        }
        if req.priceCents <= 0 {
            return Err("Price must be greater than zero")
        }
        return Ok(Product {
            id: 100,
            sku: req.sku,
            title: req.title,
            priceCents: req.priceCents,
            inStock: true,
        })
    }

    fn update(id: Int, req: UpdateProductRequest) -> Result<Product, String> {
        if id <= 0 {
            return Err("Product not found")
        }
        return Ok(Product {
            id: id,
            sku: "PRD-EXISTING",
            title: req.title,
            priceCents: req.priceCents,
            inStock: req.inStock,
        })
    }

    fn deleteById(id: Int) -> Bool {
        if id <= 0 {
            return false
        }
        return true
    }
}

// Zero-Config CRUD Routes with Automatic JSON Serialization & Dependency Injection
let app = run()

// 1. GET /products -> List all products with dynamic SEO and Geo metadata
get("/products", (svc: ProductService) => {
    let items = svc.listAll()
    let seo = svc.getCatalogSeo()
    let geo = svc.getGeoLocation()
    return ProductCatalogResponse {
        products: items,
        total: 2,
        seo: seo,
        geo: geo,
    }
})

// 2. GET /products/{id} -> Single product details with dynamic per-item SEO and Geo
get("/products/{id}", (id: Int, svc: ProductService) => {
    let opt = svc.findById(id)
    match opt {
        Some(p) => {
            let seo = svc.getProductSeo(p)
            let geo = svc.getGeoLocation()
            return Ok(ProductDetailsResponse {
                product: p,
                seo: seo,
                geo: geo,
            })
        },
        null => {
            return Err("Product not found")
        }
    }
})

// 3. POST /products -> Create a new product
post("/products", (request: Request, svc: ProductService) => {
    let req = CreateProductRequest {
        sku: "PRD-NEW",
        title: request.body,
        priceCents: 4999,
    }
    return svc.create(req)
})

// 4. PUT /products/{id} -> Update existing product
put("/products/{id}", (id: Int, request: Request, svc: ProductService) => {
    let req = UpdateProductRequest {
        title: request.body,
        priceCents: 5999,
        inStock: true,
    }
    return svc.update(id, req)
})

// 5. DELETE /products/{id} -> Delete product
delete("/products/{id}", (id: Int, svc: ProductService) => {
    return svc.deleteById(id)
})
