class TelemetrySeeder {
    db: Database

    init(db: Database) {
        this.db = db
    }

    fn seed() -> Result<Bool, String> {
        this.db.execute("INSERT INTO iot_metrics (id, deviceId, temperatureCelsius, batteryPercent, active) VALUES (1, 'sensor-factory-01', 22, 100, true) ON CONFLICT (id) DO NOTHING")
        return Ok(true)
    }
}
