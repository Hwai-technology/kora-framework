// ============================================================================
// Unit Test Suite: algorithmic_market_maker
// ============================================================================

import { CreateAlgorithmicMarketMakerRequest } from "../models/algorithmic_market_maker_request.dto"
import { AlgorithmicMarketMakerPrimaryRepository } from "../repositories/algorithmic_market_maker_primary.repository"
import { AlgorithmicMarketMakerCoreService } from "../services/algorithmic_market_maker_core.service"
import { AlgorithmicMarketMakerValidationService } from "../services/algorithmic_market_maker_validation.service"

class AlgorithmicMarketMakerUnitTestSuite {
    service: AlgorithmicMarketMakerCoreService
    validator: AlgorithmicMarketMakerValidationService

    init(service: AlgorithmicMarketMakerCoreService, validator: AlgorithmicMarketMakerValidationService) {
        this.service = service
        this.validator = validator
    }

    fn test_valid_processing() -> Bool {
        let req = CreateAlgorithmicMarketMakerRequest {
            reference: "TEST-REF-100",
            targetId: 10,
            volume: 500,
            currency: "USD",
        }
        let res = this.service.processRequest(req)
        return match res {
            Ok(rec) => rec.status == "COMMITTED" && rec.balance == 500,
            Err(e) => false,
        }
    }

    fn test_invalid_volume() -> Bool {
        let req = CreateAlgorithmicMarketMakerRequest {
            reference: "TEST-REF-FAIL",
            targetId: 11,
            volume: -10,
            currency: "USD",
        }
        let res = this.service.processRequest(req)
        return match res {
            Ok(r) => false,
            Err(e) => e == "Volume must be positive",
        }
    }

    fn test_validator() -> Bool {
        let req = CreateAlgorithmicMarketMakerRequest {
            reference: "VALID-REF",
            targetId: 12,
            volume: 100,
            currency: "USD",
        }
        let res = this.validator.validateInput(req)
        return match res {
            Ok(v) => v,
            Err(e) => false,
        }
    }

    fn run() -> Unit {
        let t1 = this.test_valid_processing()
        let t2 = this.test_invalid_volume()
        let t3 = this.test_validator()

        if t1 && t2 && t3 {
            print("  ✓ Algorithmic Market Maker & Quoting Engine Unit Tests: 3/3 passed")
        } else {
            print("  ✗ Algorithmic Market Maker & Quoting Engine Unit Tests: failed")
        }
    }
}

let repo = AlgorithmicMarketMakerPrimaryRepository()
let service = AlgorithmicMarketMakerCoreService(repo)
let validator = AlgorithmicMarketMakerValidationService()
let suite = AlgorithmicMarketMakerUnitTestSuite(service, validator)
suite.run()
