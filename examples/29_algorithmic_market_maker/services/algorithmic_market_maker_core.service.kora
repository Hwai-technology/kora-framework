// Example 29: Algorithmic Market Maker & Quoting Engine
// Core Domain Service Implementation

import { AlgorithmicMarketMakerRecord } from "../entities/algorithmic_market_maker_primary.entity"
import { CreateAlgorithmicMarketMakerRequest } from "../models/algorithmic_market_maker_request.dto"
import { AlgorithmicMarketMakerRepository } from "../interfaces/algorithmic_market_maker_repository.interface"
import { AlgorithmicMarketMakerServiceInterface } from "../interfaces/algorithmic_market_maker_service.interface"

class AlgorithmicMarketMakerCoreService implements AlgorithmicMarketMakerServiceInterface {
    repo: AlgorithmicMarketMakerRepository

    init(repo: AlgorithmicMarketMakerRepository) {
        this.repo = repo
    }

    fn processRequest(req: CreateAlgorithmicMarketMakerRequest) -> Result<AlgorithmicMarketMakerRecord, String> {
        if req.volume <= 0 {
            return Err("Volume must be positive")
        }
        let record = AlgorithmicMarketMakerRecord {
            id: req.targetId,
            reference: req.reference,
            status: "COMMITTED",
            balance: req.volume,
            active: true,
        }
        return this.repo.save(record)
    }

    fn validateState(id: Int) -> Bool {
        let opt = this.repo.findById(id)
        return match opt {
            Some(rec) => rec.active,
            None => false,
        }
    }
}
