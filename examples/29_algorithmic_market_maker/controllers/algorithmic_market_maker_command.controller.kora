// Example 29: Algorithmic Market Maker & Quoting Engine
// Command Controller (Mutations & Writes)

import { CreateAlgorithmicMarketMakerRequest } from "../models/algorithmic_market_maker_request.dto"
import { AlgorithmicMarketMakerResponse } from "../models/algorithmic_market_maker_response.dto"
import { AlgorithmicMarketMakerCoreService } from "../services/algorithmic_market_maker_core.service"

class AlgorithmicMarketMakerCommandController {
    service: AlgorithmicMarketMakerCoreService

    init(service: AlgorithmicMarketMakerCoreService) {
        this.service = service
    }

    fn handleCreate(req: CreateAlgorithmicMarketMakerRequest) -> AlgorithmicMarketMakerResponse {
        let outcome = this.service.processRequest(req)
        return match outcome {
            Ok(rec) => AlgorithmicMarketMakerResponse {
                id: rec.id,
                reference: rec.reference,
                success: true,
                statusCode: 201,
                message: "Created successfully",
            },
            Err(reason) => AlgorithmicMarketMakerResponse {
                id: -1,
                reference: req.reference,
                success: false,
                statusCode: 400,
                message: reason,
            },
        }
    }
}
