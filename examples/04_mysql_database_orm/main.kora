// ============================================================================
// Example 04: MySQL Database Connection & ORM Repository — Main Entrypoint
// ============================================================================

import { CustomerRouter } from "./routes/customer.routes"

let app = run()

get("/customers/lookup", (request: Request, routes: CustomerRouter) => {
    return routes.lookup(request.body)
})

post("/customers", (request: Request, routes: CustomerRouter) => {
    return routes.register(request.body)
})

post("/customers/{id}/credit", (id: Int, request: Request, routes: CustomerRouter) => {
    return routes.addCredit(id, 250)
})
