// ============================================================================
// MySQL Customer Router
// ============================================================================

import { Customer, CustomerSignupInput } from "../models/customer.models"
import { MySqlCustomerRepository } from "../services/mysql_customer.service"

class CustomerRouter {
    repo: MySqlCustomerRepository

    init(repo: MySqlCustomerRepository) {
        this.repo = repo
    }

    fn lookup(email: String) -> Option<Customer> {
        return this.repo.findByEmail(email)
    }

    fn register(email: String) -> Result<Customer, String> {
        let input = CustomerSignupInput {
            fullName: "New Customer",
            email: email,
            initialCredit: 1000,
        }
        return this.repo.insertCustomer(input)
    }

    fn addCredit(id: Int, amount: Int) -> Result<Customer, String> {
        return this.repo.addCredit(id, amount)
    }
}
