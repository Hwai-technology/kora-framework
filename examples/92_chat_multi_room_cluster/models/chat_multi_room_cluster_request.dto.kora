// Example 92: Multi-Room WebSocket Chat & Presence Cluster
// Transport Model: Command Request

model CreateChatMultiRoomClusterTaskRequest {
    taskKey: String
    targetEntityId: Int
    workloadCapacity: Int
    domainContext: String
}

model QueryChatMultiRoomClusterFilterRequest {
    filterKey: String
    limit: Int
    includeInactive: Bool
}
