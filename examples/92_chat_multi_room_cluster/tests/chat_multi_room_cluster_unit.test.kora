// ============================================================================
// Unit Test Suite: Multi-Room WebSocket Chat & Presence Cluster
// Verifies Domain Invariants, Boundary Calculations & Liveness
// ============================================================================

import { CreateChatMultiRoomClusterTaskRequest } from "../models/chat_multi_room_cluster_request.dto"
import { ChatMultiRoomClusterInMemoryRepository } from "../repositories/chat_multi_room_cluster_inmemory.repository"
import { ChatMultiRoomClusterCoreService } from "../services/chat_multi_room_cluster_core.service"
import { ChatMultiRoomClusterTelemetryService } from "../services/chat_multi_room_cluster_telemetry.service"

class ChatMultiRoomClusterUnitTestSuite {
    service: ChatMultiRoomClusterCoreService
    telemetry: ChatMultiRoomClusterTelemetryService

    init(service: ChatMultiRoomClusterCoreService, telemetry: ChatMultiRoomClusterTelemetryService) {
        this.service = service
        this.telemetry = telemetry
    }

    fn test_valid_task_execution() -> Bool {
        let req = CreateChatMultiRoomClusterTaskRequest {
            taskKey: "UNIT-TASK-101",
            targetEntityId: 10,
            workloadCapacity: 95,
            domainContext: "Media & Realtime",
        }
        let res = this.service.executeTask(req)
        return match res {
            Ok(rec) => rec.id == 10 && rec.capacityScore == 95,
            Err(e) => false,
        }
    }

    fn test_invalid_negative_target_rejected() -> Bool {
        let req = CreateChatMultiRoomClusterTaskRequest {
            taskKey: "INVALID-TASK",
            targetEntityId: -1,
            workloadCapacity: 50,
            domainContext: "Media & Realtime",
        }
        let res = this.service.executeTask(req)
        return match res {
            Ok(r) => false,
            Err(e) => e == "Target entity ID must be strictly positive",
        }
    }

    fn test_health_evaluation() -> Bool {
        let health = this.service.evaluateHealth(10)
        return health == "OPTIMUM_PERFORMANCE" || health == "MODERATE_NORMAL"
    }

    fn test_telemetry_ping() -> Bool {
        return this.telemetry.ping()
    }

    fn run() -> Unit {
        let t1 = this.test_valid_task_execution()
        let t2 = this.test_invalid_negative_target_rejected()
        let t3 = this.test_health_evaluation()
        let t4 = this.test_telemetry_ping()

        if t1 && t2 && t3 && t4 {
            print("  ✓ Multi-Room WebSocket Chat & Presence Cluster Unit Tests: 4/4 passed (Domain Invariants Verified)")
        } else {
            print("  ✗ Multi-Room WebSocket Chat & Presence Cluster Unit Tests: failed")
        }
    }
}

let repo = ChatMultiRoomClusterInMemoryRepository()
let service = ChatMultiRoomClusterCoreService(repo)
let telemetry = ChatMultiRoomClusterTelemetryService()
let suite = ChatMultiRoomClusterUnitTestSuite(service, telemetry)
suite.run()
