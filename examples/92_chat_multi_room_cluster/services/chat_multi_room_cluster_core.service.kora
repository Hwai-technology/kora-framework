// Example 92: Multi-Room WebSocket Chat & Presence Cluster
// Core Domain Service Implementation

import { ChatMultiRoomClusterPrimaryRecord } from "../entities/chat_multi_room_cluster_primary.entity"
import { CreateChatMultiRoomClusterTaskRequest } from "../models/chat_multi_room_cluster_request.dto"
import { ChatMultiRoomClusterRepository } from "../interfaces/chat_multi_room_cluster_repository.interface"
import { ChatMultiRoomClusterDomainContract } from "../interfaces/chat_multi_room_cluster_service.interface"

class ChatMultiRoomClusterCoreService implements ChatMultiRoomClusterDomainContract {
    repo: ChatMultiRoomClusterRepository

    init(repo: ChatMultiRoomClusterRepository) {
        this.repo = repo
    }

    fn executeTask(req: CreateChatMultiRoomClusterTaskRequest) -> Result<ChatMultiRoomClusterPrimaryRecord, String> {
        if req.targetEntityId <= 0 {
            return Err("Target entity ID must be strictly positive")
        }
        if req.workloadCapacity <= 0 {
            return Err("Workload capacity must be strictly positive")
        }

        let record = ChatMultiRoomClusterPrimaryRecord {
            id: req.targetEntityId,
            referenceCode: req.taskKey,
            capacityScore: req.workloadCapacity,
            operationalStatus: "COMMITTED_HEALTHY",
            active: true,
        }
        return this.repo.save(record)
    }

    fn evaluateHealth(entityId: Int) -> String {
        let opt = this.repo.findById(entityId)
        let isPresent = match opt {
            Some(r) => true,
            None => false,
        }
        if !isPresent {
            return "ENTITY_NOT_FOUND"
        }
        let record = match opt {
            Some(r) => r,
            None => ChatMultiRoomClusterPrimaryRecord { id: 0, referenceCode: "", capacityScore: 0, operationalStatus: "", active: false },
        }
        if record.capacityScore > 80 {
            return "OPTIMUM_PERFORMANCE"
        }
        if record.capacityScore > 40 {
            return "MODERATE_NORMAL"
        }
        return "LOW_CAPACITY"
    }
}
