// ============================================================================
// Unit Test Suite: Customer Loyalty Rewards Ledger & Tier Upgrades
// Verifies Domain Invariants, Boundary Calculations & Liveness
// ============================================================================

import { CreateCustomerLoyaltyRewardsTaskRequest } from "../models/customer_loyalty_rewards_request.dto"
import { CustomerLoyaltyRewardsInMemoryRepository } from "../repositories/customer_loyalty_rewards_inmemory.repository"
import { CustomerLoyaltyRewardsCoreService } from "../services/customer_loyalty_rewards_core.service"
import { CustomerLoyaltyRewardsTelemetryService } from "../services/customer_loyalty_rewards_telemetry.service"

class CustomerLoyaltyRewardsUnitTestSuite {
    service: CustomerLoyaltyRewardsCoreService
    telemetry: CustomerLoyaltyRewardsTelemetryService

    init(service: CustomerLoyaltyRewardsCoreService, telemetry: CustomerLoyaltyRewardsTelemetryService) {
        this.service = service
        this.telemetry = telemetry
    }

    fn test_valid_task_execution() -> Bool {
        let req = CreateCustomerLoyaltyRewardsTaskRequest {
            taskKey: "UNIT-TASK-101",
            targetEntityId: 10,
            workloadCapacity: 95,
            domainContext: "E-Commerce",
        }
        let res = this.service.executeTask(req)
        return match res {
            Ok(rec) => rec.id == 10 && rec.capacityScore == 95,
            Err(e) => false,
        }
    }

    fn test_invalid_negative_target_rejected() -> Bool {
        let req = CreateCustomerLoyaltyRewardsTaskRequest {
            taskKey: "INVALID-TASK",
            targetEntityId: -1,
            workloadCapacity: 50,
            domainContext: "E-Commerce",
        }
        let res = this.service.executeTask(req)
        return match res {
            Ok(r) => false,
            Err(e) => e == "Target entity ID must be strictly positive",
        }
    }

    fn test_health_evaluation() -> Bool {
        let health = this.service.evaluateHealth(10)
        return health == "OPTIMUM_PERFORMANCE" || health == "MODERATE_NORMAL"
    }

    fn test_telemetry_ping() -> Bool {
        return this.telemetry.ping()
    }

    fn run() -> Unit {
        let t1 = this.test_valid_task_execution()
        let t2 = this.test_invalid_negative_target_rejected()
        let t3 = this.test_health_evaluation()
        let t4 = this.test_telemetry_ping()

        if t1 && t2 && t3 && t4 {
            print("  ✓ Customer Loyalty Rewards Ledger & Tier Upgrades Unit Tests: 4/4 passed (Domain Invariants Verified)")
        } else {
            print("  ✗ Customer Loyalty Rewards Ledger & Tier Upgrades Unit Tests: failed")
        }
    }
}

let repo = CustomerLoyaltyRewardsInMemoryRepository()
let service = CustomerLoyaltyRewardsCoreService(repo)
let telemetry = CustomerLoyaltyRewardsTelemetryService()
let suite = CustomerLoyaltyRewardsUnitTestSuite(service, telemetry)
suite.run()
