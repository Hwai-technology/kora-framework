// Example 62: Customer Loyalty Rewards Ledger & Tier Upgrades
// Presentation Controller

import { CreateCustomerLoyaltyRewardsTaskRequest } from "../models/customer_loyalty_rewards_request.dto"
import { CustomerLoyaltyRewardsResponseDto } from "../models/customer_loyalty_rewards_response.dto"
import { CustomerLoyaltyRewardsCoreService } from "../services/customer_loyalty_rewards_core.service"

class CustomerLoyaltyRewardsController {
    service: CustomerLoyaltyRewardsCoreService

    init(service: CustomerLoyaltyRewardsCoreService) {
        this.service = service
    }

    fn handleTaskSubmission(req: CreateCustomerLoyaltyRewardsTaskRequest) -> CustomerLoyaltyRewardsResponseDto {
        let outcome = this.service.executeTask(req)
        return match outcome {
            Ok(rec) => CustomerLoyaltyRewardsResponseDto {
                operationId: "TX-" + req.taskKey,
                entityId: rec.id,
                status: "EXECUTION_SUCCESSFUL",
                isVerified: true,
                message: "Operation completed under Clean Architecture invariants",
            },
            Err(reason) => CustomerLoyaltyRewardsResponseDto {
                operationId: "TX-FAILED",
                entityId: req.targetEntityId,
                status: "EXECUTION_REJECTED",
                isVerified: false,
                message: reason,
            },
        }
    }

    fn inspectHealth(entityId: Int) -> String {
        return this.service.evaluateHealth(entityId)
    }
}
