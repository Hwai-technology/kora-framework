// Example 62: Customer Loyalty Rewards Ledger & Tier Upgrades
// Core Domain Service Implementation

import { CustomerLoyaltyRewardsPrimaryRecord } from "../entities/customer_loyalty_rewards_primary.entity"
import { CreateCustomerLoyaltyRewardsTaskRequest } from "../models/customer_loyalty_rewards_request.dto"
import { CustomerLoyaltyRewardsRepository } from "../interfaces/customer_loyalty_rewards_repository.interface"
import { CustomerLoyaltyRewardsDomainContract } from "../interfaces/customer_loyalty_rewards_service.interface"

class CustomerLoyaltyRewardsCoreService implements CustomerLoyaltyRewardsDomainContract {
    repo: CustomerLoyaltyRewardsRepository

    init(repo: CustomerLoyaltyRewardsRepository) {
        this.repo = repo
    }

    fn executeTask(req: CreateCustomerLoyaltyRewardsTaskRequest) -> Result<CustomerLoyaltyRewardsPrimaryRecord, String> {
        if req.targetEntityId <= 0 {
            return Err("Target entity ID must be strictly positive")
        }
        if req.workloadCapacity <= 0 {
            return Err("Workload capacity must be strictly positive")
        }

        let record = CustomerLoyaltyRewardsPrimaryRecord {
            id: req.targetEntityId,
            referenceCode: req.taskKey,
            capacityScore: req.workloadCapacity,
            operationalStatus: "COMMITTED_HEALTHY",
            active: true,
        }
        return this.repo.save(record)
    }

    fn evaluateHealth(entityId: Int) -> String {
        let opt = this.repo.findById(entityId)
        let isPresent = match opt {
            Some(r) => true,
            None => false,
        }
        if !isPresent {
            return "ENTITY_NOT_FOUND"
        }
        let record = match opt {
            Some(r) => r,
            None => CustomerLoyaltyRewardsPrimaryRecord { id: 0, referenceCode: "", capacityScore: 0, operationalStatus: "", active: false },
        }
        if record.capacityScore > 80 {
            return "OPTIMUM_PERFORMANCE"
        }
        if record.capacityScore > 40 {
            return "MODERATE_NORMAL"
        }
        return "LOW_CAPACITY"
    }
}
