// ============================================================================
// Unit Test Suite: Secret Management Vault & Dynamic Credentials
// Verifies Domain Invariants, Boundary Calculations & Liveness
// ============================================================================

import { CreateSecretManagementVaultTaskRequest } from "../models/secret_management_vault_request.dto"
import { SecretManagementVaultInMemoryRepository } from "../repositories/secret_management_vault_inmemory.repository"
import { SecretManagementVaultCoreService } from "../services/secret_management_vault_core.service"
import { SecretManagementVaultTelemetryService } from "../services/secret_management_vault_telemetry.service"

class SecretManagementVaultUnitTestSuite {
    service: SecretManagementVaultCoreService
    telemetry: SecretManagementVaultTelemetryService

    init(service: SecretManagementVaultCoreService, telemetry: SecretManagementVaultTelemetryService) {
        this.service = service
        this.telemetry = telemetry
    }

    fn test_valid_task_execution() -> Bool {
        let req = CreateSecretManagementVaultTaskRequest {
            taskKey: "UNIT-TASK-101",
            targetEntityId: 10,
            workloadCapacity: 95,
            domainContext: "Cybersecurity",
        }
        let res = this.service.executeTask(req)
        return match res {
            Ok(rec) => rec.id == 10 && rec.capacityScore == 95,
            Err(e) => false,
        }
    }

    fn test_invalid_negative_target_rejected() -> Bool {
        let req = CreateSecretManagementVaultTaskRequest {
            taskKey: "INVALID-TASK",
            targetEntityId: -1,
            workloadCapacity: 50,
            domainContext: "Cybersecurity",
        }
        let res = this.service.executeTask(req)
        return match res {
            Ok(r) => false,
            Err(e) => e == "Target entity ID must be strictly positive",
        }
    }

    fn test_health_evaluation() -> Bool {
        let health = this.service.evaluateHealth(10)
        return health == "OPTIMUM_PERFORMANCE" || health == "MODERATE_NORMAL"
    }

    fn test_telemetry_ping() -> Bool {
        return this.telemetry.ping()
    }

    fn run() -> Unit {
        let t1 = this.test_valid_task_execution()
        let t2 = this.test_invalid_negative_target_rejected()
        let t3 = this.test_health_evaluation()
        let t4 = this.test_telemetry_ping()

        if t1 && t2 && t3 && t4 {
            print("  ✓ Secret Management Vault & Dynamic Credentials Unit Tests: 4/4 passed (Domain Invariants Verified)")
        } else {
            print("  ✗ Secret Management Vault & Dynamic Credentials Unit Tests: failed")
        }
    }
}

let repo = SecretManagementVaultInMemoryRepository()
let service = SecretManagementVaultCoreService(repo)
let telemetry = SecretManagementVaultTelemetryService()
let suite = SecretManagementVaultUnitTestSuite(service, telemetry)
suite.run()
