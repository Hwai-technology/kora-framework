// Example 85: Secret Management Vault & Dynamic Credentials
// Router & Endpoint Dispatcher

import { CreateSecretManagementVaultTaskRequest } from "../models/secret_management_vault_request.dto"
import { SecretManagementVaultResponseDto } from "../models/secret_management_vault_response.dto"
import { SecretManagementVaultController } from "../controllers/secret_management_vault.controller"

class SecretManagementVaultRouter {
    controller: SecretManagementVaultController

    init(controller: SecretManagementVaultController) {
        this.controller = controller
    }

    fn postTask(req: CreateSecretManagementVaultTaskRequest) -> SecretManagementVaultResponseDto {
        return this.controller.handleTaskSubmission(req)
    }

    fn getHealth(entityId: Int) -> String {
        return this.controller.inspectHealth(entityId)
    }
}
