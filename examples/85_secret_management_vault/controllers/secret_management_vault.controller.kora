// Example 85: Secret Management Vault & Dynamic Credentials
// Presentation Controller

import { CreateSecretManagementVaultTaskRequest } from "../models/secret_management_vault_request.dto"
import { SecretManagementVaultResponseDto } from "../models/secret_management_vault_response.dto"
import { SecretManagementVaultCoreService } from "../services/secret_management_vault_core.service"

class SecretManagementVaultController {
    service: SecretManagementVaultCoreService

    init(service: SecretManagementVaultCoreService) {
        this.service = service
    }

    fn handleTaskSubmission(req: CreateSecretManagementVaultTaskRequest) -> SecretManagementVaultResponseDto {
        let outcome = this.service.executeTask(req)
        return match outcome {
            Ok(rec) => SecretManagementVaultResponseDto {
                operationId: "TX-" + req.taskKey,
                entityId: rec.id,
                status: "EXECUTION_SUCCESSFUL",
                isVerified: true,
                message: "Operation completed under Clean Architecture invariants",
            },
            Err(reason) => SecretManagementVaultResponseDto {
                operationId: "TX-FAILED",
                entityId: req.targetEntityId,
                status: "EXECUTION_REJECTED",
                isVerified: false,
                message: reason,
            },
        }
    }

    fn inspectHealth(entityId: Int) -> String {
        return this.service.evaluateHealth(entityId)
    }
}
