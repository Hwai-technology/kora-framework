// ============================================================================
// Unit Test Suite: Zero-Trust Context-Aware Policy Decision Point (PDP)
// Verifies Domain Invariants, Boundary Calculations & Liveness
// ============================================================================

import { CreateZeroTrustPolicyEnforcerTaskRequest } from "../models/zero_trust_policy_enforcer_request.dto"
import { ZeroTrustPolicyEnforcerInMemoryRepository } from "../repositories/zero_trust_policy_enforcer_inmemory.repository"
import { ZeroTrustPolicyEnforcerCoreService } from "../services/zero_trust_policy_enforcer_core.service"
import { ZeroTrustPolicyEnforcerTelemetryService } from "../services/zero_trust_policy_enforcer_telemetry.service"

class ZeroTrustPolicyEnforcerUnitTestSuite {
    service: ZeroTrustPolicyEnforcerCoreService
    telemetry: ZeroTrustPolicyEnforcerTelemetryService

    init(service: ZeroTrustPolicyEnforcerCoreService, telemetry: ZeroTrustPolicyEnforcerTelemetryService) {
        this.service = service
        this.telemetry = telemetry
    }

    fn test_valid_task_execution() -> Bool {
        let req = CreateZeroTrustPolicyEnforcerTaskRequest {
            taskKey: "UNIT-TASK-101",
            targetEntityId: 10,
            workloadCapacity: 95,
            domainContext: "Cybersecurity",
        }
        let res = this.service.executeTask(req)
        return match res {
            Ok(rec) => rec.id == 10 && rec.capacityScore == 95,
            Err(e) => false,
        }
    }

    fn test_invalid_negative_target_rejected() -> Bool {
        let req = CreateZeroTrustPolicyEnforcerTaskRequest {
            taskKey: "INVALID-TASK",
            targetEntityId: -1,
            workloadCapacity: 50,
            domainContext: "Cybersecurity",
        }
        let res = this.service.executeTask(req)
        return match res {
            Ok(r) => false,
            Err(e) => e == "Target entity ID must be strictly positive",
        }
    }

    fn test_health_evaluation() -> Bool {
        let health = this.service.evaluateHealth(10)
        return health == "OPTIMUM_PERFORMANCE" || health == "MODERATE_NORMAL"
    }

    fn test_telemetry_ping() -> Bool {
        return this.telemetry.ping()
    }

    fn run() -> Unit {
        let t1 = this.test_valid_task_execution()
        let t2 = this.test_invalid_negative_target_rejected()
        let t3 = this.test_health_evaluation()
        let t4 = this.test_telemetry_ping()

        if t1 && t2 && t3 && t4 {
            print("  ✓ Zero-Trust Context-Aware Policy Decision Point (PDP) Unit Tests: 4/4 passed (Domain Invariants Verified)")
        } else {
            print("  ✗ Zero-Trust Context-Aware Policy Decision Point (PDP) Unit Tests: failed")
        }
    }
}

let repo = ZeroTrustPolicyEnforcerInMemoryRepository()
let service = ZeroTrustPolicyEnforcerCoreService(repo)
let telemetry = ZeroTrustPolicyEnforcerTelemetryService()
let suite = ZeroTrustPolicyEnforcerUnitTestSuite(service, telemetry)
suite.run()
