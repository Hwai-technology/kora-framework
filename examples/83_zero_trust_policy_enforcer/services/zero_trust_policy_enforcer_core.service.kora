// Example 83: Zero-Trust Context-Aware Policy Decision Point (PDP)
// Core Domain Service Implementation

import { ZeroTrustPolicyEnforcerPrimaryRecord } from "../entities/zero_trust_policy_enforcer_primary.entity"
import { CreateZeroTrustPolicyEnforcerTaskRequest } from "../models/zero_trust_policy_enforcer_request.dto"
import { ZeroTrustPolicyEnforcerRepository } from "../interfaces/zero_trust_policy_enforcer_repository.interface"
import { ZeroTrustPolicyEnforcerDomainContract } from "../interfaces/zero_trust_policy_enforcer_service.interface"

class ZeroTrustPolicyEnforcerCoreService implements ZeroTrustPolicyEnforcerDomainContract {
    repo: ZeroTrustPolicyEnforcerRepository

    init(repo: ZeroTrustPolicyEnforcerRepository) {
        this.repo = repo
    }

    fn executeTask(req: CreateZeroTrustPolicyEnforcerTaskRequest) -> Result<ZeroTrustPolicyEnforcerPrimaryRecord, String> {
        if req.targetEntityId <= 0 {
            return Err("Target entity ID must be strictly positive")
        }
        if req.workloadCapacity <= 0 {
            return Err("Workload capacity must be strictly positive")
        }

        let record = ZeroTrustPolicyEnforcerPrimaryRecord {
            id: req.targetEntityId,
            referenceCode: req.taskKey,
            capacityScore: req.workloadCapacity,
            operationalStatus: "COMMITTED_HEALTHY",
            active: true,
        }
        return this.repo.save(record)
    }

    fn evaluateHealth(entityId: Int) -> String {
        let opt = this.repo.findById(entityId)
        let isPresent = match opt {
            Some(r) => true,
            None => false,
        }
        if !isPresent {
            return "ENTITY_NOT_FOUND"
        }
        let record = match opt {
            Some(r) => r,
            None => ZeroTrustPolicyEnforcerPrimaryRecord { id: 0, referenceCode: "", capacityScore: 0, operationalStatus: "", active: false },
        }
        if record.capacityScore > 80 {
            return "OPTIMUM_PERFORMANCE"
        }
        if record.capacityScore > 40 {
            return "MODERATE_NORMAL"
        }
        return "LOW_CAPACITY"
    }
}
