// Example 35: FHIR R4 & HL7 Interoperability Hub
// Transport Model: Standard Responses

model FhirInteroperabilityHubResponseDto {
    recordId: Int
    patientId: Int
    status: String
    isComplianceVerified: Bool
    message: String
}

model FhirInteroperabilityHubSummaryDto {
    patientId: Int
    totalEntries: Int
    severityCategory: String
    lastReviewedTimestamp: Int
}
