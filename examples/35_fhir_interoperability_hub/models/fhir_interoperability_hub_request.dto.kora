// Example 35: FHIR R4 & HL7 Interoperability Hub
// Transport Model: Command Requests

model CreateFhirInteroperabilityHubRecordRequest {
    patientId: Int
    clinicianId: Int
    domainContext: String
    clinicalMetricScore: Int
    confidentialNotes: String
}

model QueryFhirInteroperabilityHubFilterRequest {
    patientId: Int
    limit: Int
    includeHistorical: Bool
}
