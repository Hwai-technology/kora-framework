// Example 35: FHIR R4 & HL7 Interoperability Hub
// Core Domain Service Implementation

import { FhirInteroperabilityHubClinicalEntity } from "../entities/fhir_interoperability_hub_primary.entity"
import { CreateFhirInteroperabilityHubRecordRequest } from "../models/fhir_interoperability_hub_request.dto"
import { FhirInteroperabilityHubRepository } from "../interfaces/fhir_interoperability_hub_repository.interface"
import { FhirInteroperabilityHubDomainContract } from "../interfaces/fhir_interoperability_hub_service.interface"

class FhirInteroperabilityHubCoreService implements FhirInteroperabilityHubDomainContract {
    repo: FhirInteroperabilityHubRepository

    init(repo: FhirInteroperabilityHubRepository) {
        this.repo = repo
    }

    fn processClinicalRecord(req: CreateFhirInteroperabilityHubRecordRequest) -> Result<FhirInteroperabilityHubClinicalEntity, String> {
        if req.patientId <= 0 {
            return Err("Patient ID must be strictly positive")
        }
        if req.clinicalMetricScore < 0 {
            return Err("Clinical metric score cannot be negative")
        }

        let entity = FhirInteroperabilityHubClinicalEntity {
            id: req.patientId + 5000,
            patientId: req.patientId,
            clinicianId: req.clinicianId,
            clinicalMetricScore: req.clinicalMetricScore,
            complianceState: "AUDITED_SECURE",
            active: true,
        }
        return this.repo.save(entity)
    }

    fn evaluateClinicalRisk(patientId: Int) -> String {
        let opt = this.repo.findByPatientId(patientId)
        let isPresent = match opt {
            Some(r) => true,
            None => false,
        }
        if !isPresent {
            return "RECORD_NOT_FOUND"
        }
        let record = match opt {
            Some(r) => r,
            None => FhirInteroperabilityHubClinicalEntity { id: 0, patientId: 0, clinicianId: 0, clinicalMetricScore: 0, complianceState: "", active: false },
        }
        if record.clinicalMetricScore > 80 {
            return "CRITICAL_OBSERVATION"
        }
        if record.clinicalMetricScore > 40 {
            return "MODERATE_ATTENTION"
        }
        return "NOMINAL_STABLE"
    }
}
