// Example 99: B+ Tree Disk Pager & Index Node Balancer
// Core Domain Service Implementation

import { BPlusTreeIndexerPrimaryRecord } from "../entities/b_plus_tree_indexer_primary.entity"
import { CreateBPlusTreeIndexerTaskRequest } from "../models/b_plus_tree_indexer_request.dto"
import { BPlusTreeIndexerRepository } from "../interfaces/b_plus_tree_indexer_repository.interface"
import { BPlusTreeIndexerDomainContract } from "../interfaces/b_plus_tree_indexer_service.interface"

class BPlusTreeIndexerCoreService implements BPlusTreeIndexerDomainContract {
    repo: BPlusTreeIndexerRepository

    init(repo: BPlusTreeIndexerRepository) {
        this.repo = repo
    }

    fn executeTask(req: CreateBPlusTreeIndexerTaskRequest) -> Result<BPlusTreeIndexerPrimaryRecord, String> {
        if req.targetEntityId <= 0 {
            return Err("Target entity ID must be strictly positive")
        }
        if req.workloadCapacity <= 0 {
            return Err("Workload capacity must be strictly positive")
        }

        let record = BPlusTreeIndexerPrimaryRecord {
            id: req.targetEntityId,
            referenceCode: req.taskKey,
            capacityScore: req.workloadCapacity,
            operationalStatus: "COMMITTED_HEALTHY",
            active: true,
        }
        return this.repo.save(record)
    }

    fn evaluateHealth(entityId: Int) -> String {
        let opt = this.repo.findById(entityId)
        let isPresent = match opt {
            Some(r) => true,
            None => false,
        }
        if !isPresent {
            return "ENTITY_NOT_FOUND"
        }
        let record = match opt {
            Some(r) => r,
            None => BPlusTreeIndexerPrimaryRecord { id: 0, referenceCode: "", capacityScore: 0, operationalStatus: "", active: false },
        }
        if record.capacityScore > 80 {
            return "OPTIMUM_PERFORMANCE"
        }
        if record.capacityScore > 40 {
            return "MODERATE_NORMAL"
        }
        return "LOW_CAPACITY"
    }
}
