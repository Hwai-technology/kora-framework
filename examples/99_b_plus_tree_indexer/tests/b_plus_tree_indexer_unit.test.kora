// ============================================================================
// Unit Test Suite: B+ Tree Disk Pager & Index Node Balancer
// Verifies Domain Invariants, Boundary Calculations & Liveness
// ============================================================================

import { CreateBPlusTreeIndexerTaskRequest } from "../models/b_plus_tree_indexer_request.dto"
import { BPlusTreeIndexerInMemoryRepository } from "../repositories/b_plus_tree_indexer_inmemory.repository"
import { BPlusTreeIndexerCoreService } from "../services/b_plus_tree_indexer_core.service"
import { BPlusTreeIndexerTelemetryService } from "../services/b_plus_tree_indexer_telemetry.service"

class BPlusTreeIndexerUnitTestSuite {
    service: BPlusTreeIndexerCoreService
    telemetry: BPlusTreeIndexerTelemetryService

    init(service: BPlusTreeIndexerCoreService, telemetry: BPlusTreeIndexerTelemetryService) {
        this.service = service
        this.telemetry = telemetry
    }

    fn test_valid_task_execution() -> Bool {
        let req = CreateBPlusTreeIndexerTaskRequest {
            taskKey: "UNIT-TASK-101",
            targetEntityId: 10,
            workloadCapacity: 95,
            domainContext: "Algorithms & Kernels",
        }
        let res = this.service.executeTask(req)
        return match res {
            Ok(rec) => rec.id == 10 && rec.capacityScore == 95,
            Err(e) => false,
        }
    }

    fn test_invalid_negative_target_rejected() -> Bool {
        let req = CreateBPlusTreeIndexerTaskRequest {
            taskKey: "INVALID-TASK",
            targetEntityId: -1,
            workloadCapacity: 50,
            domainContext: "Algorithms & Kernels",
        }
        let res = this.service.executeTask(req)
        return match res {
            Ok(r) => false,
            Err(e) => e == "Target entity ID must be strictly positive",
        }
    }

    fn test_health_evaluation() -> Bool {
        let health = this.service.evaluateHealth(10)
        return health == "OPTIMUM_PERFORMANCE" || health == "MODERATE_NORMAL"
    }

    fn test_telemetry_ping() -> Bool {
        return this.telemetry.ping()
    }

    fn run() -> Unit {
        let t1 = this.test_valid_task_execution()
        let t2 = this.test_invalid_negative_target_rejected()
        let t3 = this.test_health_evaluation()
        let t4 = this.test_telemetry_ping()

        if t1 && t2 && t3 && t4 {
            print("  ✓ B+ Tree Disk Pager & Index Node Balancer Unit Tests: 4/4 passed (Domain Invariants Verified)")
        } else {
            print("  ✗ B+ Tree Disk Pager & Index Node Balancer Unit Tests: failed")
        }
    }
}

let repo = BPlusTreeIndexerInMemoryRepository()
let service = BPlusTreeIndexerCoreService(repo)
let telemetry = BPlusTreeIndexerTelemetryService()
let suite = BPlusTreeIndexerUnitTestSuite(service, telemetry)
suite.run()
