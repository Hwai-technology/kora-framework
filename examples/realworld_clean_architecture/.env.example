# ==============================================================================
# Kora Clean Architecture E-Commerce Environment Configuration
# ==============================================================================

# Application Server
KORA_ENV=production
KORA_PORT=8080
KORA_HOST=0.0.0.0
KORA_WORKERS=8

# MySQL Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=kora_shop
DB_USER=root
DB_PASSWORD=kora_root_password
DATABASE_URL=mysql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}
DB_POOL_SIZE=50

# Redis Cache & Queue
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}/0

# Security & Middleware
JWT_SECRET=super_secret_kora_production_key_change_in_prod_998877
RATE_LIMIT_RPM=120
CORS_ORIGIN=*
COMPRESSION_ENABLED=true

