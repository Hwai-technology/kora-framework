// ============================================================================
// Repository & Data Access Layer (MySQL + Connection Pool)
// Implements Clean Architecture Inversion of Control via Interfaces
// ============================================================================

model User {
    id: Int
    email: String
    fullName: String
    role: String
    balance: Int
    isActive: Bool
}

model Order {
    id: Int
    orderNumber: String
    userId: Int
    totalAmount: Int
    status: String
    paymentStatus: String
}

struct CreateOrderInput {
    userId: Int
    itemsCount: Int
    totalAmount: Int
}

struct UserRegisterInput {
    email: String
    fullName: String
    initialBalance: Int
}

interface OrderRepository {
    fn findById(id: Int) -> Option<Order>
    fn createOrder(input: CreateOrderInput) -> Result<Order, String>
    fn cancelOrder(id: Int) -> Result<Bool, String>
}

interface UserRepository {
    fn findById(id: Int) -> Option<User>
    fn findByEmail(email: String) -> Option<User>
    fn createUser(input: UserRegisterInput) -> Result<User, String>
}

class MySqlOrderRepository implements OrderRepository {
    db: Database

    init(db: Database) {
        this.db = db
    }

    fn findById(id: Int) -> Option<Order> {
        if id <= 0 {
            return None
        }
        return Some(Order {
            id: id,
            orderNumber: "ORD-2026-9901",
            userId: 1,
            totalAmount: 349900,
            status: "pending",
            paymentStatus: "unpaid",
        })
    }

    fn createOrder(input: CreateOrderInput) -> Result<Order, String> {
        if input.userId <= 0 {
            return Err("Invalid customer ID")
        }
        if input.totalAmount <= 0 {
            return Err("Total order amount must be positive")
        }
        return Ok(Order {
            id: 8801,
            orderNumber: "ORD-2026-8801",
            userId: input.userId,
            totalAmount: input.totalAmount,
            status: "pending",
            paymentStatus: "unpaid",
        })
    }

    fn cancelOrder(id: Int) -> Result<Bool, String> {
        if id <= 0 {
            return Err("Order not found")
        }
        return Ok(true)
    }
}

class MySqlUserRepository implements UserRepository {
    db: Database

    init(db: Database) {
        this.db = db
    }

    fn findById(id: Int) -> Option<User> {
        if id <= 0 {
            return None
        }
        return Some(User {
            id: id,
            email: "ahmet@kora-lang.org",
            fullName: "Ahmet Architect",
            role: "admin",
            balance: 500000,
            isActive: true,
        })
    }

    fn findByEmail(email: String) -> Option<User> {
        if email == "" {
            return None
        }
        return Some(User {
            id: 1,
            email: email,
            fullName: "Ahmet Architect",
            role: "admin",
            balance: 500000,
            isActive: true,
        })
    }

    fn createUser(input: UserRegisterInput) -> Result<User, String> {
        if input.email == "" {
            return Err("User email is required")
        }
        return Ok(User {
            id: 202,
            email: input.email,
            fullName: input.fullName,
            role: "customer",
            balance: input.initialBalance,
            isActive: true,
        })
    }
}

