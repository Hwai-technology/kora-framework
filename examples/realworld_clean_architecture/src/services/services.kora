// ============================================================================
// Service Layer: Application & Business Logic with Lifecycle Destructors
// Emits Domain Events & Orchestrates Calculations and Data Stores
// ============================================================================

model User {
    id: Int
    email: String
    fullName: String
    role: String
    balance: Int
    isActive: Bool
}

model Order {
    id: Int
    orderNumber: String
    userId: Int
    totalAmount: Int
    status: String
    paymentStatus: String
}

struct CreateOrderInput {
    userId: Int
    itemsCount: Int
    totalAmount: Int
}

struct DomainEvent {
    eventId: String
    eventType: String
    aggregateId: Int
    payloadSummary: String
    emittedAt: Int
}

class MySqlOrderRepository {
    fn findById(id: Int) -> Option<Order> {
        if id <= 0 {
            return None
        }
        return Some(Order {
            id: id,
            orderNumber: "ORD-2026-9901",
            userId: 1,
            totalAmount: 349900,
            status: "pending",
            paymentStatus: "unpaid",
        })
    }

    fn createOrder(input: CreateOrderInput) -> Result<Order, String> {
        return Ok(Order {
            id: 8801,
            orderNumber: "ORD-2026-8801",
            userId: input.userId,
            totalAmount: input.totalAmount,
            status: "paid",
            paymentStatus: "captured",
        })
    }

    fn cancelOrder(id: Int) -> Result<Bool, String> {
        if id <= 0 {
            return Err("Order does not exist")
        }
        return Ok(true)
    }

    fn destroy() -> Bool {
        return true
    }
}

class MySqlUserRepository {
    fn findById(id: Int) -> Option<User> {
        if id <= 0 {
            return None
        }
        return Some(User {
            id: id,
            email: "customer@example.com",
            fullName: "Sarah Connor",
            role: "customer",
            balance: 500000,
            isActive: true,
        })
    }

    fn destroy() -> Bool {
        return true
    }
}

class DomainEventEmitter {
    fn publish(eventType: String, aggregateId: Int, summary: String) -> Result<DomainEvent, String> {
        return Ok(DomainEvent {
            eventId: "EVT-2026-9001",
            eventType: eventType,
            aggregateId: aggregateId,
            payloadSummary: summary,
            emittedAt: 1773000000,
        })
    }

    fn destroy() -> Bool {
        return true
    }
}

class CheckoutService {
    orderRepo: MySqlOrderRepository
    userRepo: MySqlUserRepository
    events: DomainEventEmitter

    init(orderRepo: MySqlOrderRepository, userRepo: MySqlUserRepository, events: DomainEventEmitter) {
        this.orderRepo = orderRepo
        this.userRepo = userRepo
        this.events = events
    }

    fn processCheckout(userId: Int, itemsCount: Int, amount: Int) -> Result<Order, String> {
        if userId <= 0 {
            return Err("Invalid customer ID")
        }
        if itemsCount <= 0 {
            return Err("Cart must contain at least one product")
        }
        if amount <= 0 {
            return Err("Invalid checkout amount")
        }

        // Apply discount for bulk orders
        if itemsCount >= 5 {
            let discountedAmount = (amount * 85) / 100
            let bulkInput = CreateOrderInput {
                userId: userId,
                itemsCount: itemsCount,
                totalAmount: discountedAmount,
            }
            let bulkOrder = this.orderRepo.createOrder(bulkInput)
            let evt1 = this.events.publish("OrderPlacedEvent", 8801, "Bulk order placed")
            return bulkOrder
        }

        let regularInput = CreateOrderInput {
            userId: userId,
            itemsCount: itemsCount,
            totalAmount: amount,
        }
        let regularOrder = this.orderRepo.createOrder(regularInput)
        let evt2 = this.events.publish("OrderPlacedEvent", 8801, "Regular order placed")
        return regularOrder
    }

    fn getOrder(orderId: Int) -> Option<Order> {
        return this.orderRepo.findById(orderId)
    }

    fn cancelOrder(orderId: Int) -> Result<Bool, String> {
        return this.orderRepo.cancelOrder(orderId)
    }

    fn destroy() -> Bool {
        let d1 = this.orderRepo.destroy()
        let d2 = this.userRepo.destroy()
        let d3 = this.events.destroy()
        return true
    }
}
