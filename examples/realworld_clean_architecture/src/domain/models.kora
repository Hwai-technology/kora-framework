// ============================================================================
// Domain Layer: Models, Enums, DTOs & Interfaces
// Clean Architecture Core (Pure Domain Rules - Zero External Dependencies)
// ============================================================================

enum UserRole {
    Customer,
    Admin,
    Moderator
}

enum OrderStatus {
    Pending,
    Paid,
    Shipped,
    Delivered,
    Cancelled
}

enum PaymentStatus {
    Unpaid,
    Authorized,
    Captured,
    Refunded
}

model User {
    id: Int
    email: String
    fullName: String
    role: String
    balance: Int
    isActive: Bool
}

model Product {
    id: Int
    sku: String
    title: String
    priceCents: Int
    stockQuantity: Int
    isPublished: Bool
}

model OrderItem {
    id: Int
    orderId: Int
    productId: Int
    quantity: Int
    unitPrice: Int
    subtotal: Int
}

model Order {
    id: Int
    orderNumber: String
    userId: Int
    totalAmount: Int
    status: String
    paymentStatus: String
}

struct OrderItemInput {
    productId: Int
    quantity: Int
    unitPrice: Int
}

struct CreateOrderInput {
    userId: Int
    itemsCount: Int
    totalAmount: Int
}

struct UserRegisterInput {
    email: String
    fullName: String
    initialBalance: Int
}

struct ApiResponse {
    success: Bool
    statusCode: Int
    message: String
    dataCount: Int
}

interface IOrderRepository {
    fn findById(id: Int) -> Option<Order>
    fn createOrder(input: CreateOrderInput) -> Result<Order, String>
    fn cancelOrder(id: Int) -> Result<Bool, String>
}

interface IUserRepository {
    fn findById(id: Int) -> Option<User>
    fn findByEmail(email: String) -> Option<User>
    fn createUser(input: UserRegisterInput) -> Result<User, String>
}

