// ============================================================================
// Domain Layer: Models, Enums, Value Objects & Secure Envelopes
// Zero-Cost Domain Invariants & Type-Safe Schema Definitions
// ============================================================================

enum UserRole {
    Customer,
    Admin,
    Moderator
}

enum OrderStatus {
    Pending,
    Paid,
    Shipped,
    Delivered,
    Cancelled
}

enum PaymentStatus {
    Unpaid,
    Authorized,
    Captured,
    Refunded
}

enum ExitCodeStatus {
    Success,
    HandledError,
    PanicRecovered
}

model User {
    id: Int
    email: String
    fullName: String
    role: String
    balance: Int
    isActive: Bool
}

model Product {
    id: Int
    sku: String
    title: String
    priceCents: Int
    stockQuantity: Int
    isPublished: Bool
}

model OrderItem {
    id: Int
    orderId: Int
    productId: Int
    quantity: Int
    unitPrice: Int
    subtotal: Int
}

model Order {
    id: Int
    orderNumber: String
    userId: Int
    totalAmount: Int
    status: String
    paymentStatus: String
}

struct PaginationMeta {
    currentPage: Int
    perPage: Int
    totalItems: Int
    totalPages: Int
}

struct SecureApiResponse {
    success: Bool
    statusCode: Int
    nonce: String
    securityToken: String
    message: String
    executionTimeMs: Int
    dataCount: Int
}

struct TelemetryTrace {
    traceId: String
    methodName: String
    clientIp: String
    durationMs: Int
    exitCode: Int
    status: String
}

struct DomainEvent {
    eventId: String
    eventType: String
    aggregateId: Int
    payloadSummary: String
    emittedAt: Int
}

struct CreateOrderInput {
    userId: Int
    itemsCount: Int
    totalAmount: Int
}

struct UserRegisterInput {
    email: String
    fullName: String
    initialBalance: Int
}

interface IOrderRepository {
    fn findById(id: Int) -> Option<Order>
    fn createOrder(input: CreateOrderInput) -> Result<Order, String>
    fn cancelOrder(id: Int) -> Result<Bool, String>
}

interface IUserRepository {
    fn findById(id: Int) -> Option<User>
    fn findByEmail(email: String) -> Option<User>
    fn createUser(input: UserRegisterInput) -> Result<User, String>
}
