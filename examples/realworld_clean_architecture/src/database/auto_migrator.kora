// ============================================================================
// Automatic Schema Reflection Migrator & Database Seeder
// Executes real DDL migrations and seed insertions via AmbientDatabasePool
// ============================================================================

import { AmbientDatabasePool } from "database/database_pool";

class AutoMigrator {
    pool: AmbientDatabasePool

    init(pool: AmbientDatabasePool) {
        this.pool = pool
    }

    fn runAllMigrations() -> Result<Int, String> {
        let connAcquired = this.pool.acquireConnection()
        if !connAcquired {
            return Err("Unable to acquire connection for schema migrations")
        }

        let q1 = this.pool.executeQuery("CREATE TABLE IF NOT EXISTS users (id INT PRIMARY KEY AUTO_INCREMENT, email VARCHAR(255) UNIQUE NOT NULL, full_name VARCHAR(255) NOT NULL, role VARCHAR(50) DEFAULT 'customer', balance INT DEFAULT 0, is_active BOOLEAN DEFAULT TRUE)")
        let q2 = this.pool.executeQuery("CREATE TABLE IF NOT EXISTS orders (id INT PRIMARY KEY AUTO_INCREMENT, order_number VARCHAR(100) UNIQUE NOT NULL, user_id INT NOT NULL, total_amount INT NOT NULL, status VARCHAR(50) NOT NULL, payment_status VARCHAR(50) NOT NULL)")

        let connReleased = this.pool.releaseConnection()

        return match q1 {
            Ok(c1) => match q2 {
                Ok(c2) => Ok(c1 + c2 + 2),
                Err(e2) => Err("Orders table migration failed: " + e2),
            },
            Err(e1) => Err("Users table migration failed: " + e1),
        }
    }

    fn destroy() -> Bool {
        return this.pool.destroy()
    }
}

class DatabaseSeeder {
    pool: AmbientDatabasePool

    init(pool: AmbientDatabasePool) {
        this.pool = pool
    }

    fn seedInitialData() -> Result<Int, String> {
        let connAcquired = this.pool.acquireConnection()
        if !connAcquired {
            return Err("Unable to acquire connection for initial seeding")
        }

        let seedAdmin = this.pool.executeQuery("INSERT IGNORE INTO users (email, full_name, role, balance, is_active) VALUES ('admin@kora-lang.org', 'Admin Architect', 'admin', 1000000, 1)")
        let seedCatalog = this.pool.executeQuery("INSERT IGNORE INTO products (name, sku, price_cents, stock_quantity) VALUES ('Enterprise Cluster Node', 'SKU-NODE-01', 499900, 50)")

        let connReleased = this.pool.releaseConnection()

        return match seedAdmin {
            Ok(c1) => match seedCatalog {
                Ok(c2) => Ok(c1 + c2 + 2),
                Err(e2) => Err("Product seeding failed: " + e2),
            },
            Err(e1) => Err("Admin user seeding failed: " + e1),
        }
    }

    fn destroy() -> Bool {
        return this.pool.destroy()
    }
}

