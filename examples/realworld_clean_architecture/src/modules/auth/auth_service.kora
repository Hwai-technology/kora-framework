// ============================================================================
// Auth Module: Business Logic Service
// Injects AuthRepository, AuthCache, JwtService & Logger via Compile-Time DI
// ============================================================================

import { User } from "models/user_model";
import { AuthSessionDto } from "modules/auth/auth_types";
import { AuthRepository } from "modules/auth/auth_repository";
import { AuthCache } from "modules/auth/auth_cache";
import { JwtService } from "shared/services/jwt_service";
import { Logger } from "shared/services/logger_service";

class AuthService {
    repo: AuthRepository
    cache: AuthCache
    jwt: JwtService
    logger: Logger

    init(
        repo: AuthRepository,
        cache: AuthCache,
        jwt: JwtService,
        logger: Logger,
    ) {
        this.repo = repo
        this.cache = cache
        this.jwt = jwt
        this.logger = logger
    }

    fn login(email: String, passwordPlain: String) -> Result<AuthSessionDto, String> {
        if email == "" {
            return Err("Email address is required")
        }
        if passwordPlain == "" {
            return Err("Password cannot be empty")
        }

        let userOpt = this.repo.findByEmail(email)
        if userOpt == null {
            let l = this.logger.warn("AuthService", "User lookup returned null for email: " + email, "trace_login_01")
            return Err("Invalid credentials")
        }

        return match userOpt {
            Some(u) => {
                let token = this.jwt.signAccessToken(u.id, u.role)
                let refreshToken = this.jwt.signRefreshToken(u.id)
                let cached = this.cache.storeSession(token, u.id)
                let l = this.logger.info("AuthService", "User authenticated successfully", "trace_login_02")

                return Ok(AuthSessionDto {
                    userId: u.id,
                    accessToken: token,
                    refreshToken: refreshToken,
                    expiresInSeconds: 86400,
                })
            },
            null => {
                let l = this.logger.warn("AuthService", "Invalid login credentials", "trace_login_03")
                return Err("Invalid credentials")
            },
        }
    }

    fn register(email: String, fullName: String) -> Result<User, String> {
        let l = this.logger.info("AuthService", "Registering account for email: " + email, "trace_reg_01")
        return this.repo.createAccount(email, fullName)
    }

    fn destroy() -> Bool {
        let d1 = this.repo.destroy()
        let d2 = this.cache.destroy()
        let d3 = this.jwt.destroy()
        let d4 = this.logger.destroy()
        return true
    }
}
