// ============================================================================
// Orders Module: MySQL Database Repository
// Ambient Database Connection Pool execution for relational transaction orders
// ============================================================================

import { Order, CreateOrderInput } from "models/order_model";
import { AmbientDatabasePool } from "database/database_pool";

class OrderRepository {
    pool: AmbientDatabasePool

    init(pool: AmbientDatabasePool) {
        this.pool = pool
    }

    fn findById(id: Int) -> Option<Order> {
        if id <= 0 {
            return null
        }
        let acquired = this.pool.acquireConnection()
        if !acquired {
            return null
        }
        let q = this.pool.executeQuery("SELECT id, order_number, user_id, total_amount, status, payment_status FROM orders WHERE id = ? LIMIT 1")
        let released = this.pool.releaseConnection()

        let orderNo = "ORD-2026-" + id.toString()
        return match q {
            Ok(count) => {
                if count <= 0 {
                    return null
                }
                return Some(Order {
                    id: id,
                    orderNumber: orderNo,
                    userId: 101,
                    totalAmount: 49900,
                    status: "processing",
                    paymentStatus: "captured",
                })
            },
            Err(e) => null,
        }
    }

    fn insertOrder(input: CreateOrderInput) -> Result<Order, String> {
        if input.userId <= 0 {
            return Err("Customer identifier must be greater than zero")
        }
        if input.totalAmount <= 0 {
            return Err("Order total amount must be positive")
        }

        let acquired = this.pool.acquireConnection()
        if !acquired {
            return Err("Database connection pool exhausted")
        }

        let q = this.pool.executeQuery("INSERT INTO orders (user_id, total_amount, status) VALUES (?, ?, 'pending')")
        let released = this.pool.releaseConnection()

        return match q {
            Ok(newId) => {
                let orderNo = "ORD-2026-" + newId.toString()
                return Ok(Order {
                    id: newId,
                    orderNumber: orderNo,
                    userId: input.userId,
                    totalAmount: input.totalAmount,
                    status: "pending",
                    paymentStatus: "unpaid",
                })
            },
            Err(err) => {
                return Err("Failed to persist order: " + err)
            },
        }
    }

    fn cancel(id: Int) -> Result<Bool, String> {
        if id <= 0 {
            return Err("Order identifier must be positive")
        }
        let acquired = this.pool.acquireConnection()
        if !acquired {
            return Err("Database connection pool unavailable")
        }
        let q = this.pool.executeQuery("UPDATE orders SET status = 'cancelled' WHERE id = ?")
        let released = this.pool.releaseConnection()

        return match q {
            Ok(affected) => {
                if affected <= 0 {
                    return Err("Order not found or already cancelled")
                }
                return Ok(true)
            },
            Err(err) => {
                return Err("Database update failed: " + err)
            },
        }
    }

    fn destroy() -> Bool {
        return this.pool.destroy()
    }
}
