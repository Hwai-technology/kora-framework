// ============================================================================
// Product Domain Model & Inventory Data
// ============================================================================

@entity
@table("products")
model Product {
    @primary
    @autoIncrement
    id: Int
    sku: String
    title: String
    priceCents: Int
    stockQuantity: Int
    isPublished: Bool
}

model ProductDto {
    id: Int
    sku: String
    title: String
    priceCents: Int
}

