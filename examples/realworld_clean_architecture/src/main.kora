// ============================================================================
// Kora Modular Clean Architecture Enterprise Showcase — Main Entrypoint
// Pure Architectural Discipline: Imports models & enums from dedicated modules
// Everything is Class-Based Architecture with Compile-Time Dependency Injection
// ============================================================================

import { HttpStatus } from "enums/http_status";
import { User, UserProfileDto } from "models/user_model";
import { Order, OrderItem, CreateOrderInput } from "models/order_model";
import { SecureApiResponse, LogEntry } from "models/response_envelope";
import { AuthSessionDto } from "modules/auth/auth_types";
import { Logger } from "shared/services/logger_service";
import { AutoMigrator, DatabaseSeeder } from "database/auto_migrator";
import { ApiResponse } from "middleware/api_response_factory";
import { AuthController } from "modules/auth/auth_controller";
import { OrderController } from "modules/orders/order_controller";

// ============================================================================
// Enterprise Application Container (Class-based Lifecycle & Orchestration)
// ============================================================================

class Application {
    migrator: AutoMigrator
    seeder: DatabaseSeeder
    auth: AuthController
    orders: OrderController
    response: ApiResponse
    logger: Logger

    init(
        migrator: AutoMigrator,
        seeder: DatabaseSeeder,
        auth: AuthController,
        orders: OrderController,
        response: ApiResponse,
        logger: Logger,
    ) {
        this.migrator = migrator
        this.seeder = seeder
        this.auth = auth
        this.orders = orders
        this.response = response
        this.logger = logger
    }

    fn health() -> SecureApiResponse {
        let l = this.logger.info("server", "Health check probe OK", "trace_health_01")
        return this.response.ok("Kora Clean Architecture Enterprise Engine is running healthy", 1)
    }

    fn migrateDatabase() -> SecureApiResponse {
        let mig = this.migrator.runAllMigrations()
        let seed = this.seeder.seedInitialData()
        let l = this.logger.info("db", "Migration and seeding completed", "trace_mig_01")
        return this.response.ok("Auto-migration and database seeding completed successfully", 6)
    }

    fn destroy() -> Bool {
        let d1 = this.migrator.destroy()
        let d2 = this.seeder.destroy()
        let d3 = this.auth.destroy()
        let d4 = this.orders.destroy()
        let d5 = this.response.destroy()
        let d6 = this.logger.destroy()
        return true
    }
}

// ============================================================================
// Server Bootstrap & REST Routing via Application Container
// ============================================================================

let app = run()

// 1. Healthcheck Endpoint
get("/health", (server: Application) => {
    return server.health()
})

// 2. Database Auto-Migration Trigger
get("/api/v1/database/migrate", (server: Application) => {
    return server.migrateDatabase()
})

// 3. Auth Routes
post("/api/v1/auth/login", (server: Application) => {
    return server.auth.handleLogin("ahmet@kora-lang.org", "secretPassword")
})

post("/api/v1/auth/register", (server: Application) => {
    return server.auth.handleRegister("newuser@kora-lang.org", "New User")
})

// 4. Orders Routes
get("/api/v1/orders/{id}", (id: Int, server: Application) => {
    return server.orders.handleGet(id)
})

post("/api/v1/orders", (server: Application) => {
    return server.orders.handleCreate(1, 5, 500000)
})

post("/api/v1/orders/{id}/cancel", (id: Int, server: Application) => {
    return server.orders.handleCancel(id)
})
