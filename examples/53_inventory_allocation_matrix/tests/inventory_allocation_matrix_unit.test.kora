// ============================================================================
// Unit Test Suite: Inventory Allocation Matrix & Multi-Warehouse Stock
// Verifies Domain Invariants, Boundary Calculations & Liveness
// ============================================================================

import { CreateInventoryAllocationMatrixTaskRequest } from "../models/inventory_allocation_matrix_request.dto"
import { InventoryAllocationMatrixInMemoryRepository } from "../repositories/inventory_allocation_matrix_inmemory.repository"
import { InventoryAllocationMatrixCoreService } from "../services/inventory_allocation_matrix_core.service"
import { InventoryAllocationMatrixTelemetryService } from "../services/inventory_allocation_matrix_telemetry.service"

class InventoryAllocationMatrixUnitTestSuite {
    service: InventoryAllocationMatrixCoreService
    telemetry: InventoryAllocationMatrixTelemetryService

    init(service: InventoryAllocationMatrixCoreService, telemetry: InventoryAllocationMatrixTelemetryService) {
        this.service = service
        this.telemetry = telemetry
    }

    fn test_valid_task_execution() -> Bool {
        let req = CreateInventoryAllocationMatrixTaskRequest {
            taskKey: "UNIT-TASK-101",
            targetEntityId: 10,
            workloadCapacity: 95,
            domainContext: "E-Commerce",
        }
        let res = this.service.executeTask(req)
        return match res {
            Ok(rec) => rec.id == 10 && rec.capacityScore == 95,
            Err(e) => false,
        }
    }

    fn test_invalid_negative_target_rejected() -> Bool {
        let req = CreateInventoryAllocationMatrixTaskRequest {
            taskKey: "INVALID-TASK",
            targetEntityId: -1,
            workloadCapacity: 50,
            domainContext: "E-Commerce",
        }
        let res = this.service.executeTask(req)
        return match res {
            Ok(r) => false,
            Err(e) => e == "Target entity ID must be strictly positive",
        }
    }

    fn test_health_evaluation() -> Bool {
        let health = this.service.evaluateHealth(10)
        return health == "OPTIMUM_PERFORMANCE" || health == "MODERATE_NORMAL"
    }

    fn test_telemetry_ping() -> Bool {
        return this.telemetry.ping()
    }

    fn run() -> Unit {
        let t1 = this.test_valid_task_execution()
        let t2 = this.test_invalid_negative_target_rejected()
        let t3 = this.test_health_evaluation()
        let t4 = this.test_telemetry_ping()

        if t1 && t2 && t3 && t4 {
            print("  ✓ Inventory Allocation Matrix & Multi-Warehouse Stock Unit Tests: 4/4 passed (Domain Invariants Verified)")
        } else {
            print("  ✗ Inventory Allocation Matrix & Multi-Warehouse Stock Unit Tests: failed")
        }
    }
}

let repo = InventoryAllocationMatrixInMemoryRepository()
let service = InventoryAllocationMatrixCoreService(repo)
let telemetry = InventoryAllocationMatrixTelemetryService()
let suite = InventoryAllocationMatrixUnitTestSuite(service, telemetry)
suite.run()
