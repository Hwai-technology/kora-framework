// Example 40: Clinical Trial Electronic Data Capture (EDC)
// Core Domain Service Implementation

import { ClinicalTrialEdcClinicalEntity } from "../entities/clinical_trial_edc_primary.entity"
import { CreateClinicalTrialEdcRecordRequest } from "../models/clinical_trial_edc_request.dto"
import { ClinicalTrialEdcRepository } from "../interfaces/clinical_trial_edc_repository.interface"
import { ClinicalTrialEdcDomainContract } from "../interfaces/clinical_trial_edc_service.interface"

class ClinicalTrialEdcCoreService implements ClinicalTrialEdcDomainContract {
    repo: ClinicalTrialEdcRepository

    init(repo: ClinicalTrialEdcRepository) {
        this.repo = repo
    }

    fn processClinicalRecord(req: CreateClinicalTrialEdcRecordRequest) -> Result<ClinicalTrialEdcClinicalEntity, String> {
        if req.patientId <= 0 {
            return Err("Patient ID must be strictly positive")
        }
        if req.clinicalMetricScore < 0 {
            return Err("Clinical metric score cannot be negative")
        }

        let entity = ClinicalTrialEdcClinicalEntity {
            id: req.patientId + 5000,
            patientId: req.patientId,
            clinicianId: req.clinicianId,
            clinicalMetricScore: req.clinicalMetricScore,
            complianceState: "AUDITED_SECURE",
            active: true,
        }
        return this.repo.save(entity)
    }

    fn evaluateClinicalRisk(patientId: Int) -> String {
        let opt = this.repo.findByPatientId(patientId)
        let isPresent = match opt {
            Some(r) => true,
            None => false,
        }
        if !isPresent {
            return "RECORD_NOT_FOUND"
        }
        let record = match opt {
            Some(r) => r,
            None => ClinicalTrialEdcClinicalEntity { id: 0, patientId: 0, clinicianId: 0, clinicalMetricScore: 0, complianceState: "", active: false },
        }
        if record.clinicalMetricScore > 80 {
            return "CRITICAL_OBSERVATION"
        }
        if record.clinicalMetricScore > 40 {
            return "MODERATE_ATTENTION"
        }
        return "NOMINAL_STABLE"
    }
}
