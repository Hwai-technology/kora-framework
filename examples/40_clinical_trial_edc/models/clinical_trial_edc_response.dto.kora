// Example 40: Clinical Trial Electronic Data Capture (EDC)
// Transport Model: Standard Responses

model ClinicalTrialEdcResponseDto {
    recordId: Int
    patientId: Int
    status: String
    isComplianceVerified: Bool
    message: String
}

model ClinicalTrialEdcSummaryDto {
    patientId: Int
    totalEntries: Int
    severityCategory: String
    lastReviewedTimestamp: Int
}
