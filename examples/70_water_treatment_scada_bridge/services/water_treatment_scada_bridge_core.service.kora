// Example 70: Industrial SCADA Modbus Gateway & Water Treatment
// Core Domain Service Implementation

import { WaterTreatmentScadaBridgePrimaryRecord } from "../entities/water_treatment_scada_bridge_primary.entity"
import { CreateWaterTreatmentScadaBridgeTaskRequest } from "../models/water_treatment_scada_bridge_request.dto"
import { WaterTreatmentScadaBridgeRepository } from "../interfaces/water_treatment_scada_bridge_repository.interface"
import { WaterTreatmentScadaBridgeDomainContract } from "../interfaces/water_treatment_scada_bridge_service.interface"

class WaterTreatmentScadaBridgeCoreService implements WaterTreatmentScadaBridgeDomainContract {
    repo: WaterTreatmentScadaBridgeRepository

    init(repo: WaterTreatmentScadaBridgeRepository) {
        this.repo = repo
    }

    fn executeTask(req: CreateWaterTreatmentScadaBridgeTaskRequest) -> Result<WaterTreatmentScadaBridgePrimaryRecord, String> {
        if req.targetEntityId <= 0 {
            return Err("Target entity ID must be strictly positive")
        }
        if req.workloadCapacity <= 0 {
            return Err("Workload capacity must be strictly positive")
        }

        let record = WaterTreatmentScadaBridgePrimaryRecord {
            id: req.targetEntityId,
            referenceCode: req.taskKey,
            capacityScore: req.workloadCapacity,
            operationalStatus: "COMMITTED_HEALTHY",
            active: true,
        }
        return this.repo.save(record)
    }

    fn evaluateHealth(entityId: Int) -> String {
        let opt = this.repo.findById(entityId)
        let isPresent = match opt {
            Some(r) => true,
            None => false,
        }
        if !isPresent {
            return "ENTITY_NOT_FOUND"
        }
        let record = match opt {
            Some(r) => r,
            None => WaterTreatmentScadaBridgePrimaryRecord { id: 0, referenceCode: "", capacityScore: 0, operationalStatus: "", active: false },
        }
        if record.capacityScore > 80 {
            return "OPTIMUM_PERFORMANCE"
        }
        if record.capacityScore > 40 {
            return "MODERATE_NORMAL"
        }
        return "LOW_CAPACITY"
    }
}
