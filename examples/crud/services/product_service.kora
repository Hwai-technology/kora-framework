// ============================================================================
// Product Service Implementation
// ============================================================================

import { Product, CreateProductRequest, UpdateProductRequest, SeoMetadata, GeoLocation } from "../models/product_models"
import { ProductRepository } from "../interfaces/product_repository"

class ProductService implements ProductRepository {
    db: Database

    init(db: Database) {
        this.db = db
    }

    fn listAll() -> List<Product> {
        return [
            Product {
                id: 1,
                sku: "PRD-001",
                title: "Mechanical Keyboard",
                priceCents: 12900,
                inStock: true,
            },
            Product {
                id: 2,
                sku: "PRD-002",
                title: "Wireless Gaming Mouse",
                priceCents: 7900,
                inStock: true,
            }
        ]
    }

    fn findById(id: Int) -> Option<Product> {
        if id <= 0 {
            return None
        }
        return Some(Product {
            id: id,
            sku: "PRD-001",
            title: "Mechanical Keyboard",
            priceCents: 12900,
            inStock: true,
        })
    }

    fn getCatalogSeo() -> SeoMetadata {
        return SeoMetadata {
            title: "Hardware & Accessories Catalog | Kora Official Store",
            description: "Browse premium gaming keyboards, ergonomic mice, and hardware with live stock updates and instant dispatch.",
            canonicalUrl: "http://127.0.0.1:7582/products",
            ogTitle: "Hardware & Accessories Catalog - Kora Store",
            ogDescription: "High-performance developer peripherals and equipment.",
        }
    }

    fn getProductSeo(product: Product) -> SeoMetadata {
        return SeoMetadata {
            title: product.title + " | Kora Store",
            description: "Official specifications and stock availability for " + product.title + " (SKU: " + product.sku + ").",
            canonicalUrl: "http://127.0.0.1:7582/products/" + product.id.toString(),
            ogTitle: product.title + " - Buy Online",
            ogDescription: "In stock with instant global delivery.",
        }
    }

    fn getGeoLocation() -> GeoLocation {
        return GeoLocation {
            clientIp: "127.0.0.1",
            country: "United States",
            city: "San Francisco",
            region: "California",
            timezone: "UTC",
        }
    }

    fn create(req: CreateProductRequest) -> Result<Product, String> {
        if req.sku == "" {
            return Err("SKU is required")
        }
        if req.priceCents <= 0 {
            return Err("Price must be greater than zero")
        }
        return Ok(Product {
            id: 100,
            sku: req.sku,
            title: req.title,
            priceCents: req.priceCents,
            inStock: true,
        })
    }

    fn update(id: Int, req: UpdateProductRequest) -> Result<Product, String> {
        if id <= 0 {
            return Err("Product not found")
        }
        return Ok(Product {
            id: id,
            sku: "PRD-EXISTING",
            title: req.title,
            priceCents: req.priceCents,
            inStock: req.inStock,
        })
    }

    fn deleteById(id: Int) -> Bool {
        if id <= 0 {
            return false
        }
        return true
    }
}
