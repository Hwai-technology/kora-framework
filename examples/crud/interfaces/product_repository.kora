// ============================================================================
// Product Repository Contract Interface
// ============================================================================

import { Product, CreateProductRequest, UpdateProductRequest, SeoMetadata, GeoLocation } from "../models/product_models"

interface ProductRepository {
    fn listAll() -> List<Product>
    fn findById(id: Int) -> Option<Product>
    fn create(req: CreateProductRequest) -> Result<Product, String>
    fn update(id: Int, req: UpdateProductRequest) -> Result<Product, String>
    fn deleteById(id: Int) -> Bool
    fn getCatalogSeo() -> SeoMetadata
    fn getProductSeo(product: Product) -> SeoMetadata
    fn getGeoLocation() -> GeoLocation
}
