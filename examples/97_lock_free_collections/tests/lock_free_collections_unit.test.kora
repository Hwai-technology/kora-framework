// ============================================================================
// Unit Test Suite: Lock-Free Michael-Scott Queue & Treiber Stack
// Verifies Domain Invariants, Boundary Calculations & Liveness
// ============================================================================

import { CreateLockFreeCollectionsTaskRequest } from "../models/lock_free_collections_request.dto"
import { LockFreeCollectionsInMemoryRepository } from "../repositories/lock_free_collections_inmemory.repository"
import { LockFreeCollectionsCoreService } from "../services/lock_free_collections_core.service"
import { LockFreeCollectionsTelemetryService } from "../services/lock_free_collections_telemetry.service"

class LockFreeCollectionsUnitTestSuite {
    service: LockFreeCollectionsCoreService
    telemetry: LockFreeCollectionsTelemetryService

    init(service: LockFreeCollectionsCoreService, telemetry: LockFreeCollectionsTelemetryService) {
        this.service = service
        this.telemetry = telemetry
    }

    fn test_valid_task_execution() -> Bool {
        let req = CreateLockFreeCollectionsTaskRequest {
            taskKey: "UNIT-TASK-101",
            targetEntityId: 10,
            workloadCapacity: 95,
            domainContext: "Algorithms & Kernels",
        }
        let res = this.service.executeTask(req)
        return match res {
            Ok(rec) => rec.id == 10 && rec.capacityScore == 95,
            Err(e) => false,
        }
    }

    fn test_invalid_negative_target_rejected() -> Bool {
        let req = CreateLockFreeCollectionsTaskRequest {
            taskKey: "INVALID-TASK",
            targetEntityId: -1,
            workloadCapacity: 50,
            domainContext: "Algorithms & Kernels",
        }
        let res = this.service.executeTask(req)
        return match res {
            Ok(r) => false,
            Err(e) => e == "Target entity ID must be strictly positive",
        }
    }

    fn test_health_evaluation() -> Bool {
        let health = this.service.evaluateHealth(10)
        return health == "OPTIMUM_PERFORMANCE" || health == "MODERATE_NORMAL"
    }

    fn test_telemetry_ping() -> Bool {
        return this.telemetry.ping()
    }

    fn run() -> Unit {
        let t1 = this.test_valid_task_execution()
        let t2 = this.test_invalid_negative_target_rejected()
        let t3 = this.test_health_evaluation()
        let t4 = this.test_telemetry_ping()

        if t1 && t2 && t3 && t4 {
            print("  ✓ Lock-Free Michael-Scott Queue & Treiber Stack Unit Tests: 4/4 passed (Domain Invariants Verified)")
        } else {
            print("  ✗ Lock-Free Michael-Scott Queue & Treiber Stack Unit Tests: failed")
        }
    }
}

let repo = LockFreeCollectionsInMemoryRepository()
let service = LockFreeCollectionsCoreService(repo)
let telemetry = LockFreeCollectionsTelemetryService()
let suite = LockFreeCollectionsUnitTestSuite(service, telemetry)
suite.run()
