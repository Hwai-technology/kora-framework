// Example 34: HIPAA Compliant Electronic Health Records
// Core Domain Service Implementation

import { HipaaCompliantEhrClinicalEntity } from "../entities/hipaa_compliant_ehr_primary.entity"
import { CreateHipaaCompliantEhrRecordRequest } from "../models/hipaa_compliant_ehr_request.dto"
import { HipaaCompliantEhrRepository } from "../interfaces/hipaa_compliant_ehr_repository.interface"
import { HipaaCompliantEhrDomainContract } from "../interfaces/hipaa_compliant_ehr_service.interface"

class HipaaCompliantEhrCoreService implements HipaaCompliantEhrDomainContract {
    repo: HipaaCompliantEhrRepository

    init(repo: HipaaCompliantEhrRepository) {
        this.repo = repo
    }

    fn processClinicalRecord(req: CreateHipaaCompliantEhrRecordRequest) -> Result<HipaaCompliantEhrClinicalEntity, String> {
        if req.patientId <= 0 {
            return Err("Patient ID must be strictly positive")
        }
        if req.clinicalMetricScore < 0 {
            return Err("Clinical metric score cannot be negative")
        }

        let entity = HipaaCompliantEhrClinicalEntity {
            id: req.patientId + 5000,
            patientId: req.patientId,
            clinicianId: req.clinicianId,
            clinicalMetricScore: req.clinicalMetricScore,
            complianceState: "AUDITED_SECURE",
            active: true,
        }
        return this.repo.save(entity)
    }

    fn evaluateClinicalRisk(patientId: Int) -> String {
        let opt = this.repo.findByPatientId(patientId)
        let isPresent = match opt {
            Some(r) => true,
            None => false,
        }
        if !isPresent {
            return "RECORD_NOT_FOUND"
        }
        let record = match opt {
            Some(r) => r,
            None => HipaaCompliantEhrClinicalEntity { id: 0, patientId: 0, clinicianId: 0, clinicalMetricScore: 0, complianceState: "", active: false },
        }
        if record.clinicalMetricScore > 80 {
            return "CRITICAL_OBSERVATION"
        }
        if record.clinicalMetricScore > 40 {
            return "MODERATE_ATTENTION"
        }
        return "NOMINAL_STABLE"
    }
}
