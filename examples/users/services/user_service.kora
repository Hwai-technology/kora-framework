// ============================================================================
// User Service Implementation
// ============================================================================

import { User } from "../models/user_models"
import { UserRepository } from "../interfaces/user_repository"

class UserService implements UserRepository {
    db: Database

    init(db: Database) {
        this.db = db
    }

    fn findById(id: Int) -> Option<User> {
        if id <= 0 {
            return None
        }
        return Some(User {
            id: id,
            name: "Ahmet",
            email: "ahmet@kora.dev",
            active: true,
        })
    }

    fn validateNewUser(user: User) -> Result<User, String> {
        if user.name == "" {
            return Err("User name is required")
        }
        if !user.active {
            return Err("New user account must be active")
        }
        return Ok(user)
    }
}

