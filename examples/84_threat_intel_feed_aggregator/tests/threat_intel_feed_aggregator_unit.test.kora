// ============================================================================
// Unit Test Suite: Threat Intelligence STIX/TAXII Indicator Parser
// Verifies Domain Invariants, Boundary Calculations & Liveness
// ============================================================================

import { CreateThreatIntelFeedAggregatorTaskRequest } from "../models/threat_intel_feed_aggregator_request.dto"
import { ThreatIntelFeedAggregatorInMemoryRepository } from "../repositories/threat_intel_feed_aggregator_inmemory.repository"
import { ThreatIntelFeedAggregatorCoreService } from "../services/threat_intel_feed_aggregator_core.service"
import { ThreatIntelFeedAggregatorTelemetryService } from "../services/threat_intel_feed_aggregator_telemetry.service"

class ThreatIntelFeedAggregatorUnitTestSuite {
    service: ThreatIntelFeedAggregatorCoreService
    telemetry: ThreatIntelFeedAggregatorTelemetryService

    init(service: ThreatIntelFeedAggregatorCoreService, telemetry: ThreatIntelFeedAggregatorTelemetryService) {
        this.service = service
        this.telemetry = telemetry
    }

    fn test_valid_task_execution() -> Bool {
        let req = CreateThreatIntelFeedAggregatorTaskRequest {
            taskKey: "UNIT-TASK-101",
            targetEntityId: 10,
            workloadCapacity: 95,
            domainContext: "Cybersecurity",
        }
        let res = this.service.executeTask(req)
        return match res {
            Ok(rec) => rec.id == 10 && rec.capacityScore == 95,
            Err(e) => false,
        }
    }

    fn test_invalid_negative_target_rejected() -> Bool {
        let req = CreateThreatIntelFeedAggregatorTaskRequest {
            taskKey: "INVALID-TASK",
            targetEntityId: -1,
            workloadCapacity: 50,
            domainContext: "Cybersecurity",
        }
        let res = this.service.executeTask(req)
        return match res {
            Ok(r) => false,
            Err(e) => e == "Target entity ID must be strictly positive",
        }
    }

    fn test_health_evaluation() -> Bool {
        let health = this.service.evaluateHealth(10)
        return health == "OPTIMUM_PERFORMANCE" || health == "MODERATE_NORMAL"
    }

    fn test_telemetry_ping() -> Bool {
        return this.telemetry.ping()
    }

    fn run() -> Unit {
        let t1 = this.test_valid_task_execution()
        let t2 = this.test_invalid_negative_target_rejected()
        let t3 = this.test_health_evaluation()
        let t4 = this.test_telemetry_ping()

        if t1 && t2 && t3 && t4 {
            print("  ✓ Threat Intelligence STIX/TAXII Indicator Parser Unit Tests: 4/4 passed (Domain Invariants Verified)")
        } else {
            print("  ✗ Threat Intelligence STIX/TAXII Indicator Parser Unit Tests: failed")
        }
    }
}

let repo = ThreatIntelFeedAggregatorInMemoryRepository()
let service = ThreatIntelFeedAggregatorCoreService(repo)
let telemetry = ThreatIntelFeedAggregatorTelemetryService()
let suite = ThreatIntelFeedAggregatorUnitTestSuite(service, telemetry)
suite.run()
