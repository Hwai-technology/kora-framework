// Example 84: Threat Intelligence STIX/TAXII Indicator Parser
// Persistent Database Entity: Primary Record

@table("threat_intel_feed_aggregator_records")
model ThreatIntelFeedAggregatorPrimaryRecord {
    @id
    id: Int
    @unique
    referenceCode: String
    capacityScore: Int
    operationalStatus: String
    active: Bool
}
