// ============================================================================
// Unit Test Suite: Smart Building HVAC & Air Quality Coordinator
// Verifies Domain Invariants, Boundary Calculations & Liveness
// ============================================================================

import { CreateSmartBuildingHvacControlTaskRequest } from "../models/smart_building_hvac_control_request.dto"
import { SmartBuildingHvacControlInMemoryRepository } from "../repositories/smart_building_hvac_control_inmemory.repository"
import { SmartBuildingHvacControlCoreService } from "../services/smart_building_hvac_control_core.service"
import { SmartBuildingHvacControlTelemetryService } from "../services/smart_building_hvac_control_telemetry.service"

class SmartBuildingHvacControlUnitTestSuite {
    service: SmartBuildingHvacControlCoreService
    telemetry: SmartBuildingHvacControlTelemetryService

    init(service: SmartBuildingHvacControlCoreService, telemetry: SmartBuildingHvacControlTelemetryService) {
        this.service = service
        this.telemetry = telemetry
    }

    fn test_valid_task_execution() -> Bool {
        let req = CreateSmartBuildingHvacControlTaskRequest {
            taskKey: "UNIT-TASK-101",
            targetEntityId: 10,
            workloadCapacity: 95,
            domainContext: "IoT & Robotics",
        }
        let res = this.service.executeTask(req)
        return match res {
            Ok(rec) => rec.id == 10 && rec.capacityScore == 95,
            Err(e) => false,
        }
    }

    fn test_invalid_negative_target_rejected() -> Bool {
        let req = CreateSmartBuildingHvacControlTaskRequest {
            taskKey: "INVALID-TASK",
            targetEntityId: -1,
            workloadCapacity: 50,
            domainContext: "IoT & Robotics",
        }
        let res = this.service.executeTask(req)
        return match res {
            Ok(r) => false,
            Err(e) => e == "Target entity ID must be strictly positive",
        }
    }

    fn test_health_evaluation() -> Bool {
        let health = this.service.evaluateHealth(10)
        return health == "OPTIMUM_PERFORMANCE" || health == "MODERATE_NORMAL"
    }

    fn test_telemetry_ping() -> Bool {
        return this.telemetry.ping()
    }

    fn run() -> Unit {
        let t1 = this.test_valid_task_execution()
        let t2 = this.test_invalid_negative_target_rejected()
        let t3 = this.test_health_evaluation()
        let t4 = this.test_telemetry_ping()

        if t1 && t2 && t3 && t4 {
            print("  ✓ Smart Building HVAC & Air Quality Coordinator Unit Tests: 4/4 passed (Domain Invariants Verified)")
        } else {
            print("  ✗ Smart Building HVAC & Air Quality Coordinator Unit Tests: failed")
        }
    }
}

let repo = SmartBuildingHvacControlInMemoryRepository()
let service = SmartBuildingHvacControlCoreService(repo)
let telemetry = SmartBuildingHvacControlTelemetryService()
let suite = SmartBuildingHvacControlUnitTestSuite(service, telemetry)
suite.run()
