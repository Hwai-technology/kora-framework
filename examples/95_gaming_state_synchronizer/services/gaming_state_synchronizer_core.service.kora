// Example 95: Multiplayer Game 60Hz Tick State Synchronizer
// Core Domain Service Implementation

import { GamingStateSynchronizerPrimaryRecord } from "../entities/gaming_state_synchronizer_primary.entity"
import { CreateGamingStateSynchronizerTaskRequest } from "../models/gaming_state_synchronizer_request.dto"
import { GamingStateSynchronizerRepository } from "../interfaces/gaming_state_synchronizer_repository.interface"
import { GamingStateSynchronizerDomainContract } from "../interfaces/gaming_state_synchronizer_service.interface"

class GamingStateSynchronizerCoreService implements GamingStateSynchronizerDomainContract {
    repo: GamingStateSynchronizerRepository

    init(repo: GamingStateSynchronizerRepository) {
        this.repo = repo
    }

    fn executeTask(req: CreateGamingStateSynchronizerTaskRequest) -> Result<GamingStateSynchronizerPrimaryRecord, String> {
        if req.targetEntityId <= 0 {
            return Err("Target entity ID must be strictly positive")
        }
        if req.workloadCapacity <= 0 {
            return Err("Workload capacity must be strictly positive")
        }

        let record = GamingStateSynchronizerPrimaryRecord {
            id: req.targetEntityId,
            referenceCode: req.taskKey,
            capacityScore: req.workloadCapacity,
            operationalStatus: "COMMITTED_HEALTHY",
            active: true,
        }
        return this.repo.save(record)
    }

    fn evaluateHealth(entityId: Int) -> String {
        let opt = this.repo.findById(entityId)
        let isPresent = match opt {
            Some(r) => true,
            None => false,
        }
        if !isPresent {
            return "ENTITY_NOT_FOUND"
        }
        let record = match opt {
            Some(r) => r,
            None => GamingStateSynchronizerPrimaryRecord { id: 0, referenceCode: "", capacityScore: 0, operationalStatus: "", active: false },
        }
        if record.capacityScore > 80 {
            return "OPTIMUM_PERFORMANCE"
        }
        if record.capacityScore > 40 {
            return "MODERATE_NORMAL"
        }
        return "LOW_CAPACITY"
    }
}
