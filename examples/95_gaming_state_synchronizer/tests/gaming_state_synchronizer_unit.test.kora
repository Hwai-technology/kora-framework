// ============================================================================
// Unit Test Suite: Multiplayer Game 60Hz Tick State Synchronizer
// Verifies Domain Invariants, Boundary Calculations & Liveness
// ============================================================================

import { CreateGamingStateSynchronizerTaskRequest } from "../models/gaming_state_synchronizer_request.dto"
import { GamingStateSynchronizerInMemoryRepository } from "../repositories/gaming_state_synchronizer_inmemory.repository"
import { GamingStateSynchronizerCoreService } from "../services/gaming_state_synchronizer_core.service"
import { GamingStateSynchronizerTelemetryService } from "../services/gaming_state_synchronizer_telemetry.service"

class GamingStateSynchronizerUnitTestSuite {
    service: GamingStateSynchronizerCoreService
    telemetry: GamingStateSynchronizerTelemetryService

    init(service: GamingStateSynchronizerCoreService, telemetry: GamingStateSynchronizerTelemetryService) {
        this.service = service
        this.telemetry = telemetry
    }

    fn test_valid_task_execution() -> Bool {
        let req = CreateGamingStateSynchronizerTaskRequest {
            taskKey: "UNIT-TASK-101",
            targetEntityId: 10,
            workloadCapacity: 95,
            domainContext: "Media & Realtime",
        }
        let res = this.service.executeTask(req)
        return match res {
            Ok(rec) => rec.id == 10 && rec.capacityScore == 95,
            Err(e) => false,
        }
    }

    fn test_invalid_negative_target_rejected() -> Bool {
        let req = CreateGamingStateSynchronizerTaskRequest {
            taskKey: "INVALID-TASK",
            targetEntityId: -1,
            workloadCapacity: 50,
            domainContext: "Media & Realtime",
        }
        let res = this.service.executeTask(req)
        return match res {
            Ok(r) => false,
            Err(e) => e == "Target entity ID must be strictly positive",
        }
    }

    fn test_health_evaluation() -> Bool {
        let health = this.service.evaluateHealth(10)
        return health == "OPTIMUM_PERFORMANCE" || health == "MODERATE_NORMAL"
    }

    fn test_telemetry_ping() -> Bool {
        return this.telemetry.ping()
    }

    fn run() -> Unit {
        let t1 = this.test_valid_task_execution()
        let t2 = this.test_invalid_negative_target_rejected()
        let t3 = this.test_health_evaluation()
        let t4 = this.test_telemetry_ping()

        if t1 && t2 && t3 && t4 {
            print("  ✓ Multiplayer Game 60Hz Tick State Synchronizer Unit Tests: 4/4 passed (Domain Invariants Verified)")
        } else {
            print("  ✗ Multiplayer Game 60Hz Tick State Synchronizer Unit Tests: failed")
        }
    }
}

let repo = GamingStateSynchronizerInMemoryRepository()
let service = GamingStateSynchronizerCoreService(repo)
let telemetry = GamingStateSynchronizerTelemetryService()
let suite = GamingStateSynchronizerUnitTestSuite(service, telemetry)
suite.run()
