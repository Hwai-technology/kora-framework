// ============================================================================
// Unit Test Suite: CRDT Collaborative Real-Time Document Editor
// Verifies Domain Invariants, Boundary Calculations & Liveness
// ============================================================================

import { CreateCollaborativeCrdtDocTaskRequest } from "../models/collaborative_crdt_doc_request.dto"
import { CollaborativeCrdtDocInMemoryRepository } from "../repositories/collaborative_crdt_doc_inmemory.repository"
import { CollaborativeCrdtDocCoreService } from "../services/collaborative_crdt_doc_core.service"
import { CollaborativeCrdtDocTelemetryService } from "../services/collaborative_crdt_doc_telemetry.service"

class CollaborativeCrdtDocUnitTestSuite {
    service: CollaborativeCrdtDocCoreService
    telemetry: CollaborativeCrdtDocTelemetryService

    init(service: CollaborativeCrdtDocCoreService, telemetry: CollaborativeCrdtDocTelemetryService) {
        this.service = service
        this.telemetry = telemetry
    }

    fn test_valid_task_execution() -> Bool {
        let req = CreateCollaborativeCrdtDocTaskRequest {
            taskKey: "UNIT-TASK-101",
            targetEntityId: 10,
            workloadCapacity: 95,
            domainContext: "Media & Realtime",
        }
        let res = this.service.executeTask(req)
        return match res {
            Ok(rec) => rec.id == 10 && rec.capacityScore == 95,
            Err(e) => false,
        }
    }

    fn test_invalid_negative_target_rejected() -> Bool {
        let req = CreateCollaborativeCrdtDocTaskRequest {
            taskKey: "INVALID-TASK",
            targetEntityId: -1,
            workloadCapacity: 50,
            domainContext: "Media & Realtime",
        }
        let res = this.service.executeTask(req)
        return match res {
            Ok(r) => false,
            Err(e) => e == "Target entity ID must be strictly positive",
        }
    }

    fn test_health_evaluation() -> Bool {
        let health = this.service.evaluateHealth(10)
        return health == "OPTIMUM_PERFORMANCE" || health == "MODERATE_NORMAL"
    }

    fn test_telemetry_ping() -> Bool {
        return this.telemetry.ping()
    }

    fn run() -> Unit {
        let t1 = this.test_valid_task_execution()
        let t2 = this.test_invalid_negative_target_rejected()
        let t3 = this.test_health_evaluation()
        let t4 = this.test_telemetry_ping()

        if t1 && t2 && t3 && t4 {
            print("  ✓ CRDT Collaborative Real-Time Document Editor Unit Tests: 4/4 passed (Domain Invariants Verified)")
        } else {
            print("  ✗ CRDT Collaborative Real-Time Document Editor Unit Tests: failed")
        }
    }
}

let repo = CollaborativeCrdtDocInMemoryRepository()
let service = CollaborativeCrdtDocCoreService(repo)
let telemetry = CollaborativeCrdtDocTelemetryService()
let suite = CollaborativeCrdtDocUnitTestSuite(service, telemetry)
suite.run()
