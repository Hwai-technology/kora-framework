// Example 91: CRDT Collaborative Real-Time Document Editor
// Core Domain Service Implementation

import { CollaborativeCrdtDocPrimaryRecord } from "../entities/collaborative_crdt_doc_primary.entity"
import { CreateCollaborativeCrdtDocTaskRequest } from "../models/collaborative_crdt_doc_request.dto"
import { CollaborativeCrdtDocRepository } from "../interfaces/collaborative_crdt_doc_repository.interface"
import { CollaborativeCrdtDocDomainContract } from "../interfaces/collaborative_crdt_doc_service.interface"

class CollaborativeCrdtDocCoreService implements CollaborativeCrdtDocDomainContract {
    repo: CollaborativeCrdtDocRepository

    init(repo: CollaborativeCrdtDocRepository) {
        this.repo = repo
    }

    fn executeTask(req: CreateCollaborativeCrdtDocTaskRequest) -> Result<CollaborativeCrdtDocPrimaryRecord, String> {
        if req.targetEntityId <= 0 {
            return Err("Target entity ID must be strictly positive")
        }
        if req.workloadCapacity <= 0 {
            return Err("Workload capacity must be strictly positive")
        }

        let record = CollaborativeCrdtDocPrimaryRecord {
            id: req.targetEntityId,
            referenceCode: req.taskKey,
            capacityScore: req.workloadCapacity,
            operationalStatus: "COMMITTED_HEALTHY",
            active: true,
        }
        return this.repo.save(record)
    }

    fn evaluateHealth(entityId: Int) -> String {
        let opt = this.repo.findById(entityId)
        let isPresent = match opt {
            Some(r) => true,
            None => false,
        }
        if !isPresent {
            return "ENTITY_NOT_FOUND"
        }
        let record = match opt {
            Some(r) => r,
            None => CollaborativeCrdtDocPrimaryRecord { id: 0, referenceCode: "", capacityScore: 0, operationalStatus: "", active: false },
        }
        if record.capacityScore > 80 {
            return "OPTIMUM_PERFORMANCE"
        }
        if record.capacityScore > 40 {
            return "MODERATE_NORMAL"
        }
        return "LOW_CAPACITY"
    }
}
