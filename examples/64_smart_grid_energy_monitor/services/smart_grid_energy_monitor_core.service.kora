// Example 64: Smart Electrical Grid Substation Telemetry
// Core Domain Service Implementation

import { SmartGridEnergyMonitorPrimaryRecord } from "../entities/smart_grid_energy_monitor_primary.entity"
import { CreateSmartGridEnergyMonitorTaskRequest } from "../models/smart_grid_energy_monitor_request.dto"
import { SmartGridEnergyMonitorRepository } from "../interfaces/smart_grid_energy_monitor_repository.interface"
import { SmartGridEnergyMonitorDomainContract } from "../interfaces/smart_grid_energy_monitor_service.interface"

class SmartGridEnergyMonitorCoreService implements SmartGridEnergyMonitorDomainContract {
    repo: SmartGridEnergyMonitorRepository

    init(repo: SmartGridEnergyMonitorRepository) {
        this.repo = repo
    }

    fn executeTask(req: CreateSmartGridEnergyMonitorTaskRequest) -> Result<SmartGridEnergyMonitorPrimaryRecord, String> {
        if req.targetEntityId <= 0 {
            return Err("Target entity ID must be strictly positive")
        }
        if req.workloadCapacity <= 0 {
            return Err("Workload capacity must be strictly positive")
        }

        let record = SmartGridEnergyMonitorPrimaryRecord {
            id: req.targetEntityId,
            referenceCode: req.taskKey,
            capacityScore: req.workloadCapacity,
            operationalStatus: "COMMITTED_HEALTHY",
            active: true,
        }
        return this.repo.save(record)
    }

    fn evaluateHealth(entityId: Int) -> String {
        let opt = this.repo.findById(entityId)
        let isPresent = match opt {
            Some(r) => true,
            None => false,
        }
        if !isPresent {
            return "ENTITY_NOT_FOUND"
        }
        let record = match opt {
            Some(r) => r,
            None => SmartGridEnergyMonitorPrimaryRecord { id: 0, referenceCode: "", capacityScore: 0, operationalStatus: "", active: false },
        }
        if record.capacityScore > 80 {
            return "OPTIMUM_PERFORMANCE"
        }
        if record.capacityScore > 40 {
            return "MODERATE_NORMAL"
        }
        return "LOW_CAPACITY"
    }
}
