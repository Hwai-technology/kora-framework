// Example 76: Model Serving Inference Gateway & Dynamic Batcher
// Core Domain Service Implementation

import { ModelInferenceGatewayPrimaryRecord } from "../entities/model_inference_gateway_primary.entity"
import { CreateModelInferenceGatewayTaskRequest } from "../models/model_inference_gateway_request.dto"
import { ModelInferenceGatewayRepository } from "../interfaces/model_inference_gateway_repository.interface"
import { ModelInferenceGatewayDomainContract } from "../interfaces/model_inference_gateway_service.interface"

class ModelInferenceGatewayCoreService implements ModelInferenceGatewayDomainContract {
    repo: ModelInferenceGatewayRepository

    init(repo: ModelInferenceGatewayRepository) {
        this.repo = repo
    }

    fn executeTask(req: CreateModelInferenceGatewayTaskRequest) -> Result<ModelInferenceGatewayPrimaryRecord, String> {
        if req.targetEntityId <= 0 {
            return Err("Target entity ID must be strictly positive")
        }
        if req.workloadCapacity <= 0 {
            return Err("Workload capacity must be strictly positive")
        }

        let record = ModelInferenceGatewayPrimaryRecord {
            id: req.targetEntityId,
            referenceCode: req.taskKey,
            capacityScore: req.workloadCapacity,
            operationalStatus: "COMMITTED_HEALTHY",
            active: true,
        }
        return this.repo.save(record)
    }

    fn evaluateHealth(entityId: Int) -> String {
        let opt = this.repo.findById(entityId)
        let isPresent = match opt {
            Some(r) => true,
            None => false,
        }
        if !isPresent {
            return "ENTITY_NOT_FOUND"
        }
        let record = match opt {
            Some(r) => r,
            None => ModelInferenceGatewayPrimaryRecord { id: 0, referenceCode: "", capacityScore: 0, operationalStatus: "", active: false },
        }
        if record.capacityScore > 80 {
            return "OPTIMUM_PERFORMANCE"
        }
        if record.capacityScore > 40 {
            return "MODERATE_NORMAL"
        }
        return "LOW_CAPACITY"
    }
}
