// ============================================================================
// Unit Test Suite: Model Serving Inference Gateway & Dynamic Batcher
// Verifies Domain Invariants, Boundary Calculations & Liveness
// ============================================================================

import { CreateModelInferenceGatewayTaskRequest } from "../models/model_inference_gateway_request.dto"
import { ModelInferenceGatewayInMemoryRepository } from "../repositories/model_inference_gateway_inmemory.repository"
import { ModelInferenceGatewayCoreService } from "../services/model_inference_gateway_core.service"
import { ModelInferenceGatewayTelemetryService } from "../services/model_inference_gateway_telemetry.service"

class ModelInferenceGatewayUnitTestSuite {
    service: ModelInferenceGatewayCoreService
    telemetry: ModelInferenceGatewayTelemetryService

    init(service: ModelInferenceGatewayCoreService, telemetry: ModelInferenceGatewayTelemetryService) {
        this.service = service
        this.telemetry = telemetry
    }

    fn test_valid_task_execution() -> Bool {
        let req = CreateModelInferenceGatewayTaskRequest {
            taskKey: "UNIT-TASK-101",
            targetEntityId: 10,
            workloadCapacity: 95,
            domainContext: "AI/ML Systems",
        }
        let res = this.service.executeTask(req)
        return match res {
            Ok(rec) => rec.id == 10 && rec.capacityScore == 95,
            Err(e) => false,
        }
    }

    fn test_invalid_negative_target_rejected() -> Bool {
        let req = CreateModelInferenceGatewayTaskRequest {
            taskKey: "INVALID-TASK",
            targetEntityId: -1,
            workloadCapacity: 50,
            domainContext: "AI/ML Systems",
        }
        let res = this.service.executeTask(req)
        return match res {
            Ok(r) => false,
            Err(e) => e == "Target entity ID must be strictly positive",
        }
    }

    fn test_health_evaluation() -> Bool {
        let health = this.service.evaluateHealth(10)
        return health == "OPTIMUM_PERFORMANCE" || health == "MODERATE_NORMAL"
    }

    fn test_telemetry_ping() -> Bool {
        return this.telemetry.ping()
    }

    fn run() -> Unit {
        let t1 = this.test_valid_task_execution()
        let t2 = this.test_invalid_negative_target_rejected()
        let t3 = this.test_health_evaluation()
        let t4 = this.test_telemetry_ping()

        if t1 && t2 && t3 && t4 {
            print("  ✓ Model Serving Inference Gateway & Dynamic Batcher Unit Tests: 4/4 passed (Domain Invariants Verified)")
        } else {
            print("  ✗ Model Serving Inference Gateway & Dynamic Batcher Unit Tests: failed")
        }
    }
}

let repo = ModelInferenceGatewayInMemoryRepository()
let service = ModelInferenceGatewayCoreService(repo)
let telemetry = ModelInferenceGatewayTelemetryService()
let suite = ModelInferenceGatewayUnitTestSuite(service, telemetry)
suite.run()
