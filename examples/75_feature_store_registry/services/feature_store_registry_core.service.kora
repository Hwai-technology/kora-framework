// Example 75: Real-Time Machine Learning Feature Store
// Core Domain Service Implementation

import { FeatureStoreRegistryPrimaryRecord } from "../entities/feature_store_registry_primary.entity"
import { CreateFeatureStoreRegistryTaskRequest } from "../models/feature_store_registry_request.dto"
import { FeatureStoreRegistryRepository } from "../interfaces/feature_store_registry_repository.interface"
import { FeatureStoreRegistryDomainContract } from "../interfaces/feature_store_registry_service.interface"

class FeatureStoreRegistryCoreService implements FeatureStoreRegistryDomainContract {
    repo: FeatureStoreRegistryRepository

    init(repo: FeatureStoreRegistryRepository) {
        this.repo = repo
    }

    fn executeTask(req: CreateFeatureStoreRegistryTaskRequest) -> Result<FeatureStoreRegistryPrimaryRecord, String> {
        if req.targetEntityId <= 0 {
            return Err("Target entity ID must be strictly positive")
        }
        if req.workloadCapacity <= 0 {
            return Err("Workload capacity must be strictly positive")
        }

        let record = FeatureStoreRegistryPrimaryRecord {
            id: req.targetEntityId,
            referenceCode: req.taskKey,
            capacityScore: req.workloadCapacity,
            operationalStatus: "COMMITTED_HEALTHY",
            active: true,
        }
        return this.repo.save(record)
    }

    fn evaluateHealth(entityId: Int) -> String {
        let opt = this.repo.findById(entityId)
        let isPresent = match opt {
            Some(r) => true,
            None => false,
        }
        if !isPresent {
            return "ENTITY_NOT_FOUND"
        }
        let record = match opt {
            Some(r) => r,
            None => FeatureStoreRegistryPrimaryRecord { id: 0, referenceCode: "", capacityScore: 0, operationalStatus: "", active: false },
        }
        if record.capacityScore > 80 {
            return "OPTIMUM_PERFORMANCE"
        }
        if record.capacityScore > 40 {
            return "MODERATE_NORMAL"
        }
        return "LOW_CAPACITY"
    }
}
