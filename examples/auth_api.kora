// ============================================================================
// Kora Example: Clean Architecture Authentication API
// ============================================================================

import { AuthUser, RegisterRequest, LoginRequest, AuthTokenResponse } from "./auth/models/auth_dto"
import { AuthService } from "./auth/services/auth_service"

let app = run()

post("/auth/register", (request: Request, auth: AuthService) => {
    let req = RegisterRequest {
        username: "ahmet",
        plainPassword: request.body,
    }
    return auth.register(req)
})

post("/auth/login", (request: Request, auth: AuthService) => {
    let req = LoginRequest {
        username: "admin",
        plainPassword: "secret123",
    }
    return auth.login(req)
})
