// Example 36: Telemedicine Virtual Clinic & E-Prescriptions
// Transport Model: Standard Responses

model TelemedicineConsultationResponseDto {
    recordId: Int
    patientId: Int
    status: String
    isComplianceVerified: Bool
    message: String
}

model TelemedicineConsultationSummaryDto {
    patientId: Int
    totalEntries: Int
    severityCategory: String
    lastReviewedTimestamp: Int
}
