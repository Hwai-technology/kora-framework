// Example 36: Telemedicine Virtual Clinic & E-Prescriptions
// Core Domain Service Implementation

import { TelemedicineConsultationClinicalEntity } from "../entities/telemedicine_consultation_primary.entity"
import { CreateTelemedicineConsultationRecordRequest } from "../models/telemedicine_consultation_request.dto"
import { TelemedicineConsultationRepository } from "../interfaces/telemedicine_consultation_repository.interface"
import { TelemedicineConsultationDomainContract } from "../interfaces/telemedicine_consultation_service.interface"

class TelemedicineConsultationCoreService implements TelemedicineConsultationDomainContract {
    repo: TelemedicineConsultationRepository

    init(repo: TelemedicineConsultationRepository) {
        this.repo = repo
    }

    fn processClinicalRecord(req: CreateTelemedicineConsultationRecordRequest) -> Result<TelemedicineConsultationClinicalEntity, String> {
        if req.patientId <= 0 {
            return Err("Patient ID must be strictly positive")
        }
        if req.clinicalMetricScore < 0 {
            return Err("Clinical metric score cannot be negative")
        }

        let entity = TelemedicineConsultationClinicalEntity {
            id: req.patientId + 5000,
            patientId: req.patientId,
            clinicianId: req.clinicianId,
            clinicalMetricScore: req.clinicalMetricScore,
            complianceState: "AUDITED_SECURE",
            active: true,
        }
        return this.repo.save(entity)
    }

    fn evaluateClinicalRisk(patientId: Int) -> String {
        let opt = this.repo.findByPatientId(patientId)
        let isPresent = match opt {
            Some(r) => true,
            None => false,
        }
        if !isPresent {
            return "RECORD_NOT_FOUND"
        }
        let record = match opt {
            Some(r) => r,
            None => TelemedicineConsultationClinicalEntity { id: 0, patientId: 0, clinicianId: 0, clinicalMetricScore: 0, complianceState: "", active: false },
        }
        if record.clinicalMetricScore > 80 {
            return "CRITICAL_OBSERVATION"
        }
        if record.clinicalMetricScore > 40 {
            return "MODERATE_ATTENTION"
        }
        return "NOMINAL_STABLE"
    }
}
