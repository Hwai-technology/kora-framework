// Example 36: Telemedicine Virtual Clinic & E-Prescriptions
// Presentation Controller

import { CreateTelemedicineConsultationRecordRequest } from "../models/telemedicine_consultation_request.dto"
import { TelemedicineConsultationResponseDto } from "../models/telemedicine_consultation_response.dto"
import { TelemedicineConsultationClinicalEntity } from "../entities/telemedicine_consultation_primary.entity"
import { TelemedicineConsultationCoreService } from "../services/telemedicine_consultation_core.service"

class TelemedicineConsultationController {
    service: TelemedicineConsultationCoreService

    init(service: TelemedicineConsultationCoreService) {
        this.service = service
    }

    fn handleRecordSubmission(req: CreateTelemedicineConsultationRecordRequest) -> TelemedicineConsultationResponseDto {
        let outcome = this.service.processClinicalRecord(req)
        return match outcome {
            Ok(rec) => TelemedicineConsultationResponseDto {
                recordId: rec.id,
                patientId: rec.patientId,
                status: "COMMITTED_ENCRYPTED",
                isComplianceVerified: true,
                message: "Record persisted under HIPAA safety standards",
            },
            Err(reason) => TelemedicineConsultationResponseDto {
                recordId: -1,
                patientId: req.patientId,
                status: "REJECTED_VALIDATION_ERROR",
                isComplianceVerified: false,
                message: reason,
            },
        }
    }

    fn checkPatientRisk(patientId: Int) -> String {
        return this.service.evaluateClinicalRisk(patientId)
    }
}
