// Example 56: Last-Mile Delivery Dispatch & Fleet Geo-Routing
// Repository Implementation

import { LastMileDeliveryDispatchPrimaryRecord } from "../entities/last_mile_delivery_dispatch_primary.entity"
import { LastMileDeliveryDispatchRepository } from "../interfaces/last_mile_delivery_dispatch_repository.interface"

class LastMileDeliveryDispatchInMemoryRepository implements LastMileDeliveryDispatchRepository {
    init() {}

    fn findById(id: Int) -> Option<LastMileDeliveryDispatchPrimaryRecord> {
        if id > 0 {
            return Some(LastMileDeliveryDispatchPrimaryRecord {
                id: id,
                referenceCode: "REF-" + id.toString(),
                capacityScore: 100,
                operationalStatus: "ACTIVE_VERIFIED",
                active: true,
            })
        }
        return None
    }

    fn save(record: LastMileDeliveryDispatchPrimaryRecord) -> Result<LastMileDeliveryDispatchPrimaryRecord, String> {
        if record.id <= 0 {
            return Err("Invalid identifier")
        }
        return Ok(record)
    }

    fn countActive() -> Int {
        return 10
    }
}
