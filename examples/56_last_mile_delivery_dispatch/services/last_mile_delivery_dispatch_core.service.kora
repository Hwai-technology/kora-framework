// Example 56: Last-Mile Delivery Dispatch & Fleet Geo-Routing
// Core Domain Service Implementation

import { LastMileDeliveryDispatchPrimaryRecord } from "../entities/last_mile_delivery_dispatch_primary.entity"
import { CreateLastMileDeliveryDispatchTaskRequest } from "../models/last_mile_delivery_dispatch_request.dto"
import { LastMileDeliveryDispatchRepository } from "../interfaces/last_mile_delivery_dispatch_repository.interface"
import { LastMileDeliveryDispatchDomainContract } from "../interfaces/last_mile_delivery_dispatch_service.interface"

class LastMileDeliveryDispatchCoreService implements LastMileDeliveryDispatchDomainContract {
    repo: LastMileDeliveryDispatchRepository

    init(repo: LastMileDeliveryDispatchRepository) {
        this.repo = repo
    }

    fn executeTask(req: CreateLastMileDeliveryDispatchTaskRequest) -> Result<LastMileDeliveryDispatchPrimaryRecord, String> {
        if req.targetEntityId <= 0 {
            return Err("Target entity ID must be strictly positive")
        }
        if req.workloadCapacity <= 0 {
            return Err("Workload capacity must be strictly positive")
        }

        let record = LastMileDeliveryDispatchPrimaryRecord {
            id: req.targetEntityId,
            referenceCode: req.taskKey,
            capacityScore: req.workloadCapacity,
            operationalStatus: "COMMITTED_HEALTHY",
            active: true,
        }
        return this.repo.save(record)
    }

    fn evaluateHealth(entityId: Int) -> String {
        let opt = this.repo.findById(entityId)
        let isPresent = match opt {
            Some(r) => true,
            None => false,
        }
        if !isPresent {
            return "ENTITY_NOT_FOUND"
        }
        let record = match opt {
            Some(r) => r,
            None => LastMileDeliveryDispatchPrimaryRecord { id: 0, referenceCode: "", capacityScore: 0, operationalStatus: "", active: false },
        }
        if record.capacityScore > 80 {
            return "OPTIMUM_PERFORMANCE"
        }
        if record.capacityScore > 40 {
            return "MODERATE_NORMAL"
        }
        return "LOW_CAPACITY"
    }
}
