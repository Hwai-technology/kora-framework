// ============================================================================
// Unit Test Suite: Distributed Dynamo-Style Key-Value Store
// Verifies Consensus Invariants, Quorum Validation, and Heartbeats
// ============================================================================

import { CreateDistributedKvStoreTaskRequest } from "../models/distributed_kv_store_request.dto"
import { DistributedKvStoreClusterRepository } from "../repositories/distributed_kv_store_cluster.repository"
import { DistributedKvStoreCoreService } from "../services/distributed_kv_store_core.service"
import { DistributedKvStoreHeartbeatService } from "../services/distributed_kv_store_heartbeat.service"

class DistributedKvStoreUnitTestSuite {
    service: DistributedKvStoreCoreService
    heartbeat: DistributedKvStoreHeartbeatService

    init(service: DistributedKvStoreCoreService, heartbeat: DistributedKvStoreHeartbeatService) {
        this.service = service
        this.heartbeat = heartbeat
    }

    fn test_consensus_command_processing() -> Bool {
        let req = CreateDistributedKvStoreTaskRequest {
            taskKey: "TASK-REPLICATE-101",
            originatingNodeId: 1,
            payloadVolume: 500,
            targetCluster: "ProductionClusterEast",
        }
        let res = this.service.processConsensusCommand(req)
        return match res {
            Ok(state) => state.id == 1 && state.isLeader,
            Err(e) => false,
        }
    }

    fn test_invalid_originating_node_rejected() -> Bool {
        let req = CreateDistributedKvStoreTaskRequest {
            taskKey: "TASK-INVALID",
            originatingNodeId: -1,
            payloadVolume: 100,
            targetCluster: "ProductionClusterEast",
        }
        let res = this.service.processConsensusCommand(req)
        return match res {
            Ok(s) => false,
            Err(e) => e == "Originating node ID must be strictly positive",
        }
    }

    fn test_quorum_evaluation() -> Bool {
        return this.service.evaluateClusterQuorum()
    }

    fn test_heartbeat_ping() -> Bool {
        return this.heartbeat.pingPeer(2)
    }

    fn run() -> Unit {
        let t1 = this.test_consensus_command_processing()
        let t2 = this.test_invalid_originating_node_rejected()
        let t3 = this.test_quorum_evaluation()
        let t4 = this.test_heartbeat_ping()

        if t1 && t2 && t3 && t4 {
            print("  ✓ Distributed Dynamo-Style Key-Value Store Unit Tests: 4/4 passed (Quorum, Invariants & Heartbeats Verified)")
        } else {
            print("  ✗ Distributed Dynamo-Style Key-Value Store Unit Tests: failed")
        }
    }
}

let repo = DistributedKvStoreClusterRepository()
let service = DistributedKvStoreCoreService(repo)
let heartbeat = DistributedKvStoreHeartbeatService()
let suite = DistributedKvStoreUnitTestSuite(service, heartbeat)
suite.run()
