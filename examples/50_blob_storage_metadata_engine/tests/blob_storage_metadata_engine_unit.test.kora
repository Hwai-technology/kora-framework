// ============================================================================
// Unit Test Suite: Distributed Blob Storage Metadata Engine
// Verifies Consensus Invariants, Quorum Validation, and Heartbeats
// ============================================================================

import { CreateBlobStorageMetadataEngineTaskRequest } from "../models/blob_storage_metadata_engine_request.dto"
import { BlobStorageMetadataEngineClusterRepository } from "../repositories/blob_storage_metadata_engine_cluster.repository"
import { BlobStorageMetadataEngineCoreService } from "../services/blob_storage_metadata_engine_core.service"
import { BlobStorageMetadataEngineHeartbeatService } from "../services/blob_storage_metadata_engine_heartbeat.service"

class BlobStorageMetadataEngineUnitTestSuite {
    service: BlobStorageMetadataEngineCoreService
    heartbeat: BlobStorageMetadataEngineHeartbeatService

    init(service: BlobStorageMetadataEngineCoreService, heartbeat: BlobStorageMetadataEngineHeartbeatService) {
        this.service = service
        this.heartbeat = heartbeat
    }

    fn test_consensus_command_processing() -> Bool {
        let req = CreateBlobStorageMetadataEngineTaskRequest {
            taskKey: "TASK-REPLICATE-101",
            originatingNodeId: 1,
            payloadVolume: 500,
            targetCluster: "ProductionClusterEast",
        }
        let res = this.service.processConsensusCommand(req)
        return match res {
            Ok(state) => state.id == 1 && state.isLeader,
            Err(e) => false,
        }
    }

    fn test_invalid_originating_node_rejected() -> Bool {
        let req = CreateBlobStorageMetadataEngineTaskRequest {
            taskKey: "TASK-INVALID",
            originatingNodeId: -1,
            payloadVolume: 100,
            targetCluster: "ProductionClusterEast",
        }
        let res = this.service.processConsensusCommand(req)
        return match res {
            Ok(s) => false,
            Err(e) => e == "Originating node ID must be strictly positive",
        }
    }

    fn test_quorum_evaluation() -> Bool {
        return this.service.evaluateClusterQuorum()
    }

    fn test_heartbeat_ping() -> Bool {
        return this.heartbeat.pingPeer(2)
    }

    fn run() -> Unit {
        let t1 = this.test_consensus_command_processing()
        let t2 = this.test_invalid_originating_node_rejected()
        let t3 = this.test_quorum_evaluation()
        let t4 = this.test_heartbeat_ping()

        if t1 && t2 && t3 && t4 {
            print("  ✓ Distributed Blob Storage Metadata Engine Unit Tests: 4/4 passed (Quorum, Invariants & Heartbeats Verified)")
        } else {
            print("  ✗ Distributed Blob Storage Metadata Engine Unit Tests: failed")
        }
    }
}

let repo = BlobStorageMetadataEngineClusterRepository()
let service = BlobStorageMetadataEngineCoreService(repo)
let heartbeat = BlobStorageMetadataEngineHeartbeatService()
let suite = BlobStorageMetadataEngineUnitTestSuite(service, heartbeat)
suite.run()
