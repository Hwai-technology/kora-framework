// Example 50: Distributed Blob Storage Metadata Engine
// Persistent Database Entity: Replicated Log

@table("blob_storage_metadata_engine_replicated_logs")
model BlobStorageMetadataEngineReplicatedLogEntry {
    @id
    id: Int
    logIndex: Int
    termNumber: Int
    commandPayload: String
    committedQuorum: Bool
    timestamp: Int
}
