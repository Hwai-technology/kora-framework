// Example 79: Multimodal CLIP Cross-Search Engine
// Presentation Controller

import { CreateMultimodalClipSearchTaskRequest } from "../models/multimodal_clip_search_request.dto"
import { MultimodalClipSearchResponseDto } from "../models/multimodal_clip_search_response.dto"
import { MultimodalClipSearchCoreService } from "../services/multimodal_clip_search_core.service"

class MultimodalClipSearchController {
    service: MultimodalClipSearchCoreService

    init(service: MultimodalClipSearchCoreService) {
        this.service = service
    }

    fn handleTaskSubmission(req: CreateMultimodalClipSearchTaskRequest) -> MultimodalClipSearchResponseDto {
        let outcome = this.service.executeTask(req)
        return match outcome {
            Ok(rec) => MultimodalClipSearchResponseDto {
                operationId: "TX-" + req.taskKey,
                entityId: rec.id,
                status: "EXECUTION_SUCCESSFUL",
                isVerified: true,
                message: "Operation completed under Clean Architecture invariants",
            },
            Err(reason) => MultimodalClipSearchResponseDto {
                operationId: "TX-FAILED",
                entityId: req.targetEntityId,
                status: "EXECUTION_REJECTED",
                isVerified: false,
                message: reason,
            },
        }
    }

    fn inspectHealth(entityId: Int) -> String {
        return this.service.evaluateHealth(entityId)
    }
}
