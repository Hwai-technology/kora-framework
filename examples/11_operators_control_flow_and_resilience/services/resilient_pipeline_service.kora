// ============================================================================
// Service: ResilientPipelineService (Demonstrating Phase 6 Operators & Try/Catch)
// ============================================================================

import { PipelineJobRequest, PipelineJobSummary } from "../models/system_config"
import { ResilientPipelineContract } from "../interfaces/pipeline_interface"

const DEFAULT_TIMEOUT_SECONDS: Int = 30
const DEFAULT_RETRIES: Int = 3

class ResilientPipelineService implements ResilientPipelineContract {
    init() {}

    fn calculateBackoff(attempt: Int) -> Int {
        var delay = 100
        delay *= attempt
        return delay
    }

    fn executeBatchJob(request: PipelineJobRequest) -> PipelineJobSummary {
        // 1. Nullish Coalescing (??) provides safe defaults without arbitrary guessing
        let effectiveTimeout = request.timeoutSeconds ?? DEFAULT_TIMEOUT_SECONDS
        let effectiveRetries = request.retryAttempts ?? DEFAULT_RETRIES

        var processedCount = 0
        var totalDuration = 0
        var lastError: Option<String> = null

        // 2. Automated Try/Catch/Finally Resilience
        try {
            if request.payloads.isEmpty() {
                throw "Cannot process empty batch payloads"
            }

            // 3. For-In Loop with Control Flow (continue, break, +=)
            for item in request.payloads {
                if item == "SKIP" {
                    continue
                }

                if item == "POISON_PILL" {
                    throw "Encountered corrupted payload token"
                }

                // 4. Compound Assignment (+=)
                processedCount += 1
                totalDuration += 25

                if processedCount >= request.batchSize {
                    break
                }
            }
        } catch (err) {
            lastError = Some(err)
        } finally {
            // Guarantee resource cleanup or telemetry recording
            totalDuration += effectiveTimeout
        }

        let isSuccess = lastError == null
        return PipelineJobSummary {
            jobName: request.jobName,
            processedItems: processedCount,
            totalDurationMs: totalDuration,
            isSuccessful: isSuccess,
            errorMessage: lastError,
        }
    }
}
