// ============================================================================
// Example 11: Operators, Control Flow & Resilient Try/Catch Error Handling
// Demonstrates Phase 6 features: ??, +=, -=, for-in, break, continue, try/catch/finally
// Routing delegated to dedicated PipelineRouter class
// ============================================================================

import { PipelineRouter } from "./routes/pipeline.routes"

let app = run()

// 1. Resilient Job Execution Endpoint with Automatic Error Guarding
post("/api/v1/jobs/execute", (router: PipelineRouter) => {
    let summary = router.executeSampleJob()
    return send(summary)
})

// 2. Health & Resilience Diagnostics Endpoint
get("/api/v1/jobs/health", (router: PipelineRouter) => {
    return router.health()
})
