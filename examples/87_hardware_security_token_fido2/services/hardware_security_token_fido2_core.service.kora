// Example 87: FIDO2 / WebAuthn Passkey Registration & Attestation
// Core Domain Service Implementation

import { HardwareSecurityTokenFido2PrimaryRecord } from "../entities/hardware_security_token_fido2_primary.entity"
import { CreateHardwareSecurityTokenFido2TaskRequest } from "../models/hardware_security_token_fido2_request.dto"
import { HardwareSecurityTokenFido2Repository } from "../interfaces/hardware_security_token_fido2_repository.interface"
import { HardwareSecurityTokenFido2DomainContract } from "../interfaces/hardware_security_token_fido2_service.interface"

class HardwareSecurityTokenFido2CoreService implements HardwareSecurityTokenFido2DomainContract {
    repo: HardwareSecurityTokenFido2Repository

    init(repo: HardwareSecurityTokenFido2Repository) {
        this.repo = repo
    }

    fn executeTask(req: CreateHardwareSecurityTokenFido2TaskRequest) -> Result<HardwareSecurityTokenFido2PrimaryRecord, String> {
        if req.targetEntityId <= 0 {
            return Err("Target entity ID must be strictly positive")
        }
        if req.workloadCapacity <= 0 {
            return Err("Workload capacity must be strictly positive")
        }

        let record = HardwareSecurityTokenFido2PrimaryRecord {
            id: req.targetEntityId,
            referenceCode: req.taskKey,
            capacityScore: req.workloadCapacity,
            operationalStatus: "COMMITTED_HEALTHY",
            active: true,
        }
        return this.repo.save(record)
    }

    fn evaluateHealth(entityId: Int) -> String {
        let opt = this.repo.findById(entityId)
        let isPresent = match opt {
            Some(r) => true,
            None => false,
        }
        if !isPresent {
            return "ENTITY_NOT_FOUND"
        }
        let record = match opt {
            Some(r) => r,
            None => HardwareSecurityTokenFido2PrimaryRecord { id: 0, referenceCode: "", capacityScore: 0, operationalStatus: "", active: false },
        }
        if record.capacityScore > 80 {
            return "OPTIMUM_PERFORMANCE"
        }
        if record.capacityScore > 40 {
            return "MODERATE_NORMAL"
        }
        return "LOW_CAPACITY"
    }
}
