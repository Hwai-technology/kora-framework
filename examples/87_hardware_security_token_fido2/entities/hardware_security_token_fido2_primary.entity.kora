// Example 87: FIDO2 / WebAuthn Passkey Registration & Attestation
// Persistent Database Entity: Primary Record

@table("hardware_security_token_fido2_records")
model HardwareSecurityTokenFido2PrimaryRecord {
    @id
    id: Int
    @unique
    referenceCode: String
    capacityScore: Int
    operationalStatus: String
    active: Bool
}
