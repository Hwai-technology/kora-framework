// ============================================================================
// Unit Test Suite: Live Audio Transcoding & Packet Chunking Pipeline
// Verifies Domain Invariants, Boundary Calculations & Liveness
// ============================================================================

import { CreateLiveAudioTranscoderPipelineTaskRequest } from "../models/live_audio_transcoder_pipeline_request.dto"
import { LiveAudioTranscoderPipelineInMemoryRepository } from "../repositories/live_audio_transcoder_pipeline_inmemory.repository"
import { LiveAudioTranscoderPipelineCoreService } from "../services/live_audio_transcoder_pipeline_core.service"
import { LiveAudioTranscoderPipelineTelemetryService } from "../services/live_audio_transcoder_pipeline_telemetry.service"

class LiveAudioTranscoderPipelineUnitTestSuite {
    service: LiveAudioTranscoderPipelineCoreService
    telemetry: LiveAudioTranscoderPipelineTelemetryService

    init(service: LiveAudioTranscoderPipelineCoreService, telemetry: LiveAudioTranscoderPipelineTelemetryService) {
        this.service = service
        this.telemetry = telemetry
    }

    fn test_valid_task_execution() -> Bool {
        let req = CreateLiveAudioTranscoderPipelineTaskRequest {
            taskKey: "UNIT-TASK-101",
            targetEntityId: 10,
            workloadCapacity: 95,
            domainContext: "Media & Realtime",
        }
        let res = this.service.executeTask(req)
        return match res {
            Ok(rec) => rec.id == 10 && rec.capacityScore == 95,
            Err(e) => false,
        }
    }

    fn test_invalid_negative_target_rejected() -> Bool {
        let req = CreateLiveAudioTranscoderPipelineTaskRequest {
            taskKey: "INVALID-TASK",
            targetEntityId: -1,
            workloadCapacity: 50,
            domainContext: "Media & Realtime",
        }
        let res = this.service.executeTask(req)
        return match res {
            Ok(r) => false,
            Err(e) => e == "Target entity ID must be strictly positive",
        }
    }

    fn test_health_evaluation() -> Bool {
        let health = this.service.evaluateHealth(10)
        return health == "OPTIMUM_PERFORMANCE" || health == "MODERATE_NORMAL"
    }

    fn test_telemetry_ping() -> Bool {
        return this.telemetry.ping()
    }

    fn run() -> Unit {
        let t1 = this.test_valid_task_execution()
        let t2 = this.test_invalid_negative_target_rejected()
        let t3 = this.test_health_evaluation()
        let t4 = this.test_telemetry_ping()

        if t1 && t2 && t3 && t4 {
            print("  ✓ Live Audio Transcoding & Packet Chunking Pipeline Unit Tests: 4/4 passed (Domain Invariants Verified)")
        } else {
            print("  ✗ Live Audio Transcoding & Packet Chunking Pipeline Unit Tests: failed")
        }
    }
}

let repo = LiveAudioTranscoderPipelineInMemoryRepository()
let service = LiveAudioTranscoderPipelineCoreService(repo)
let telemetry = LiveAudioTranscoderPipelineTelemetryService()
let suite = LiveAudioTranscoderPipelineUnitTestSuite(service, telemetry)
suite.run()
