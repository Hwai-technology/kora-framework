// Example 93: Live Audio Transcoding & Packet Chunking Pipeline
// Core Domain Service Implementation

import { LiveAudioTranscoderPipelinePrimaryRecord } from "../entities/live_audio_transcoder_pipeline_primary.entity"
import { CreateLiveAudioTranscoderPipelineTaskRequest } from "../models/live_audio_transcoder_pipeline_request.dto"
import { LiveAudioTranscoderPipelineRepository } from "../interfaces/live_audio_transcoder_pipeline_repository.interface"
import { LiveAudioTranscoderPipelineDomainContract } from "../interfaces/live_audio_transcoder_pipeline_service.interface"

class LiveAudioTranscoderPipelineCoreService implements LiveAudioTranscoderPipelineDomainContract {
    repo: LiveAudioTranscoderPipelineRepository

    init(repo: LiveAudioTranscoderPipelineRepository) {
        this.repo = repo
    }

    fn executeTask(req: CreateLiveAudioTranscoderPipelineTaskRequest) -> Result<LiveAudioTranscoderPipelinePrimaryRecord, String> {
        if req.targetEntityId <= 0 {
            return Err("Target entity ID must be strictly positive")
        }
        if req.workloadCapacity <= 0 {
            return Err("Workload capacity must be strictly positive")
        }

        let record = LiveAudioTranscoderPipelinePrimaryRecord {
            id: req.targetEntityId,
            referenceCode: req.taskKey,
            capacityScore: req.workloadCapacity,
            operationalStatus: "COMMITTED_HEALTHY",
            active: true,
        }
        return this.repo.save(record)
    }

    fn evaluateHealth(entityId: Int) -> String {
        let opt = this.repo.findById(entityId)
        let isPresent = match opt {
            Some(r) => true,
            None => false,
        }
        if !isPresent {
            return "ENTITY_NOT_FOUND"
        }
        let record = match opt {
            Some(r) => r,
            None => LiveAudioTranscoderPipelinePrimaryRecord { id: 0, referenceCode: "", capacityScore: 0, operationalStatus: "", active: false },
        }
        if record.capacityScore > 80 {
            return "OPTIMUM_PERFORMANCE"
        }
        if record.capacityScore > 40 {
            return "MODERATE_NORMAL"
        }
        return "LOW_CAPACITY"
    }
}
