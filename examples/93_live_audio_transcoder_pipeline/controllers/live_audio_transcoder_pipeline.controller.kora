// Example 93: Live Audio Transcoding & Packet Chunking Pipeline
// Presentation Controller

import { CreateLiveAudioTranscoderPipelineTaskRequest } from "../models/live_audio_transcoder_pipeline_request.dto"
import { LiveAudioTranscoderPipelineResponseDto } from "../models/live_audio_transcoder_pipeline_response.dto"
import { LiveAudioTranscoderPipelineCoreService } from "../services/live_audio_transcoder_pipeline_core.service"

class LiveAudioTranscoderPipelineController {
    service: LiveAudioTranscoderPipelineCoreService

    init(service: LiveAudioTranscoderPipelineCoreService) {
        this.service = service
    }

    fn handleTaskSubmission(req: CreateLiveAudioTranscoderPipelineTaskRequest) -> LiveAudioTranscoderPipelineResponseDto {
        let outcome = this.service.executeTask(req)
        return match outcome {
            Ok(rec) => LiveAudioTranscoderPipelineResponseDto {
                operationId: "TX-" + req.taskKey,
                entityId: rec.id,
                status: "EXECUTION_SUCCESSFUL",
                isVerified: true,
                message: "Operation completed under Clean Architecture invariants",
            },
            Err(reason) => LiveAudioTranscoderPipelineResponseDto {
                operationId: "TX-FAILED",
                entityId: req.targetEntityId,
                status: "EXECUTION_REJECTED",
                isVerified: false,
                message: reason,
            },
        }
    }

    fn inspectHealth(entityId: Int) -> String {
        return this.service.evaluateHealth(entityId)
    }
}
