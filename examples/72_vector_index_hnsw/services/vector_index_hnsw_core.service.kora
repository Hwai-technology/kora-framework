// Example 72: HNSW Vector Index & Approximate Nearest Neighbor
// Core Domain Service Implementation

import { VectorIndexHnswPrimaryRecord } from "../entities/vector_index_hnsw_primary.entity"
import { CreateVectorIndexHnswTaskRequest } from "../models/vector_index_hnsw_request.dto"
import { VectorIndexHnswRepository } from "../interfaces/vector_index_hnsw_repository.interface"
import { VectorIndexHnswDomainContract } from "../interfaces/vector_index_hnsw_service.interface"

class VectorIndexHnswCoreService implements VectorIndexHnswDomainContract {
    repo: VectorIndexHnswRepository

    init(repo: VectorIndexHnswRepository) {
        this.repo = repo
    }

    fn executeTask(req: CreateVectorIndexHnswTaskRequest) -> Result<VectorIndexHnswPrimaryRecord, String> {
        if req.targetEntityId <= 0 {
            return Err("Target entity ID must be strictly positive")
        }
        if req.workloadCapacity <= 0 {
            return Err("Workload capacity must be strictly positive")
        }

        let record = VectorIndexHnswPrimaryRecord {
            id: req.targetEntityId,
            referenceCode: req.taskKey,
            capacityScore: req.workloadCapacity,
            operationalStatus: "COMMITTED_HEALTHY",
            active: true,
        }
        return this.repo.save(record)
    }

    fn evaluateHealth(entityId: Int) -> String {
        let opt = this.repo.findById(entityId)
        let isPresent = match opt {
            Some(r) => true,
            None => false,
        }
        if !isPresent {
            return "ENTITY_NOT_FOUND"
        }
        let record = match opt {
            Some(r) => r,
            None => VectorIndexHnswPrimaryRecord { id: 0, referenceCode: "", capacityScore: 0, operationalStatus: "", active: false },
        }
        if record.capacityScore > 80 {
            return "OPTIMUM_PERFORMANCE"
        }
        if record.capacityScore > 40 {
            return "MODERATE_NORMAL"
        }
        return "LOW_CAPACITY"
    }
}
