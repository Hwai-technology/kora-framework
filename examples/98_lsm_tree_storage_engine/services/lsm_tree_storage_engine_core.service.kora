// Example 98: Log-Structured Merge-Tree (LSM-Tree) Engine
// Core Domain Service Implementation

import { LsmTreeStorageEnginePrimaryRecord } from "../entities/lsm_tree_storage_engine_primary.entity"
import { CreateLsmTreeStorageEngineTaskRequest } from "../models/lsm_tree_storage_engine_request.dto"
import { LsmTreeStorageEngineRepository } from "../interfaces/lsm_tree_storage_engine_repository.interface"
import { LsmTreeStorageEngineDomainContract } from "../interfaces/lsm_tree_storage_engine_service.interface"

class LsmTreeStorageEngineCoreService implements LsmTreeStorageEngineDomainContract {
    repo: LsmTreeStorageEngineRepository

    init(repo: LsmTreeStorageEngineRepository) {
        this.repo = repo
    }

    fn executeTask(req: CreateLsmTreeStorageEngineTaskRequest) -> Result<LsmTreeStorageEnginePrimaryRecord, String> {
        if req.targetEntityId <= 0 {
            return Err("Target entity ID must be strictly positive")
        }
        if req.workloadCapacity <= 0 {
            return Err("Workload capacity must be strictly positive")
        }

        let record = LsmTreeStorageEnginePrimaryRecord {
            id: req.targetEntityId,
            referenceCode: req.taskKey,
            capacityScore: req.workloadCapacity,
            operationalStatus: "COMMITTED_HEALTHY",
            active: true,
        }
        return this.repo.save(record)
    }

    fn evaluateHealth(entityId: Int) -> String {
        let opt = this.repo.findById(entityId)
        let isPresent = match opt {
            Some(r) => true,
            None => false,
        }
        if !isPresent {
            return "ENTITY_NOT_FOUND"
        }
        let record = match opt {
            Some(r) => r,
            None => LsmTreeStorageEnginePrimaryRecord { id: 0, referenceCode: "", capacityScore: 0, operationalStatus: "", active: false },
        }
        if record.capacityScore > 80 {
            return "OPTIMUM_PERFORMANCE"
        }
        if record.capacityScore > 40 {
            return "MODERATE_NORMAL"
        }
        return "LOW_CAPACITY"
    }
}
