// ============================================================================
// Unit Test Suite: Log-Structured Merge-Tree (LSM-Tree) Engine
// Verifies Domain Invariants, Boundary Calculations & Liveness
// ============================================================================

import { CreateLsmTreeStorageEngineTaskRequest } from "../models/lsm_tree_storage_engine_request.dto"
import { LsmTreeStorageEngineInMemoryRepository } from "../repositories/lsm_tree_storage_engine_inmemory.repository"
import { LsmTreeStorageEngineCoreService } from "../services/lsm_tree_storage_engine_core.service"
import { LsmTreeStorageEngineTelemetryService } from "../services/lsm_tree_storage_engine_telemetry.service"

class LsmTreeStorageEngineUnitTestSuite {
    service: LsmTreeStorageEngineCoreService
    telemetry: LsmTreeStorageEngineTelemetryService

    init(service: LsmTreeStorageEngineCoreService, telemetry: LsmTreeStorageEngineTelemetryService) {
        this.service = service
        this.telemetry = telemetry
    }

    fn test_valid_task_execution() -> Bool {
        let req = CreateLsmTreeStorageEngineTaskRequest {
            taskKey: "UNIT-TASK-101",
            targetEntityId: 10,
            workloadCapacity: 95,
            domainContext: "Algorithms & Kernels",
        }
        let res = this.service.executeTask(req)
        return match res {
            Ok(rec) => rec.id == 10 && rec.capacityScore == 95,
            Err(e) => false,
        }
    }

    fn test_invalid_negative_target_rejected() -> Bool {
        let req = CreateLsmTreeStorageEngineTaskRequest {
            taskKey: "INVALID-TASK",
            targetEntityId: -1,
            workloadCapacity: 50,
            domainContext: "Algorithms & Kernels",
        }
        let res = this.service.executeTask(req)
        return match res {
            Ok(r) => false,
            Err(e) => e == "Target entity ID must be strictly positive",
        }
    }

    fn test_health_evaluation() -> Bool {
        let health = this.service.evaluateHealth(10)
        return health == "OPTIMUM_PERFORMANCE" || health == "MODERATE_NORMAL"
    }

    fn test_telemetry_ping() -> Bool {
        return this.telemetry.ping()
    }

    fn run() -> Unit {
        let t1 = this.test_valid_task_execution()
        let t2 = this.test_invalid_negative_target_rejected()
        let t3 = this.test_health_evaluation()
        let t4 = this.test_telemetry_ping()

        if t1 && t2 && t3 && t4 {
            print("  ✓ Log-Structured Merge-Tree (LSM-Tree) Engine Unit Tests: 4/4 passed (Domain Invariants Verified)")
        } else {
            print("  ✗ Log-Structured Merge-Tree (LSM-Tree) Engine Unit Tests: failed")
        }
    }
}

let repo = LsmTreeStorageEngineInMemoryRepository()
let service = LsmTreeStorageEngineCoreService(repo)
let telemetry = LsmTreeStorageEngineTelemetryService()
let suite = LsmTreeStorageEngineUnitTestSuite(service, telemetry)
suite.run()
