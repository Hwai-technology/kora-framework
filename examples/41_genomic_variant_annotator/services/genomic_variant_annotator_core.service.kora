// Example 41: Genomic Variant Annotation & Pathogenicity
// Core Domain Service Implementation

import { GenomicVariantAnnotatorClinicalEntity } from "../entities/genomic_variant_annotator_primary.entity"
import { CreateGenomicVariantAnnotatorRecordRequest } from "../models/genomic_variant_annotator_request.dto"
import { GenomicVariantAnnotatorRepository } from "../interfaces/genomic_variant_annotator_repository.interface"
import { GenomicVariantAnnotatorDomainContract } from "../interfaces/genomic_variant_annotator_service.interface"

class GenomicVariantAnnotatorCoreService implements GenomicVariantAnnotatorDomainContract {
    repo: GenomicVariantAnnotatorRepository

    init(repo: GenomicVariantAnnotatorRepository) {
        this.repo = repo
    }

    fn processClinicalRecord(req: CreateGenomicVariantAnnotatorRecordRequest) -> Result<GenomicVariantAnnotatorClinicalEntity, String> {
        if req.patientId <= 0 {
            return Err("Patient ID must be strictly positive")
        }
        if req.clinicalMetricScore < 0 {
            return Err("Clinical metric score cannot be negative")
        }

        let entity = GenomicVariantAnnotatorClinicalEntity {
            id: req.patientId + 5000,
            patientId: req.patientId,
            clinicianId: req.clinicianId,
            clinicalMetricScore: req.clinicalMetricScore,
            complianceState: "AUDITED_SECURE",
            active: true,
        }
        return this.repo.save(entity)
    }

    fn evaluateClinicalRisk(patientId: Int) -> String {
        let opt = this.repo.findByPatientId(patientId)
        let isPresent = match opt {
            Some(r) => true,
            None => false,
        }
        if !isPresent {
            return "RECORD_NOT_FOUND"
        }
        let record = match opt {
            Some(r) => r,
            None => GenomicVariantAnnotatorClinicalEntity { id: 0, patientId: 0, clinicianId: 0, clinicalMetricScore: 0, complianceState: "", active: false },
        }
        if record.clinicalMetricScore > 80 {
            return "CRITICAL_OBSERVATION"
        }
        if record.clinicalMetricScore > 40 {
            return "MODERATE_ATTENTION"
        }
        return "NOMINAL_STABLE"
    }
}
