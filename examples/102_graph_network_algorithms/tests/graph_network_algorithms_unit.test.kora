// ============================================================================
// Unit Test Suite: Graph Algorithms & Tarjan SCC / PageRank
// Verifies Domain Invariants, Boundary Calculations & Liveness
// ============================================================================

import { CreateGraphNetworkAlgorithmsTaskRequest } from "../models/graph_network_algorithms_request.dto"
import { GraphNetworkAlgorithmsInMemoryRepository } from "../repositories/graph_network_algorithms_inmemory.repository"
import { GraphNetworkAlgorithmsCoreService } from "../services/graph_network_algorithms_core.service"
import { GraphNetworkAlgorithmsTelemetryService } from "../services/graph_network_algorithms_telemetry.service"

class GraphNetworkAlgorithmsUnitTestSuite {
    service: GraphNetworkAlgorithmsCoreService
    telemetry: GraphNetworkAlgorithmsTelemetryService

    init(service: GraphNetworkAlgorithmsCoreService, telemetry: GraphNetworkAlgorithmsTelemetryService) {
        this.service = service
        this.telemetry = telemetry
    }

    fn test_valid_task_execution() -> Bool {
        let req = CreateGraphNetworkAlgorithmsTaskRequest {
            taskKey: "UNIT-TASK-101",
            targetEntityId: 10,
            workloadCapacity: 95,
            domainContext: "Algorithms & Kernels",
        }
        let res = this.service.executeTask(req)
        return match res {
            Ok(rec) => rec.id == 10 && rec.capacityScore == 95,
            Err(e) => false,
        }
    }

    fn test_invalid_negative_target_rejected() -> Bool {
        let req = CreateGraphNetworkAlgorithmsTaskRequest {
            taskKey: "INVALID-TASK",
            targetEntityId: -1,
            workloadCapacity: 50,
            domainContext: "Algorithms & Kernels",
        }
        let res = this.service.executeTask(req)
        return match res {
            Ok(r) => false,
            Err(e) => e == "Target entity ID must be strictly positive",
        }
    }

    fn test_health_evaluation() -> Bool {
        let health = this.service.evaluateHealth(10)
        return health == "OPTIMUM_PERFORMANCE" || health == "MODERATE_NORMAL"
    }

    fn test_telemetry_ping() -> Bool {
        return this.telemetry.ping()
    }

    fn run() -> Unit {
        let t1 = this.test_valid_task_execution()
        let t2 = this.test_invalid_negative_target_rejected()
        let t3 = this.test_health_evaluation()
        let t4 = this.test_telemetry_ping()

        if t1 && t2 && t3 && t4 {
            print("  ✓ Graph Algorithms & Tarjan SCC / PageRank Unit Tests: 4/4 passed (Domain Invariants Verified)")
        } else {
            print("  ✗ Graph Algorithms & Tarjan SCC / PageRank Unit Tests: failed")
        }
    }
}

let repo = GraphNetworkAlgorithmsInMemoryRepository()
let service = GraphNetworkAlgorithmsCoreService(repo)
let telemetry = GraphNetworkAlgorithmsTelemetryService()
let suite = GraphNetworkAlgorithmsUnitTestSuite(service, telemetry)
suite.run()
