// Example 102: Graph Algorithms & Tarjan SCC / PageRank
// Core Domain Service Implementation

import { GraphNetworkAlgorithmsPrimaryRecord } from "../entities/graph_network_algorithms_primary.entity"
import { CreateGraphNetworkAlgorithmsTaskRequest } from "../models/graph_network_algorithms_request.dto"
import { GraphNetworkAlgorithmsRepository } from "../interfaces/graph_network_algorithms_repository.interface"
import { GraphNetworkAlgorithmsDomainContract } from "../interfaces/graph_network_algorithms_service.interface"

class GraphNetworkAlgorithmsCoreService implements GraphNetworkAlgorithmsDomainContract {
    repo: GraphNetworkAlgorithmsRepository

    init(repo: GraphNetworkAlgorithmsRepository) {
        this.repo = repo
    }

    fn executeTask(req: CreateGraphNetworkAlgorithmsTaskRequest) -> Result<GraphNetworkAlgorithmsPrimaryRecord, String> {
        if req.targetEntityId <= 0 {
            return Err("Target entity ID must be strictly positive")
        }
        if req.workloadCapacity <= 0 {
            return Err("Workload capacity must be strictly positive")
        }

        let record = GraphNetworkAlgorithmsPrimaryRecord {
            id: req.targetEntityId,
            referenceCode: req.taskKey,
            capacityScore: req.workloadCapacity,
            operationalStatus: "COMMITTED_HEALTHY",
            active: true,
        }
        return this.repo.save(record)
    }

    fn evaluateHealth(entityId: Int) -> String {
        let opt = this.repo.findById(entityId)
        let isPresent = match opt {
            Some(r) => true,
            None => false,
        }
        if !isPresent {
            return "ENTITY_NOT_FOUND"
        }
        let record = match opt {
            Some(r) => r,
            None => GraphNetworkAlgorithmsPrimaryRecord { id: 0, referenceCode: "", capacityScore: 0, operationalStatus: "", active: false },
        }
        if record.capacityScore > 80 {
            return "OPTIMUM_PERFORMANCE"
        }
        if record.capacityScore > 40 {
            return "MODERATE_NORMAL"
        }
        return "LOW_CAPACITY"
    }
}
