// ============================================================================
// Example 02: Clean Architecture Users API
// ============================================================================

import { User } from "./models/user_models"
import { UserService } from "./services/user_service"

let app = run()

get("/users", () => {
    return User.all()
})

get("/users/{id}", (id: Int, service: UserService) => {
    return service.findById(id)
})

post("/users", (request: Request, service: UserService) => {
    let candidate = User {
        id: 1,
        name: request.body,
        email: "new@kora.dev",
        active: true,
    }
    let checked = service.validateNewUser(candidate)
    return send(checked)
})

