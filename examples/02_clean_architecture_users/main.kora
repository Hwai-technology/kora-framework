// ============================================================================
// Example 02: Clean Architecture Users API — Main Entrypoint
// ============================================================================

import { UserRouter } from "./routes/user.routes"

let app = run()

get("/users", (routes: UserRouter) => {
    return routes.listUsers()
})

get("/users/{id}", (id: Int, routes: UserRouter) => {
    return routes.getUser(id)
})

post("/users", (request: Request, routes: UserRouter) => {
    return routes.createUser(request.body)
})
