// Example 47: Cloud Event Bus & Partitioned Streaming
// Transport Model: Standard Response

model CloudEventBusResponseDto {
    operationId: String
    nodeId: Int
    status: String
    isQuorumSatisfied: Bool
    message: String
}

model CloudEventBusTopologySummaryDto {
    activeClusterNodes: Int
    leaderTerm: Int
    healthyReplicasCount: Int
    clusterState: String
}
