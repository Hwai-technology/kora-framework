// ============================================================================
// Unit Test Suite: Cloud Event Bus & Partitioned Streaming
// Verifies Consensus Invariants, Quorum Validation, and Heartbeats
// ============================================================================

import { CreateCloudEventBusTaskRequest } from "../models/cloud_event_bus_request.dto"
import { CloudEventBusClusterRepository } from "../repositories/cloud_event_bus_cluster.repository"
import { CloudEventBusCoreService } from "../services/cloud_event_bus_core.service"
import { CloudEventBusHeartbeatService } from "../services/cloud_event_bus_heartbeat.service"

class CloudEventBusUnitTestSuite {
    service: CloudEventBusCoreService
    heartbeat: CloudEventBusHeartbeatService

    init(service: CloudEventBusCoreService, heartbeat: CloudEventBusHeartbeatService) {
        this.service = service
        this.heartbeat = heartbeat
    }

    fn test_consensus_command_processing() -> Bool {
        let req = CreateCloudEventBusTaskRequest {
            taskKey: "TASK-REPLICATE-101",
            originatingNodeId: 1,
            payloadVolume: 500,
            targetCluster: "ProductionClusterEast",
        }
        let res = this.service.processConsensusCommand(req)
        return match res {
            Ok(state) => state.id == 1 && state.isLeader,
            Err(e) => false,
        }
    }

    fn test_invalid_originating_node_rejected() -> Bool {
        let req = CreateCloudEventBusTaskRequest {
            taskKey: "TASK-INVALID",
            originatingNodeId: -1,
            payloadVolume: 100,
            targetCluster: "ProductionClusterEast",
        }
        let res = this.service.processConsensusCommand(req)
        return match res {
            Ok(s) => false,
            Err(e) => e == "Originating node ID must be strictly positive",
        }
    }

    fn test_quorum_evaluation() -> Bool {
        return this.service.evaluateClusterQuorum()
    }

    fn test_heartbeat_ping() -> Bool {
        return this.heartbeat.pingPeer(2)
    }

    fn run() -> Unit {
        let t1 = this.test_consensus_command_processing()
        let t2 = this.test_invalid_originating_node_rejected()
        let t3 = this.test_quorum_evaluation()
        let t4 = this.test_heartbeat_ping()

        if t1 && t2 && t3 && t4 {
            print("  ✓ Cloud Event Bus & Partitioned Streaming Unit Tests: 4/4 passed (Quorum, Invariants & Heartbeats Verified)")
        } else {
            print("  ✗ Cloud Event Bus & Partitioned Streaming Unit Tests: failed")
        }
    }
}

let repo = CloudEventBusClusterRepository()
let service = CloudEventBusCoreService(repo)
let heartbeat = CloudEventBusHeartbeatService()
let suite = CloudEventBusUnitTestSuite(service, heartbeat)
suite.run()
