// Example 47: Cloud Event Bus & Partitioned Streaming
// Core Domain Service Implementation

import { CloudEventBusNodeState } from "../entities/cloud_event_bus_primary.entity"
import { CreateCloudEventBusTaskRequest } from "../models/cloud_event_bus_request.dto"
import { CloudEventBusRepository } from "../interfaces/cloud_event_bus_repository.interface"
import { CloudEventBusConsensusContract } from "../interfaces/cloud_event_bus_service.interface"

class CloudEventBusCoreService implements CloudEventBusConsensusContract {
    repo: CloudEventBusRepository

    init(repo: CloudEventBusRepository) {
        this.repo = repo
    }

    fn processConsensusCommand(req: CreateCloudEventBusTaskRequest) -> Result<CloudEventBusNodeState, String> {
        if req.originatingNodeId <= 0 {
            return Err("Originating node ID must be strictly positive")
        }
        if req.payloadVolume <= 0 {
            return Err("Payload volume must be positive")
        }

        let state = CloudEventBusNodeState {
            id: req.originatingNodeId,
            nodeIdentifier: "CLUSTER-NODE-" + req.originatingNodeId.toString(),
            currentEpochTerm: 5,
            votedForCandidate: req.originatingNodeId,
            isLeader: true,
            active: true,
        }
        return this.repo.saveNodeState(state)
    }

    fn evaluateClusterQuorum() -> Bool {
        let quorum = this.repo.getActiveQuorumCount()
        return quorum >= 3
    }
}
