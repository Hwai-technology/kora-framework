// Example 39: Pharmacy Dispensing & Drug Interaction Checker
// Persistent Database Entity: Audit Trail Log

@table("pharmacy_inventory_interaction_audit_trail")
model PharmacyInventoryInteractionAuditTrail {
    @id
    id: Int
    recordId: Int
    performedByStaffId: Int
    actionTaken: String
    tamperProofHash: String
    timestamp: Int
}
