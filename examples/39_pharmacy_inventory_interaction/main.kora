// ============================================================================
// Example 39: Pharmacy Dispensing & Drug Interaction Checker
// Application Container & Clean Architecture Bootstrap
// ============================================================================

import { PharmacyInventoryInteractionInMemoryRepository } from "./repositories/pharmacy_inventory_interaction_inmemory.repository"
import { PharmacyInventoryInteractionCoreService } from "./services/pharmacy_inventory_interaction_core.service"
import { PharmacyInventoryInteractionController } from "./controllers/pharmacy_inventory_interaction.controller"
import { PharmacyInventoryInteractionRouter } from "./routes/pharmacy_inventory_interaction.routes"

class Application {
    init() {}

    fn bootstrap() -> Unit {
        let repo = PharmacyInventoryInteractionInMemoryRepository()
        let service = PharmacyInventoryInteractionCoreService(repo)
        let controller = PharmacyInventoryInteractionController(service)
        let router = PharmacyInventoryInteractionRouter(controller)

        let app = run()
        app.use(router)
        app.listen(8080)
    }
}

let app = Application()
app.bootstrap()
