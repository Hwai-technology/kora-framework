// Example 39: Pharmacy Dispensing & Drug Interaction Checker
// Transport Model: Standard Responses

model PharmacyInventoryInteractionResponseDto {
    recordId: Int
    patientId: Int
    status: String
    isComplianceVerified: Bool
    message: String
}

model PharmacyInventoryInteractionSummaryDto {
    patientId: Int
    totalEntries: Int
    severityCategory: String
    lastReviewedTimestamp: Int
}
