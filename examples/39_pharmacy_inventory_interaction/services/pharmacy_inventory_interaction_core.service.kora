// Example 39: Pharmacy Dispensing & Drug Interaction Checker
// Core Domain Service Implementation

import { PharmacyInventoryInteractionClinicalEntity } from "../entities/pharmacy_inventory_interaction_primary.entity"
import { CreatePharmacyInventoryInteractionRecordRequest } from "../models/pharmacy_inventory_interaction_request.dto"
import { PharmacyInventoryInteractionRepository } from "../interfaces/pharmacy_inventory_interaction_repository.interface"
import { PharmacyInventoryInteractionDomainContract } from "../interfaces/pharmacy_inventory_interaction_service.interface"

class PharmacyInventoryInteractionCoreService implements PharmacyInventoryInteractionDomainContract {
    repo: PharmacyInventoryInteractionRepository

    init(repo: PharmacyInventoryInteractionRepository) {
        this.repo = repo
    }

    fn processClinicalRecord(req: CreatePharmacyInventoryInteractionRecordRequest) -> Result<PharmacyInventoryInteractionClinicalEntity, String> {
        if req.patientId <= 0 {
            return Err("Patient ID must be strictly positive")
        }
        if req.clinicalMetricScore < 0 {
            return Err("Clinical metric score cannot be negative")
        }

        let entity = PharmacyInventoryInteractionClinicalEntity {
            id: req.patientId + 5000,
            patientId: req.patientId,
            clinicianId: req.clinicianId,
            clinicalMetricScore: req.clinicalMetricScore,
            complianceState: "AUDITED_SECURE",
            active: true,
        }
        return this.repo.save(entity)
    }

    fn evaluateClinicalRisk(patientId: Int) -> String {
        let opt = this.repo.findByPatientId(patientId)
        let isPresent = match opt {
            Some(r) => true,
            None => false,
        }
        if !isPresent {
            return "RECORD_NOT_FOUND"
        }
        let record = match opt {
            Some(r) => r,
            None => PharmacyInventoryInteractionClinicalEntity { id: 0, patientId: 0, clinicianId: 0, clinicalMetricScore: 0, complianceState: "", active: false },
        }
        if record.clinicalMetricScore > 80 {
            return "CRITICAL_OBSERVATION"
        }
        if record.clinicalMetricScore > 40 {
            return "MODERATE_ATTENTION"
        }
        return "NOMINAL_STABLE"
    }
}
