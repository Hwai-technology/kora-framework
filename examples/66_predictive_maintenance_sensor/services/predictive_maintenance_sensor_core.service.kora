// Example 66: Predictive Industrial Equipment Maintenance
// Core Domain Service Implementation

import { PredictiveMaintenanceSensorPrimaryRecord } from "../entities/predictive_maintenance_sensor_primary.entity"
import { CreatePredictiveMaintenanceSensorTaskRequest } from "../models/predictive_maintenance_sensor_request.dto"
import { PredictiveMaintenanceSensorRepository } from "../interfaces/predictive_maintenance_sensor_repository.interface"
import { PredictiveMaintenanceSensorDomainContract } from "../interfaces/predictive_maintenance_sensor_service.interface"

class PredictiveMaintenanceSensorCoreService implements PredictiveMaintenanceSensorDomainContract {
    repo: PredictiveMaintenanceSensorRepository

    init(repo: PredictiveMaintenanceSensorRepository) {
        this.repo = repo
    }

    fn executeTask(req: CreatePredictiveMaintenanceSensorTaskRequest) -> Result<PredictiveMaintenanceSensorPrimaryRecord, String> {
        if req.targetEntityId <= 0 {
            return Err("Target entity ID must be strictly positive")
        }
        if req.workloadCapacity <= 0 {
            return Err("Workload capacity must be strictly positive")
        }

        let record = PredictiveMaintenanceSensorPrimaryRecord {
            id: req.targetEntityId,
            referenceCode: req.taskKey,
            capacityScore: req.workloadCapacity,
            operationalStatus: "COMMITTED_HEALTHY",
            active: true,
        }
        return this.repo.save(record)
    }

    fn evaluateHealth(entityId: Int) -> String {
        let opt = this.repo.findById(entityId)
        let isPresent = match opt {
            Some(r) => true,
            None => false,
        }
        if !isPresent {
            return "ENTITY_NOT_FOUND"
        }
        let record = match opt {
            Some(r) => r,
            None => PredictiveMaintenanceSensorPrimaryRecord { id: 0, referenceCode: "", capacityScore: 0, operationalStatus: "", active: false },
        }
        if record.capacityScore > 80 {
            return "OPTIMUM_PERFORMANCE"
        }
        if record.capacityScore > 40 {
            return "MODERATE_NORMAL"
        }
        return "LOW_CAPACITY"
    }
}
