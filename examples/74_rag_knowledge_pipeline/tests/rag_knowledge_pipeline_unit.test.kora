// ============================================================================
// Unit Test Suite: Retrieval-Augmented Generation (RAG) Document Chunker
// Verifies Domain Invariants, Boundary Calculations & Liveness
// ============================================================================

import { CreateRagKnowledgePipelineTaskRequest } from "../models/rag_knowledge_pipeline_request.dto"
import { RagKnowledgePipelineInMemoryRepository } from "../repositories/rag_knowledge_pipeline_inmemory.repository"
import { RagKnowledgePipelineCoreService } from "../services/rag_knowledge_pipeline_core.service"
import { RagKnowledgePipelineTelemetryService } from "../services/rag_knowledge_pipeline_telemetry.service"

class RagKnowledgePipelineUnitTestSuite {
    service: RagKnowledgePipelineCoreService
    telemetry: RagKnowledgePipelineTelemetryService

    init(service: RagKnowledgePipelineCoreService, telemetry: RagKnowledgePipelineTelemetryService) {
        this.service = service
        this.telemetry = telemetry
    }

    fn test_valid_task_execution() -> Bool {
        let req = CreateRagKnowledgePipelineTaskRequest {
            taskKey: "UNIT-TASK-101",
            targetEntityId: 10,
            workloadCapacity: 95,
            domainContext: "AI/ML Systems",
        }
        let res = this.service.executeTask(req)
        return match res {
            Ok(rec) => rec.id == 10 && rec.capacityScore == 95,
            Err(e) => false,
        }
    }

    fn test_invalid_negative_target_rejected() -> Bool {
        let req = CreateRagKnowledgePipelineTaskRequest {
            taskKey: "INVALID-TASK",
            targetEntityId: -1,
            workloadCapacity: 50,
            domainContext: "AI/ML Systems",
        }
        let res = this.service.executeTask(req)
        return match res {
            Ok(r) => false,
            Err(e) => e == "Target entity ID must be strictly positive",
        }
    }

    fn test_health_evaluation() -> Bool {
        let health = this.service.evaluateHealth(10)
        return health == "OPTIMUM_PERFORMANCE" || health == "MODERATE_NORMAL"
    }

    fn test_telemetry_ping() -> Bool {
        return this.telemetry.ping()
    }

    fn run() -> Unit {
        let t1 = this.test_valid_task_execution()
        let t2 = this.test_invalid_negative_target_rejected()
        let t3 = this.test_health_evaluation()
        let t4 = this.test_telemetry_ping()

        if t1 && t2 && t3 && t4 {
            print("  ✓ Retrieval-Augmented Generation (RAG) Document Chunker Unit Tests: 4/4 passed (Domain Invariants Verified)")
        } else {
            print("  ✗ Retrieval-Augmented Generation (RAG) Document Chunker Unit Tests: failed")
        }
    }
}

let repo = RagKnowledgePipelineInMemoryRepository()
let service = RagKnowledgePipelineCoreService(repo)
let telemetry = RagKnowledgePipelineTelemetryService()
let suite = RagKnowledgePipelineUnitTestSuite(service, telemetry)
suite.run()
