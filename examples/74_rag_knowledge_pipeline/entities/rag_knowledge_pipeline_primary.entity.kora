// Example 74: Retrieval-Augmented Generation (RAG) Document Chunker
// Persistent Database Entity: Primary Record

@table("rag_knowledge_pipeline_records")
model RagKnowledgePipelinePrimaryRecord {
    @id
    id: Int
    @unique
    referenceCode: String
    capacityScore: Int
    operationalStatus: String
    active: Bool
}
