// ============================================================================
// Example 74: Retrieval-Augmented Generation (RAG) Document Chunker
// Application Container & Clean Architecture Bootstrap
// ============================================================================

import { RagKnowledgePipelineInMemoryRepository } from "./repositories/rag_knowledge_pipeline_inmemory.repository"
import { RagKnowledgePipelineCoreService } from "./services/rag_knowledge_pipeline_core.service"
import { RagKnowledgePipelineController } from "./controllers/rag_knowledge_pipeline.controller"
import { RagKnowledgePipelineRouter } from "./routes/rag_knowledge_pipeline.routes"

class Application {
    init() {}

    fn bootstrap() -> Unit {
        let repo = RagKnowledgePipelineInMemoryRepository()
        let service = RagKnowledgePipelineCoreService(repo)
        let controller = RagKnowledgePipelineController(service)
        let router = RagKnowledgePipelineRouter(controller)

        let app = run()
        app.use(router)
        app.listen(8080)
    }
}

let app = Application()
app.bootstrap()
