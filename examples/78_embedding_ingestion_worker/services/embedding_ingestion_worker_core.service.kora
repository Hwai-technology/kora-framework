// Example 78: High-Throughput Vector Embedding Ingestion Pipeline
// Core Domain Service Implementation

import { EmbeddingIngestionWorkerPrimaryRecord } from "../entities/embedding_ingestion_worker_primary.entity"
import { CreateEmbeddingIngestionWorkerTaskRequest } from "../models/embedding_ingestion_worker_request.dto"
import { EmbeddingIngestionWorkerRepository } from "../interfaces/embedding_ingestion_worker_repository.interface"
import { EmbeddingIngestionWorkerDomainContract } from "../interfaces/embedding_ingestion_worker_service.interface"

class EmbeddingIngestionWorkerCoreService implements EmbeddingIngestionWorkerDomainContract {
    repo: EmbeddingIngestionWorkerRepository

    init(repo: EmbeddingIngestionWorkerRepository) {
        this.repo = repo
    }

    fn executeTask(req: CreateEmbeddingIngestionWorkerTaskRequest) -> Result<EmbeddingIngestionWorkerPrimaryRecord, String> {
        if req.targetEntityId <= 0 {
            return Err("Target entity ID must be strictly positive")
        }
        if req.workloadCapacity <= 0 {
            return Err("Workload capacity must be strictly positive")
        }

        let record = EmbeddingIngestionWorkerPrimaryRecord {
            id: req.targetEntityId,
            referenceCode: req.taskKey,
            capacityScore: req.workloadCapacity,
            operationalStatus: "COMMITTED_HEALTHY",
            active: true,
        }
        return this.repo.save(record)
    }

    fn evaluateHealth(entityId: Int) -> String {
        let opt = this.repo.findById(entityId)
        let isPresent = match opt {
            Some(r) => true,
            None => false,
        }
        if !isPresent {
            return "ENTITY_NOT_FOUND"
        }
        let record = match opt {
            Some(r) => r,
            None => EmbeddingIngestionWorkerPrimaryRecord { id: 0, referenceCode: "", capacityScore: 0, operationalStatus: "", active: false },
        }
        if record.capacityScore > 80 {
            return "OPTIMUM_PERFORMANCE"
        }
        if record.capacityScore > 40 {
            return "MODERATE_NORMAL"
        }
        return "LOW_CAPACITY"
    }
}
