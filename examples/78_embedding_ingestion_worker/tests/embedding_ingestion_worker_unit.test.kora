// ============================================================================
// Unit Test Suite: High-Throughput Vector Embedding Ingestion Pipeline
// Verifies Domain Invariants, Boundary Calculations & Liveness
// ============================================================================

import { CreateEmbeddingIngestionWorkerTaskRequest } from "../models/embedding_ingestion_worker_request.dto"
import { EmbeddingIngestionWorkerInMemoryRepository } from "../repositories/embedding_ingestion_worker_inmemory.repository"
import { EmbeddingIngestionWorkerCoreService } from "../services/embedding_ingestion_worker_core.service"
import { EmbeddingIngestionWorkerTelemetryService } from "../services/embedding_ingestion_worker_telemetry.service"

class EmbeddingIngestionWorkerUnitTestSuite {
    service: EmbeddingIngestionWorkerCoreService
    telemetry: EmbeddingIngestionWorkerTelemetryService

    init(service: EmbeddingIngestionWorkerCoreService, telemetry: EmbeddingIngestionWorkerTelemetryService) {
        this.service = service
        this.telemetry = telemetry
    }

    fn test_valid_task_execution() -> Bool {
        let req = CreateEmbeddingIngestionWorkerTaskRequest {
            taskKey: "UNIT-TASK-101",
            targetEntityId: 10,
            workloadCapacity: 95,
            domainContext: "AI/ML Systems",
        }
        let res = this.service.executeTask(req)
        return match res {
            Ok(rec) => rec.id == 10 && rec.capacityScore == 95,
            Err(e) => false,
        }
    }

    fn test_invalid_negative_target_rejected() -> Bool {
        let req = CreateEmbeddingIngestionWorkerTaskRequest {
            taskKey: "INVALID-TASK",
            targetEntityId: -1,
            workloadCapacity: 50,
            domainContext: "AI/ML Systems",
        }
        let res = this.service.executeTask(req)
        return match res {
            Ok(r) => false,
            Err(e) => e == "Target entity ID must be strictly positive",
        }
    }

    fn test_health_evaluation() -> Bool {
        let health = this.service.evaluateHealth(10)
        return health == "OPTIMUM_PERFORMANCE" || health == "MODERATE_NORMAL"
    }

    fn test_telemetry_ping() -> Bool {
        return this.telemetry.ping()
    }

    fn run() -> Unit {
        let t1 = this.test_valid_task_execution()
        let t2 = this.test_invalid_negative_target_rejected()
        let t3 = this.test_health_evaluation()
        let t4 = this.test_telemetry_ping()

        if t1 && t2 && t3 && t4 {
            print("  ✓ High-Throughput Vector Embedding Ingestion Pipeline Unit Tests: 4/4 passed (Domain Invariants Verified)")
        } else {
            print("  ✗ High-Throughput Vector Embedding Ingestion Pipeline Unit Tests: failed")
        }
    }
}

let repo = EmbeddingIngestionWorkerInMemoryRepository()
let service = EmbeddingIngestionWorkerCoreService(repo)
let telemetry = EmbeddingIngestionWorkerTelemetryService()
let suite = EmbeddingIngestionWorkerUnitTestSuite(service, telemetry)
suite.run()
