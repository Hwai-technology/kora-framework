// Example 78: High-Throughput Vector Embedding Ingestion Pipeline
// Presentation Controller

import { CreateEmbeddingIngestionWorkerTaskRequest } from "../models/embedding_ingestion_worker_request.dto"
import { EmbeddingIngestionWorkerResponseDto } from "../models/embedding_ingestion_worker_response.dto"
import { EmbeddingIngestionWorkerCoreService } from "../services/embedding_ingestion_worker_core.service"

class EmbeddingIngestionWorkerController {
    service: EmbeddingIngestionWorkerCoreService

    init(service: EmbeddingIngestionWorkerCoreService) {
        this.service = service
    }

    fn handleTaskSubmission(req: CreateEmbeddingIngestionWorkerTaskRequest) -> EmbeddingIngestionWorkerResponseDto {
        let outcome = this.service.executeTask(req)
        return match outcome {
            Ok(rec) => EmbeddingIngestionWorkerResponseDto {
                operationId: "TX-" + req.taskKey,
                entityId: rec.id,
                status: "EXECUTION_SUCCESSFUL",
                isVerified: true,
                message: "Operation completed under Clean Architecture invariants",
            },
            Err(reason) => EmbeddingIngestionWorkerResponseDto {
                operationId: "TX-FAILED",
                entityId: req.targetEntityId,
                status: "EXECUTION_REJECTED",
                isVerified: false,
                message: reason,
            },
        }
    }

    fn inspectHealth(entityId: Int) -> String {
        return this.service.evaluateHealth(entityId)
    }
}
