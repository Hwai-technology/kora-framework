// Example 28: Crypto Derivatives & Margin Engine
// Command Controller (Mutations & Writes)

import { CreateCryptoDerivativesExchangeRequest } from "../models/crypto_derivatives_exchange_request.dto"
import { CryptoDerivativesExchangeResponse } from "../models/crypto_derivatives_exchange_response.dto"
import { CryptoDerivativesExchangeCoreService } from "../services/crypto_derivatives_exchange_core.service"

class CryptoDerivativesExchangeCommandController {
    service: CryptoDerivativesExchangeCoreService

    init(service: CryptoDerivativesExchangeCoreService) {
        this.service = service
    }

    fn handleCreate(req: CreateCryptoDerivativesExchangeRequest) -> CryptoDerivativesExchangeResponse {
        let outcome = this.service.processRequest(req)
        return match outcome {
            Ok(rec) => CryptoDerivativesExchangeResponse {
                id: rec.id,
                reference: rec.reference,
                success: true,
                statusCode: 201,
                message: "Created successfully",
            },
            Err(reason) => CryptoDerivativesExchangeResponse {
                id: -1,
                reference: req.reference,
                success: false,
                statusCode: 400,
                message: reason,
            },
        }
    }
}
