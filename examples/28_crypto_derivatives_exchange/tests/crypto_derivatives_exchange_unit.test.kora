// ============================================================================
// Unit Test Suite: crypto_derivatives_exchange
// ============================================================================

import { CreateCryptoDerivativesExchangeRequest } from "../models/crypto_derivatives_exchange_request.dto"
import { CryptoDerivativesExchangePrimaryRepository } from "../repositories/crypto_derivatives_exchange_primary.repository"
import { CryptoDerivativesExchangeCoreService } from "../services/crypto_derivatives_exchange_core.service"
import { CryptoDerivativesExchangeValidationService } from "../services/crypto_derivatives_exchange_validation.service"

class CryptoDerivativesExchangeUnitTestSuite {
    service: CryptoDerivativesExchangeCoreService
    validator: CryptoDerivativesExchangeValidationService

    init(service: CryptoDerivativesExchangeCoreService, validator: CryptoDerivativesExchangeValidationService) {
        this.service = service
        this.validator = validator
    }

    fn test_valid_processing() -> Bool {
        let req = CreateCryptoDerivativesExchangeRequest {
            reference: "TEST-REF-100",
            targetId: 10,
            volume: 500,
            currency: "USD",
        }
        let res = this.service.processRequest(req)
        return match res {
            Ok(rec) => rec.status == "COMMITTED" && rec.balance == 500,
            Err(e) => false,
        }
    }

    fn test_invalid_volume() -> Bool {
        let req = CreateCryptoDerivativesExchangeRequest {
            reference: "TEST-REF-FAIL",
            targetId: 11,
            volume: -10,
            currency: "USD",
        }
        let res = this.service.processRequest(req)
        return match res {
            Ok(r) => false,
            Err(e) => e == "Volume must be positive",
        }
    }

    fn test_validator() -> Bool {
        let req = CreateCryptoDerivativesExchangeRequest {
            reference: "VALID-REF",
            targetId: 12,
            volume: 100,
            currency: "USD",
        }
        let res = this.validator.validateInput(req)
        return match res {
            Ok(v) => v,
            Err(e) => false,
        }
    }

    fn run() -> Unit {
        let t1 = this.test_valid_processing()
        let t2 = this.test_invalid_volume()
        let t3 = this.test_validator()

        if t1 && t2 && t3 {
            print("  ✓ Crypto Derivatives & Margin Engine Unit Tests: 3/3 passed")
        } else {
            print("  ✗ Crypto Derivatives & Margin Engine Unit Tests: failed")
        }
    }
}

let repo = CryptoDerivativesExchangePrimaryRepository()
let service = CryptoDerivativesExchangeCoreService(repo)
let validator = CryptoDerivativesExchangeValidationService()
let suite = CryptoDerivativesExchangeUnitTestSuite(service, validator)
suite.run()
