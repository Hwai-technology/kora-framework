// Example 55: Order Fulfillment & Pick-Pack-Ship Workflow
// Presentation Controller

import { CreateOrderFulfillmentPipelineTaskRequest } from "../models/order_fulfillment_pipeline_request.dto"
import { OrderFulfillmentPipelineResponseDto } from "../models/order_fulfillment_pipeline_response.dto"
import { OrderFulfillmentPipelineCoreService } from "../services/order_fulfillment_pipeline_core.service"

class OrderFulfillmentPipelineController {
    service: OrderFulfillmentPipelineCoreService

    init(service: OrderFulfillmentPipelineCoreService) {
        this.service = service
    }

    fn handleTaskSubmission(req: CreateOrderFulfillmentPipelineTaskRequest) -> OrderFulfillmentPipelineResponseDto {
        let outcome = this.service.executeTask(req)
        return match outcome {
            Ok(rec) => OrderFulfillmentPipelineResponseDto {
                operationId: "TX-" + req.taskKey,
                entityId: rec.id,
                status: "EXECUTION_SUCCESSFUL",
                isVerified: true,
                message: "Operation completed under Clean Architecture invariants",
            },
            Err(reason) => OrderFulfillmentPipelineResponseDto {
                operationId: "TX-FAILED",
                entityId: req.targetEntityId,
                status: "EXECUTION_REJECTED",
                isVerified: false,
                message: reason,
            },
        }
    }

    fn inspectHealth(entityId: Int) -> String {
        return this.service.evaluateHealth(entityId)
    }
}
