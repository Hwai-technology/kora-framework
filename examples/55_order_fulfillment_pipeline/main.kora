// ============================================================================
// Example 55: Order Fulfillment & Pick-Pack-Ship Workflow
// Application Container & Clean Architecture Bootstrap
// ============================================================================

import { OrderFulfillmentPipelineInMemoryRepository } from "./repositories/order_fulfillment_pipeline_inmemory.repository"
import { OrderFulfillmentPipelineCoreService } from "./services/order_fulfillment_pipeline_core.service"
import { OrderFulfillmentPipelineController } from "./controllers/order_fulfillment_pipeline.controller"
import { OrderFulfillmentPipelineRouter } from "./routes/order_fulfillment_pipeline.routes"

class Application {
    init() {}

    fn bootstrap() -> Unit {
        let repo = OrderFulfillmentPipelineInMemoryRepository()
        let service = OrderFulfillmentPipelineCoreService(repo)
        let controller = OrderFulfillmentPipelineController(service)
        let router = OrderFulfillmentPipelineRouter(controller)

        let app = run()
        app.use(router)
        app.listen(8080)
    }
}

let app = Application()
app.bootstrap()
