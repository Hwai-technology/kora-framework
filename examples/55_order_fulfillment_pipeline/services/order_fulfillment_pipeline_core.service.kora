// Example 55: Order Fulfillment & Pick-Pack-Ship Workflow
// Core Domain Service Implementation

import { OrderFulfillmentPipelinePrimaryRecord } from "../entities/order_fulfillment_pipeline_primary.entity"
import { CreateOrderFulfillmentPipelineTaskRequest } from "../models/order_fulfillment_pipeline_request.dto"
import { OrderFulfillmentPipelineRepository } from "../interfaces/order_fulfillment_pipeline_repository.interface"
import { OrderFulfillmentPipelineDomainContract } from "../interfaces/order_fulfillment_pipeline_service.interface"

class OrderFulfillmentPipelineCoreService implements OrderFulfillmentPipelineDomainContract {
    repo: OrderFulfillmentPipelineRepository

    init(repo: OrderFulfillmentPipelineRepository) {
        this.repo = repo
    }

    fn executeTask(req: CreateOrderFulfillmentPipelineTaskRequest) -> Result<OrderFulfillmentPipelinePrimaryRecord, String> {
        if req.targetEntityId <= 0 {
            return Err("Target entity ID must be strictly positive")
        }
        if req.workloadCapacity <= 0 {
            return Err("Workload capacity must be strictly positive")
        }

        let record = OrderFulfillmentPipelinePrimaryRecord {
            id: req.targetEntityId,
            referenceCode: req.taskKey,
            capacityScore: req.workloadCapacity,
            operationalStatus: "COMMITTED_HEALTHY",
            active: true,
        }
        return this.repo.save(record)
    }

    fn evaluateHealth(entityId: Int) -> String {
        let opt = this.repo.findById(entityId)
        let isPresent = match opt {
            Some(r) => true,
            None => false,
        }
        if !isPresent {
            return "ENTITY_NOT_FOUND"
        }
        let record = match opt {
            Some(r) => r,
            None => OrderFulfillmentPipelinePrimaryRecord { id: 0, referenceCode: "", capacityScore: 0, operationalStatus: "", active: false },
        }
        if record.capacityScore > 80 {
            return "OPTIMUM_PERFORMANCE"
        }
        if record.capacityScore > 40 {
            return "MODERATE_NORMAL"
        }
        return "LOW_CAPACITY"
    }
}
