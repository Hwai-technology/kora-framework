// ============================================================================
// Example 03: Full RESTful CRUD Products API — Main Entrypoint
// ============================================================================

import { ProductRouter } from "./routes/product.routes"

let app = run()

get("/products", (routes: ProductRouter) => {
    return routes.listProducts()
})

get("/products/{id}", (id: Int, routes: ProductRouter) => {
    return routes.getProduct(id)
})

post("/products", (request: Request, routes: ProductRouter) => {
    return routes.createProduct(request.body)
})

put("/products/{id}", (id: Int, request: Request, routes: ProductRouter) => {
    return routes.updateProduct(id, request.body)
})

delete("/products/{id}", (id: Int, routes: ProductRouter) => {
    return routes.deleteProduct(id)
})
