// Example 27: Real-time Fraud & Anomaly Evaluator
// Command Controller (Mutations & Writes)

import { CreateFraudDetectionEngineRequest } from "../models/fraud_detection_engine_request.dto"
import { FraudDetectionEngineResponse } from "../models/fraud_detection_engine_response.dto"
import { FraudDetectionEngineCoreService } from "../services/fraud_detection_engine_core.service"

class FraudDetectionEngineCommandController {
    service: FraudDetectionEngineCoreService

    init(service: FraudDetectionEngineCoreService) {
        this.service = service
    }

    fn handleCreate(req: CreateFraudDetectionEngineRequest) -> FraudDetectionEngineResponse {
        let outcome = this.service.processRequest(req)
        return match outcome {
            Ok(rec) => FraudDetectionEngineResponse {
                id: rec.id,
                reference: rec.reference,
                success: true,
                statusCode: 201,
                message: "Created successfully",
            },
            Err(reason) => FraudDetectionEngineResponse {
                id: -1,
                reference: req.reference,
                success: false,
                statusCode: 400,
                message: reason,
            },
        }
    }
}
