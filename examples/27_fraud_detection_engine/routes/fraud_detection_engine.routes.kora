// Example 27: Real-time Fraud & Anomaly Evaluator
// Router & Endpoint Dispatcher

import { CreateFraudDetectionEngineRequest } from "../models/fraud_detection_engine_request.dto"
import { FraudDetectionEngineResponse } from "../models/fraud_detection_engine_response.dto"
import { FraudDetectionEngineRecord } from "../entities/fraud_detection_engine_primary.entity"
import { FraudDetectionEngineCommandController } from "../controllers/fraud_detection_engine_command.controller"
import { FraudDetectionEngineQueryController } from "../controllers/fraud_detection_engine_query.controller"

class FraudDetectionEngineRouter {
    commandController: FraudDetectionEngineCommandController
    queryController: FraudDetectionEngineQueryController

    init(commandController: FraudDetectionEngineCommandController, queryController: FraudDetectionEngineQueryController) {
        this.commandController = commandController
        this.queryController = queryController
    }

    fn postRecord(req: CreateFraudDetectionEngineRequest) -> FraudDetectionEngineResponse {
        return this.commandController.handleCreate(req)
    }

    fn fetchRecord(id: Int) -> Option<FraudDetectionEngineRecord> {
        return this.queryController.getById(id)
    }
}
