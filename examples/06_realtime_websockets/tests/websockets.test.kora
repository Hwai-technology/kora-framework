// ============================================================================
// Integration Test Suite: 06_realtime_websockets
// Tests WebSocket upgrade, frame dispatch, room presence, and socket teardown
// ============================================================================

import { WsFrame } from "../models/chat.models"
import { ChatRepository } from "../repositories/chat.repository"
import { ChatService } from "../services/chat_hub.service"

class WebSocketsTestSuite {
    service: ChatService

    init(service: ChatService) {
        this.service = service
    }

    fn runAllTests() -> Unit {
        // 1. Upgrade handshake
        let session = this.service.authenticateUpgrade("kora_ws_token_master", "127.0.0.1", "general")
        print("WebSocket client authenticated and connected.")

        // 2. Ping-Pong Heartbeat exchange
        let pingFrame = WsFrame {
            fin: true,
            opcode: 9,
            masked: true,
            maskKey: 5544,
            payloadLength: 4,
            payload: "PING",
        }
        let reply = this.service.handleFrame("ws_sess_1001", pingFrame)
        print("WebSocket Ping/Pong heartbeat turnaround verified.")

        // 3. Broadcast to channel
        let delivered = this.service.broadcast("general", "admin", "System reboot in 10 minutes")
        print("WebSocket broadcast delivered.")

        // 4. Query Room Presence
        let presence = this.service.getPresence("general")
        print("WebSocket active room presence verified: " + presence.room)

        // 5. Teardown: Close session
        this.service.closeSession("ws_sess_1001")
        print("Teardown: WebSocket client disconnected and room membership cleared.")
    }
}

let repo = ChatRepository()
let service = ChatService(repo)
let suite = WebSocketsTestSuite(service)
suite.runAllTests()
