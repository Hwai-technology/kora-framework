# Kora WebSocket Gateway & Realtime Engine
WS_PORT=7582
WS_HOST=0.0.0.0
ENVIRONMENT=production

# RFC 6455 Framing & Heartbeat
WS_HEARTBEAT_INTERVAL_MS=30000
WS_HEARTBEAT_TIMEOUT_MS=60000
WS_MAX_PAYLOAD_BYTES=65536
WS_MAX_CLIENTS_PER_ROOM=5000

# Redis Pub/Sub Federation
REDIS_URL=redis://:kora_secret_redis_pass@localhost:6379/0

# Security & Authentication
JWT_SECRET=super_secret_kora_ws_token_key_32chars
