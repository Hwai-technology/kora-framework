// ============================================================================
// Realtime WebSocket & Pub/Sub Routes
// ============================================================================

import { ChatController } from "../controllers/chat.controller"

class ChatRoutes {
    controller: ChatController

    init(controller: ChatController) {
        this.controller = controller
    }

    fn register() -> Unit {
        get("/ws/connect", this.controller.upgrade)
        post("/ws/broadcast/:channel", this.controller.broadcast)
        get("/ws/presence/:channel", this.controller.presence)
    }
}
