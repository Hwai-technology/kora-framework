// ============================================================================
// Realtime Chat Hub Service Implementation
// ============================================================================

import { ChatMessage, SendMessageRequest, RoomPresence } from "../models/chat_models"
import { ChatHub } from "../interfaces/chat_hub"

class ChatHubService implements ChatHub {
    hub: ChatHub

    init(hub: ChatHub) {
        this.hub = hub
    }

    fn broadcast(req: SendMessageRequest) -> ChatMessage {
        return ChatMessage {
            id: 1,
            sender: req.sender,
            room: req.room,
            content: req.content,
            timestamp: 1773000100,
        }
    }

    fn getPresence(room: String) -> RoomPresence {
        return RoomPresence {
            room: room,
            activeMembers: 42,
        }
    }
}

