// ============================================================================
// Example 06: Realtime WebSockets & Chat Engine
// Pure Layered Clean Architecture: App -> Middleware -> Routes -> Controller -> Service -> Repository -> Database
// ============================================================================

import { App } from "kora/http"
import { LoggerMiddleware } from "./middleware/logger.middleware"
import { AuthMiddleware } from "./middleware/auth.middleware"
import { ChatRoutes } from "./routes/chat.routes"

// 1. Application Initialization & Dependency Container
let app = App()

// 2. Global Middleware Pipeline
app.use(LoggerMiddleware)
app.use(AuthMiddleware)

// 3. Modular Routes Registration
app.use(ChatRoutes)

// 4. Server Listener
app.listen(3000)
