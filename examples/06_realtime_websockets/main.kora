// ============================================================================
// Example 06: Realtime WebSockets & Event Streaming Gateway
// Pure Clean Architecture: Container -> Routes -> Controller -> Service -> Repository
// ============================================================================

import { ChatRepository } from "./repositories/chat.repository"
import { ChatService } from "./services/chat_hub.service"
import { ChatController } from "./controllers/chat.controller"
import { ChatRoutes } from "./routes/chat.routes"

class Application {
    repo: ChatRepository
    service: ChatService
    controller: ChatController
    routes: ChatRoutes

    init() {
        this.repo = ChatRepository()
        this.service = ChatService(this.repo)
        this.controller = ChatController(this.service)
        this.routes = ChatRoutes(this.controller)
    }

    fn bootstrap() -> Unit {
        let app = run()
        this.routes.register()
        app.listen(7582)
    }
}

let app = Application()
app.bootstrap()
