// Example 32: Anti-Money Laundering (AML) SIEM Pipeline
// Analytical Aggregations Service

class AntiMoneyLaunderingSiemAnalyticsService {
    init() {}

    fn computeRiskRatio(volume: Int, reserve: Int) -> Int {
        if reserve <= 0 {
            return 999
        }
        return volume / reserve
    }

    fn calculateMovingAverage(current: Int, previous: Int) -> Int {
        return (current + previous) / 2
    }
}
