// ============================================================================
// Unit Test Suite: anti_money_laundering_siem
// ============================================================================

import { CreateAntiMoneyLaunderingSiemRequest } from "../models/anti_money_laundering_siem_request.dto"
import { AntiMoneyLaunderingSiemPrimaryRepository } from "../repositories/anti_money_laundering_siem_primary.repository"
import { AntiMoneyLaunderingSiemCoreService } from "../services/anti_money_laundering_siem_core.service"
import { AntiMoneyLaunderingSiemValidationService } from "../services/anti_money_laundering_siem_validation.service"

class AntiMoneyLaunderingSiemUnitTestSuite {
    service: AntiMoneyLaunderingSiemCoreService
    validator: AntiMoneyLaunderingSiemValidationService

    init(service: AntiMoneyLaunderingSiemCoreService, validator: AntiMoneyLaunderingSiemValidationService) {
        this.service = service
        this.validator = validator
    }

    fn test_valid_processing() -> Bool {
        let req = CreateAntiMoneyLaunderingSiemRequest {
            reference: "TEST-REF-100",
            targetId: 10,
            volume: 500,
            currency: "USD",
        }
        let res = this.service.processRequest(req)
        return match res {
            Ok(rec) => rec.status == "COMMITTED" && rec.balance == 500,
            Err(e) => false,
        }
    }

    fn test_invalid_volume() -> Bool {
        let req = CreateAntiMoneyLaunderingSiemRequest {
            reference: "TEST-REF-FAIL",
            targetId: 11,
            volume: -10,
            currency: "USD",
        }
        let res = this.service.processRequest(req)
        return match res {
            Ok(r) => false,
            Err(e) => e == "Volume must be positive",
        }
    }

    fn test_validator() -> Bool {
        let req = CreateAntiMoneyLaunderingSiemRequest {
            reference: "VALID-REF",
            targetId: 12,
            volume: 100,
            currency: "USD",
        }
        let res = this.validator.validateInput(req)
        return match res {
            Ok(v) => v,
            Err(e) => false,
        }
    }

    fn run() -> Unit {
        let t1 = this.test_valid_processing()
        let t2 = this.test_invalid_volume()
        let t3 = this.test_validator()

        if t1 && t2 && t3 {
            print("  ✓ Anti-Money Laundering (AML) SIEM Pipeline Unit Tests: 3/3 passed")
        } else {
            print("  ✗ Anti-Money Laundering (AML) SIEM Pipeline Unit Tests: failed")
        }
    }
}

let repo = AntiMoneyLaunderingSiemPrimaryRepository()
let service = AntiMoneyLaunderingSiemCoreService(repo)
let validator = AntiMoneyLaunderingSiemValidationService()
let suite = AntiMoneyLaunderingSiemUnitTestSuite(service, validator)
suite.run()
