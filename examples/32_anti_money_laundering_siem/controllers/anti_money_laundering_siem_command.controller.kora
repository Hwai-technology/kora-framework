// Example 32: Anti-Money Laundering (AML) SIEM Pipeline
// Command Controller (Mutations & Writes)

import { CreateAntiMoneyLaunderingSiemRequest } from "../models/anti_money_laundering_siem_request.dto"
import { AntiMoneyLaunderingSiemResponse } from "../models/anti_money_laundering_siem_response.dto"
import { AntiMoneyLaunderingSiemCoreService } from "../services/anti_money_laundering_siem_core.service"

class AntiMoneyLaunderingSiemCommandController {
    service: AntiMoneyLaunderingSiemCoreService

    init(service: AntiMoneyLaunderingSiemCoreService) {
        this.service = service
    }

    fn handleCreate(req: CreateAntiMoneyLaunderingSiemRequest) -> AntiMoneyLaunderingSiemResponse {
        let outcome = this.service.processRequest(req)
        return match outcome {
            Ok(rec) => AntiMoneyLaunderingSiemResponse {
                id: rec.id,
                reference: rec.reference,
                success: true,
                statusCode: 201,
                message: "Created successfully",
            },
            Err(reason) => AntiMoneyLaunderingSiemResponse {
                id: -1,
                reference: req.reference,
                success: false,
                statusCode: 400,
                message: reason,
            },
        }
    }
}
