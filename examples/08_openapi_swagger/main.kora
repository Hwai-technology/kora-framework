// ============================================================================
// Example 08: OpenAPI 3.1 & Interactive Swagger UI — Main Entrypoint
// ============================================================================

import { ArticleRouter } from "./routes/article.routes"

let app = run()

get("/articles", (routes: ArticleRouter) => {
    return routes.list()
})

get("/articles/{slug}", (slug: String, routes: ArticleRouter) => {
    return routes.getBySlug(slug)
})

post("/articles", (request: Request, routes: ArticleRouter) => {
    return routes.create(request.body)
})
