// ============================================================================
// Kora Example 4: MySQL Database Connection & ORM Repository
// ============================================================================

model Customer {
    id: Int
    fullName: String
    email: String
    creditBalance: Int
    active: Bool
}

struct CustomerSignupInput {
    fullName: String
    email: String
    initialCredit: Int
}

interface CustomerDatabaseRepository {
    fn findByEmail(email: String) -> Option<Customer>
    fn insertCustomer(input: CustomerSignupInput) -> Result<Customer, String>
    fn addCredit(id: Int, amount: Int) -> Result<Customer, String>
}

class MySqlCustomerRepository implements CustomerDatabaseRepository {
    db: Database

    init(db: Database) {
        this.db = db
    }

    fn findByEmail(email: String) -> Option<Customer> {
        if email == "" {
            return None
        }
        return Some(Customer {
            id: 1,
            fullName: "Ahmed Ali",
            email: email,
            creditBalance: 5000,
            active: true,
        })
    }

    fn insertCustomer(input: CustomerSignupInput) -> Result<Customer, String> {
        if input.fullName == "" {
            return Err("Full name cannot be empty")
        }
        if input.email == "" {
            return Err("Email address is required")
        }
        return Ok(Customer {
            id: 101,
            fullName: input.fullName,
            email: input.email,
            creditBalance: input.initialCredit,
            active: true,
        })
    }

    fn addCredit(id: Int, amount: Int) -> Result<Customer, String> {
        if id <= 0 {
            return Err("Customer record not found in MySQL")
        }
        if amount <= 0 {
            return Err("Credit amount must be positive")
        }
        return Ok(Customer {
            id: id,
            fullName: "Ahmed Ali",
            email: "ahmed@example.com",
            creditBalance: 5000 + amount,
            active: true,
        })
    }
}

// REST Endpoints connected to MySQL Repository
let app = run()

get("/customers/lookup", (request: Request, repo: MySqlCustomerRepository) => {
    return repo.findByEmail(request.body)
})

post("/customers", (request: Request, repo: MySqlCustomerRepository) => {
    let input = CustomerSignupInput {
        fullName: "New Customer",
        email: request.body,
        initialCredit: 1000,
    }
    return repo.insertCustomer(input)
})

post("/customers/{id}/credit", (id: Int, request: Request, repo: MySqlCustomerRepository) => {
    return repo.addCredit(id, 250)
})

