// ============================================================================
// Example 07: Async Actors & Channel Concurrency — Main Entrypoint
// ============================================================================

import { ActorRouter } from "./routes/actor.routes"

let app = run()

get("/actors/stats", (routes: ActorRouter) => {
    return routes.stats()
})

post("/actors/jobs", (request: Request, routes: ActorRouter) => {
    return routes.enqueueJob(request.body)
})
