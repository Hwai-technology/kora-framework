// ============================================================================
// Example 05: Clean Architecture JWT & Argon2 Authentication API — Main Entrypoint
// ============================================================================

import { AuthRouter } from "./routes/auth.routes"

let app = run()

post("/auth/register", (request: Request, routes: AuthRouter) => {
    return routes.handleRegister(request.body)
})

post("/auth/login", (request: Request, routes: AuthRouter) => {
    return routes.handleLogin(request.body)
})
