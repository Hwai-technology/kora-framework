// ============================================================================
// Unit Test Suite: Synthetic Tabular Data & Differential Privacy Generator
// Verifies Domain Invariants, Boundary Calculations & Liveness
// ============================================================================

import { CreateSyntheticDataGeneratorTaskRequest } from "../models/synthetic_data_generator_request.dto"
import { SyntheticDataGeneratorInMemoryRepository } from "../repositories/synthetic_data_generator_inmemory.repository"
import { SyntheticDataGeneratorCoreService } from "../services/synthetic_data_generator_core.service"
import { SyntheticDataGeneratorTelemetryService } from "../services/synthetic_data_generator_telemetry.service"

class SyntheticDataGeneratorUnitTestSuite {
    service: SyntheticDataGeneratorCoreService
    telemetry: SyntheticDataGeneratorTelemetryService

    init(service: SyntheticDataGeneratorCoreService, telemetry: SyntheticDataGeneratorTelemetryService) {
        this.service = service
        this.telemetry = telemetry
    }

    fn test_valid_task_execution() -> Bool {
        let req = CreateSyntheticDataGeneratorTaskRequest {
            taskKey: "UNIT-TASK-101",
            targetEntityId: 10,
            workloadCapacity: 95,
            domainContext: "AI/ML Systems",
        }
        let res = this.service.executeTask(req)
        return match res {
            Ok(rec) => rec.id == 10 && rec.capacityScore == 95,
            Err(e) => false,
        }
    }

    fn test_invalid_negative_target_rejected() -> Bool {
        let req = CreateSyntheticDataGeneratorTaskRequest {
            taskKey: "INVALID-TASK",
            targetEntityId: -1,
            workloadCapacity: 50,
            domainContext: "AI/ML Systems",
        }
        let res = this.service.executeTask(req)
        return match res {
            Ok(r) => false,
            Err(e) => e == "Target entity ID must be strictly positive",
        }
    }

    fn test_health_evaluation() -> Bool {
        let health = this.service.evaluateHealth(10)
        return health == "OPTIMUM_PERFORMANCE" || health == "MODERATE_NORMAL"
    }

    fn test_telemetry_ping() -> Bool {
        return this.telemetry.ping()
    }

    fn run() -> Unit {
        let t1 = this.test_valid_task_execution()
        let t2 = this.test_invalid_negative_target_rejected()
        let t3 = this.test_health_evaluation()
        let t4 = this.test_telemetry_ping()

        if t1 && t2 && t3 && t4 {
            print("  ✓ Synthetic Tabular Data & Differential Privacy Generator Unit Tests: 4/4 passed (Domain Invariants Verified)")
        } else {
            print("  ✗ Synthetic Tabular Data & Differential Privacy Generator Unit Tests: failed")
        }
    }
}

let repo = SyntheticDataGeneratorInMemoryRepository()
let service = SyntheticDataGeneratorCoreService(repo)
let telemetry = SyntheticDataGeneratorTelemetryService()
let suite = SyntheticDataGeneratorUnitTestSuite(service, telemetry)
suite.run()
