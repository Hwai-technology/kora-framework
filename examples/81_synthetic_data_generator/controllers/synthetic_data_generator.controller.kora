// Example 81: Synthetic Tabular Data & Differential Privacy Generator
// Presentation Controller

import { CreateSyntheticDataGeneratorTaskRequest } from "../models/synthetic_data_generator_request.dto"
import { SyntheticDataGeneratorResponseDto } from "../models/synthetic_data_generator_response.dto"
import { SyntheticDataGeneratorCoreService } from "../services/synthetic_data_generator_core.service"

class SyntheticDataGeneratorController {
    service: SyntheticDataGeneratorCoreService

    init(service: SyntheticDataGeneratorCoreService) {
        this.service = service
    }

    fn handleTaskSubmission(req: CreateSyntheticDataGeneratorTaskRequest) -> SyntheticDataGeneratorResponseDto {
        let outcome = this.service.executeTask(req)
        return match outcome {
            Ok(rec) => SyntheticDataGeneratorResponseDto {
                operationId: "TX-" + req.taskKey,
                entityId: rec.id,
                status: "EXECUTION_SUCCESSFUL",
                isVerified: true,
                message: "Operation completed under Clean Architecture invariants",
            },
            Err(reason) => SyntheticDataGeneratorResponseDto {
                operationId: "TX-FAILED",
                entityId: req.targetEntityId,
                status: "EXECUTION_REJECTED",
                isVerified: false,
                message: reason,
            },
        }
    }

    fn inspectHealth(entityId: Int) -> String {
        return this.service.evaluateHealth(entityId)
    }
}
