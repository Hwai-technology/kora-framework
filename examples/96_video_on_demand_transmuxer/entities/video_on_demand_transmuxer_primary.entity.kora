// Example 96: Video on Demand (VOD) HLS/DASH Transmuxer
// Persistent Database Entity: Primary Record

@table("video_on_demand_transmuxer_records")
model VideoOnDemandTransmuxerPrimaryRecord {
    @id
    id: Int
    @unique
    referenceCode: String
    capacityScore: Int
    operationalStatus: String
    active: Bool
}
