// ============================================================================
// Unit Test Suite: Autonomous Drone Swarm Formation Coordinator
// Verifies Domain Invariants, Boundary Calculations & Liveness
// ============================================================================

import { CreateDroneSwarmMissionPlannerTaskRequest } from "../models/drone_swarm_mission_planner_request.dto"
import { DroneSwarmMissionPlannerInMemoryRepository } from "../repositories/drone_swarm_mission_planner_inmemory.repository"
import { DroneSwarmMissionPlannerCoreService } from "../services/drone_swarm_mission_planner_core.service"
import { DroneSwarmMissionPlannerTelemetryService } from "../services/drone_swarm_mission_planner_telemetry.service"

class DroneSwarmMissionPlannerUnitTestSuite {
    service: DroneSwarmMissionPlannerCoreService
    telemetry: DroneSwarmMissionPlannerTelemetryService

    init(service: DroneSwarmMissionPlannerCoreService, telemetry: DroneSwarmMissionPlannerTelemetryService) {
        this.service = service
        this.telemetry = telemetry
    }

    fn test_valid_task_execution() -> Bool {
        let req = CreateDroneSwarmMissionPlannerTaskRequest {
            taskKey: "UNIT-TASK-101",
            targetEntityId: 10,
            workloadCapacity: 95,
            domainContext: "IoT & Robotics",
        }
        let res = this.service.executeTask(req)
        return match res {
            Ok(rec) => rec.id == 10 && rec.capacityScore == 95,
            Err(e) => false,
        }
    }

    fn test_invalid_negative_target_rejected() -> Bool {
        let req = CreateDroneSwarmMissionPlannerTaskRequest {
            taskKey: "INVALID-TASK",
            targetEntityId: -1,
            workloadCapacity: 50,
            domainContext: "IoT & Robotics",
        }
        let res = this.service.executeTask(req)
        return match res {
            Ok(r) => false,
            Err(e) => e == "Target entity ID must be strictly positive",
        }
    }

    fn test_health_evaluation() -> Bool {
        let health = this.service.evaluateHealth(10)
        return health == "OPTIMUM_PERFORMANCE" || health == "MODERATE_NORMAL"
    }

    fn test_telemetry_ping() -> Bool {
        return this.telemetry.ping()
    }

    fn run() -> Unit {
        let t1 = this.test_valid_task_execution()
        let t2 = this.test_invalid_negative_target_rejected()
        let t3 = this.test_health_evaluation()
        let t4 = this.test_telemetry_ping()

        if t1 && t2 && t3 && t4 {
            print("  ✓ Autonomous Drone Swarm Formation Coordinator Unit Tests: 4/4 passed (Domain Invariants Verified)")
        } else {
            print("  ✗ Autonomous Drone Swarm Formation Coordinator Unit Tests: failed")
        }
    }
}

let repo = DroneSwarmMissionPlannerInMemoryRepository()
let service = DroneSwarmMissionPlannerCoreService(repo)
let telemetry = DroneSwarmMissionPlannerTelemetryService()
let suite = DroneSwarmMissionPlannerUnitTestSuite(service, telemetry)
suite.run()
