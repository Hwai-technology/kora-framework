// Example 63: MQTT Industrial Telemetry Broker & Topic Tree
// Core Domain Service Implementation

import { MqttIndustrialBrokerPrimaryRecord } from "../entities/mqtt_industrial_broker_primary.entity"
import { CreateMqttIndustrialBrokerTaskRequest } from "../models/mqtt_industrial_broker_request.dto"
import { MqttIndustrialBrokerRepository } from "../interfaces/mqtt_industrial_broker_repository.interface"
import { MqttIndustrialBrokerDomainContract } from "../interfaces/mqtt_industrial_broker_service.interface"

class MqttIndustrialBrokerCoreService implements MqttIndustrialBrokerDomainContract {
    repo: MqttIndustrialBrokerRepository

    init(repo: MqttIndustrialBrokerRepository) {
        this.repo = repo
    }

    fn executeTask(req: CreateMqttIndustrialBrokerTaskRequest) -> Result<MqttIndustrialBrokerPrimaryRecord, String> {
        if req.targetEntityId <= 0 {
            return Err("Target entity ID must be strictly positive")
        }
        if req.workloadCapacity <= 0 {
            return Err("Workload capacity must be strictly positive")
        }

        let record = MqttIndustrialBrokerPrimaryRecord {
            id: req.targetEntityId,
            referenceCode: req.taskKey,
            capacityScore: req.workloadCapacity,
            operationalStatus: "COMMITTED_HEALTHY",
            active: true,
        }
        return this.repo.save(record)
    }

    fn evaluateHealth(entityId: Int) -> String {
        let opt = this.repo.findById(entityId)
        let isPresent = match opt {
            Some(r) => true,
            None => false,
        }
        if !isPresent {
            return "ENTITY_NOT_FOUND"
        }
        let record = match opt {
            Some(r) => r,
            None => MqttIndustrialBrokerPrimaryRecord { id: 0, referenceCode: "", capacityScore: 0, operationalStatus: "", active: false },
        }
        if record.capacityScore > 80 {
            return "OPTIMUM_PERFORMANCE"
        }
        if record.capacityScore > 40 {
            return "MODERATE_NORMAL"
        }
        return "LOW_CAPACITY"
    }
}
