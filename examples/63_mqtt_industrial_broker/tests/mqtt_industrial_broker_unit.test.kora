// ============================================================================
// Unit Test Suite: MQTT Industrial Telemetry Broker & Topic Tree
// Verifies Domain Invariants, Boundary Calculations & Liveness
// ============================================================================

import { CreateMqttIndustrialBrokerTaskRequest } from "../models/mqtt_industrial_broker_request.dto"
import { MqttIndustrialBrokerInMemoryRepository } from "../repositories/mqtt_industrial_broker_inmemory.repository"
import { MqttIndustrialBrokerCoreService } from "../services/mqtt_industrial_broker_core.service"
import { MqttIndustrialBrokerTelemetryService } from "../services/mqtt_industrial_broker_telemetry.service"

class MqttIndustrialBrokerUnitTestSuite {
    service: MqttIndustrialBrokerCoreService
    telemetry: MqttIndustrialBrokerTelemetryService

    init(service: MqttIndustrialBrokerCoreService, telemetry: MqttIndustrialBrokerTelemetryService) {
        this.service = service
        this.telemetry = telemetry
    }

    fn test_valid_task_execution() -> Bool {
        let req = CreateMqttIndustrialBrokerTaskRequest {
            taskKey: "UNIT-TASK-101",
            targetEntityId: 10,
            workloadCapacity: 95,
            domainContext: "IoT & Robotics",
        }
        let res = this.service.executeTask(req)
        return match res {
            Ok(rec) => rec.id == 10 && rec.capacityScore == 95,
            Err(e) => false,
        }
    }

    fn test_invalid_negative_target_rejected() -> Bool {
        let req = CreateMqttIndustrialBrokerTaskRequest {
            taskKey: "INVALID-TASK",
            targetEntityId: -1,
            workloadCapacity: 50,
            domainContext: "IoT & Robotics",
        }
        let res = this.service.executeTask(req)
        return match res {
            Ok(r) => false,
            Err(e) => e == "Target entity ID must be strictly positive",
        }
    }

    fn test_health_evaluation() -> Bool {
        let health = this.service.evaluateHealth(10)
        return health == "OPTIMUM_PERFORMANCE" || health == "MODERATE_NORMAL"
    }

    fn test_telemetry_ping() -> Bool {
        return this.telemetry.ping()
    }

    fn run() -> Unit {
        let t1 = this.test_valid_task_execution()
        let t2 = this.test_invalid_negative_target_rejected()
        let t3 = this.test_health_evaluation()
        let t4 = this.test_telemetry_ping()

        if t1 && t2 && t3 && t4 {
            print("  ✓ MQTT Industrial Telemetry Broker & Topic Tree Unit Tests: 4/4 passed (Domain Invariants Verified)")
        } else {
            print("  ✗ MQTT Industrial Telemetry Broker & Topic Tree Unit Tests: failed")
        }
    }
}

let repo = MqttIndustrialBrokerInMemoryRepository()
let service = MqttIndustrialBrokerCoreService(repo)
let telemetry = MqttIndustrialBrokerTelemetryService()
let suite = MqttIndustrialBrokerUnitTestSuite(service, telemetry)
suite.run()
