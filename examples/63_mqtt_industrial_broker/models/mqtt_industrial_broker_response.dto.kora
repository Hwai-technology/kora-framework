// Example 63: MQTT Industrial Telemetry Broker & Topic Tree
// Transport Model: Standard Response

model MqttIndustrialBrokerResponseDto {
    operationId: String
    entityId: Int
    status: String
    isVerified: Bool
    message: String
}

model MqttIndustrialBrokerSummaryDto {
    totalProcessed: Int
    healthyNodesCount: Int
    systemState: String
}
