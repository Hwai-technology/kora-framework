// ============================================================================
// Unit Test Suite: Autonomous Rover Navigation & Obstacle Avoidance
// Verifies Domain Invariants, Boundary Calculations & Liveness
// ============================================================================

import { CreateAutonomousRoverCommandTaskRequest } from "../models/autonomous_rover_command_request.dto"
import { AutonomousRoverCommandInMemoryRepository } from "../repositories/autonomous_rover_command_inmemory.repository"
import { AutonomousRoverCommandCoreService } from "../services/autonomous_rover_command_core.service"
import { AutonomousRoverCommandTelemetryService } from "../services/autonomous_rover_command_telemetry.service"

class AutonomousRoverCommandUnitTestSuite {
    service: AutonomousRoverCommandCoreService
    telemetry: AutonomousRoverCommandTelemetryService

    init(service: AutonomousRoverCommandCoreService, telemetry: AutonomousRoverCommandTelemetryService) {
        this.service = service
        this.telemetry = telemetry
    }

    fn test_valid_task_execution() -> Bool {
        let req = CreateAutonomousRoverCommandTaskRequest {
            taskKey: "UNIT-TASK-101",
            targetEntityId: 10,
            workloadCapacity: 95,
            domainContext: "IoT & Robotics",
        }
        let res = this.service.executeTask(req)
        return match res {
            Ok(rec) => rec.id == 10 && rec.capacityScore == 95,
            Err(e) => false,
        }
    }

    fn test_invalid_negative_target_rejected() -> Bool {
        let req = CreateAutonomousRoverCommandTaskRequest {
            taskKey: "INVALID-TASK",
            targetEntityId: -1,
            workloadCapacity: 50,
            domainContext: "IoT & Robotics",
        }
        let res = this.service.executeTask(req)
        return match res {
            Ok(r) => false,
            Err(e) => e == "Target entity ID must be strictly positive",
        }
    }

    fn test_health_evaluation() -> Bool {
        let health = this.service.evaluateHealth(10)
        return health == "OPTIMUM_PERFORMANCE" || health == "MODERATE_NORMAL"
    }

    fn test_telemetry_ping() -> Bool {
        return this.telemetry.ping()
    }

    fn run() -> Unit {
        let t1 = this.test_valid_task_execution()
        let t2 = this.test_invalid_negative_target_rejected()
        let t3 = this.test_health_evaluation()
        let t4 = this.test_telemetry_ping()

        if t1 && t2 && t3 && t4 {
            print("  ✓ Autonomous Rover Navigation & Obstacle Avoidance Unit Tests: 4/4 passed (Domain Invariants Verified)")
        } else {
            print("  ✗ Autonomous Rover Navigation & Obstacle Avoidance Unit Tests: failed")
        }
    }
}

let repo = AutonomousRoverCommandInMemoryRepository()
let service = AutonomousRoverCommandCoreService(repo)
let telemetry = AutonomousRoverCommandTelemetryService()
let suite = AutonomousRoverCommandUnitTestSuite(service, telemetry)
suite.run()
