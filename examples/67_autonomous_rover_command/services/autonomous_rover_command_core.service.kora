// Example 67: Autonomous Rover Navigation & Obstacle Avoidance
// Core Domain Service Implementation

import { AutonomousRoverCommandPrimaryRecord } from "../entities/autonomous_rover_command_primary.entity"
import { CreateAutonomousRoverCommandTaskRequest } from "../models/autonomous_rover_command_request.dto"
import { AutonomousRoverCommandRepository } from "../interfaces/autonomous_rover_command_repository.interface"
import { AutonomousRoverCommandDomainContract } from "../interfaces/autonomous_rover_command_service.interface"

class AutonomousRoverCommandCoreService implements AutonomousRoverCommandDomainContract {
    repo: AutonomousRoverCommandRepository

    init(repo: AutonomousRoverCommandRepository) {
        this.repo = repo
    }

    fn executeTask(req: CreateAutonomousRoverCommandTaskRequest) -> Result<AutonomousRoverCommandPrimaryRecord, String> {
        if req.targetEntityId <= 0 {
            return Err("Target entity ID must be strictly positive")
        }
        if req.workloadCapacity <= 0 {
            return Err("Workload capacity must be strictly positive")
        }

        let record = AutonomousRoverCommandPrimaryRecord {
            id: req.targetEntityId,
            referenceCode: req.taskKey,
            capacityScore: req.workloadCapacity,
            operationalStatus: "COMMITTED_HEALTHY",
            active: true,
        }
        return this.repo.save(record)
    }

    fn evaluateHealth(entityId: Int) -> String {
        let opt = this.repo.findById(entityId)
        let isPresent = match opt {
            Some(r) => true,
            None => false,
        }
        if !isPresent {
            return "ENTITY_NOT_FOUND"
        }
        let record = match opt {
            Some(r) => r,
            None => AutonomousRoverCommandPrimaryRecord { id: 0, referenceCode: "", capacityScore: 0, operationalStatus: "", active: false },
        }
        if record.capacityScore > 80 {
            return "OPTIMUM_PERFORMANCE"
        }
        if record.capacityScore > 40 {
            return "MODERATE_NORMAL"
        }
        return "LOW_CAPACITY"
    }
}
