// Example 33: Treasury Liquidity & Capital Allocation
// Command Controller (Mutations & Writes)

import { CreateTreasuryLiquidityPoolRequest } from "../models/treasury_liquidity_pool_request.dto"
import { TreasuryLiquidityPoolResponse } from "../models/treasury_liquidity_pool_response.dto"
import { TreasuryLiquidityPoolCoreService } from "../services/treasury_liquidity_pool_core.service"

class TreasuryLiquidityPoolCommandController {
    service: TreasuryLiquidityPoolCoreService

    init(service: TreasuryLiquidityPoolCoreService) {
        this.service = service
    }

    fn handleCreate(req: CreateTreasuryLiquidityPoolRequest) -> TreasuryLiquidityPoolResponse {
        let outcome = this.service.processRequest(req)
        return match outcome {
            Ok(rec) => TreasuryLiquidityPoolResponse {
                id: rec.id,
                reference: rec.reference,
                success: true,
                statusCode: 201,
                message: "Created successfully",
            },
            Err(reason) => TreasuryLiquidityPoolResponse {
                id: -1,
                reference: req.reference,
                success: false,
                statusCode: 400,
                message: reason,
            },
        }
    }
}
