// Example 33: Treasury Liquidity & Capital Allocation
// Core Domain Service Implementation

import { TreasuryLiquidityPoolRecord } from "../entities/treasury_liquidity_pool_primary.entity"
import { CreateTreasuryLiquidityPoolRequest } from "../models/treasury_liquidity_pool_request.dto"
import { TreasuryLiquidityPoolRepository } from "../interfaces/treasury_liquidity_pool_repository.interface"
import { TreasuryLiquidityPoolServiceInterface } from "../interfaces/treasury_liquidity_pool_service.interface"

class TreasuryLiquidityPoolCoreService implements TreasuryLiquidityPoolServiceInterface {
    repo: TreasuryLiquidityPoolRepository

    init(repo: TreasuryLiquidityPoolRepository) {
        this.repo = repo
    }

    fn processRequest(req: CreateTreasuryLiquidityPoolRequest) -> Result<TreasuryLiquidityPoolRecord, String> {
        if req.volume <= 0 {
            return Err("Volume must be positive")
        }
        let record = TreasuryLiquidityPoolRecord {
            id: req.targetId,
            reference: req.reference,
            status: "COMMITTED",
            balance: req.volume,
            active: true,
        }
        return this.repo.save(record)
    }

    fn validateState(id: Int) -> Bool {
        let opt = this.repo.findById(id)
        return match opt {
            Some(rec) => rec.active,
            None => false,
        }
    }
}
