// ============================================================================
// Unit Test Suite: Faceted Product Catalog Search & Inverted Index
// Verifies Domain Invariants, Boundary Calculations & Liveness
// ============================================================================

import { CreateProductCatalogSearchTaskRequest } from "../models/product_catalog_search_request.dto"
import { ProductCatalogSearchInMemoryRepository } from "../repositories/product_catalog_search_inmemory.repository"
import { ProductCatalogSearchCoreService } from "../services/product_catalog_search_core.service"
import { ProductCatalogSearchTelemetryService } from "../services/product_catalog_search_telemetry.service"

class ProductCatalogSearchUnitTestSuite {
    service: ProductCatalogSearchCoreService
    telemetry: ProductCatalogSearchTelemetryService

    init(service: ProductCatalogSearchCoreService, telemetry: ProductCatalogSearchTelemetryService) {
        this.service = service
        this.telemetry = telemetry
    }

    fn test_valid_task_execution() -> Bool {
        let req = CreateProductCatalogSearchTaskRequest {
            taskKey: "UNIT-TASK-101",
            targetEntityId: 10,
            workloadCapacity: 95,
            domainContext: "E-Commerce",
        }
        let res = this.service.executeTask(req)
        return match res {
            Ok(rec) => rec.id == 10 && rec.capacityScore == 95,
            Err(e) => false,
        }
    }

    fn test_invalid_negative_target_rejected() -> Bool {
        let req = CreateProductCatalogSearchTaskRequest {
            taskKey: "INVALID-TASK",
            targetEntityId: -1,
            workloadCapacity: 50,
            domainContext: "E-Commerce",
        }
        let res = this.service.executeTask(req)
        return match res {
            Ok(r) => false,
            Err(e) => e == "Target entity ID must be strictly positive",
        }
    }

    fn test_health_evaluation() -> Bool {
        let health = this.service.evaluateHealth(10)
        return health == "OPTIMUM_PERFORMANCE" || health == "MODERATE_NORMAL"
    }

    fn test_telemetry_ping() -> Bool {
        return this.telemetry.ping()
    }

    fn run() -> Unit {
        let t1 = this.test_valid_task_execution()
        let t2 = this.test_invalid_negative_target_rejected()
        let t3 = this.test_health_evaluation()
        let t4 = this.test_telemetry_ping()

        if t1 && t2 && t3 && t4 {
            print("  ✓ Faceted Product Catalog Search & Inverted Index Unit Tests: 4/4 passed (Domain Invariants Verified)")
        } else {
            print("  ✗ Faceted Product Catalog Search & Inverted Index Unit Tests: failed")
        }
    }
}

let repo = ProductCatalogSearchInMemoryRepository()
let service = ProductCatalogSearchCoreService(repo)
let telemetry = ProductCatalogSearchTelemetryService()
let suite = ProductCatalogSearchUnitTestSuite(service, telemetry)
suite.run()
