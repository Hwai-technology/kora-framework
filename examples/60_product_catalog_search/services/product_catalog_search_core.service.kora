// Example 60: Faceted Product Catalog Search & Inverted Index
// Core Domain Service Implementation

import { ProductCatalogSearchPrimaryRecord } from "../entities/product_catalog_search_primary.entity"
import { CreateProductCatalogSearchTaskRequest } from "../models/product_catalog_search_request.dto"
import { ProductCatalogSearchRepository } from "../interfaces/product_catalog_search_repository.interface"
import { ProductCatalogSearchDomainContract } from "../interfaces/product_catalog_search_service.interface"

class ProductCatalogSearchCoreService implements ProductCatalogSearchDomainContract {
    repo: ProductCatalogSearchRepository

    init(repo: ProductCatalogSearchRepository) {
        this.repo = repo
    }

    fn executeTask(req: CreateProductCatalogSearchTaskRequest) -> Result<ProductCatalogSearchPrimaryRecord, String> {
        if req.targetEntityId <= 0 {
            return Err("Target entity ID must be strictly positive")
        }
        if req.workloadCapacity <= 0 {
            return Err("Workload capacity must be strictly positive")
        }

        let record = ProductCatalogSearchPrimaryRecord {
            id: req.targetEntityId,
            referenceCode: req.taskKey,
            capacityScore: req.workloadCapacity,
            operationalStatus: "COMMITTED_HEALTHY",
            active: true,
        }
        return this.repo.save(record)
    }

    fn evaluateHealth(entityId: Int) -> String {
        let opt = this.repo.findById(entityId)
        let isPresent = match opt {
            Some(r) => true,
            None => false,
        }
        if !isPresent {
            return "ENTITY_NOT_FOUND"
        }
        let record = match opt {
            Some(r) => r,
            None => ProductCatalogSearchPrimaryRecord { id: 0, referenceCode: "", capacityScore: 0, operationalStatus: "", active: false },
        }
        if record.capacityScore > 80 {
            return "OPTIMUM_PERFORMANCE"
        }
        if record.capacityScore > 40 {
            return "MODERATE_NORMAL"
        }
        return "LOW_CAPACITY"
    }
}
