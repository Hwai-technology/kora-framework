// Example 57: Marketplace Vendor Settlement & Escrow Payouts
// Core Domain Service Implementation

import { MarketplaceVendorSettlementPrimaryRecord } from "../entities/marketplace_vendor_settlement_primary.entity"
import { CreateMarketplaceVendorSettlementTaskRequest } from "../models/marketplace_vendor_settlement_request.dto"
import { MarketplaceVendorSettlementRepository } from "../interfaces/marketplace_vendor_settlement_repository.interface"
import { MarketplaceVendorSettlementDomainContract } from "../interfaces/marketplace_vendor_settlement_service.interface"

class MarketplaceVendorSettlementCoreService implements MarketplaceVendorSettlementDomainContract {
    repo: MarketplaceVendorSettlementRepository

    init(repo: MarketplaceVendorSettlementRepository) {
        this.repo = repo
    }

    fn executeTask(req: CreateMarketplaceVendorSettlementTaskRequest) -> Result<MarketplaceVendorSettlementPrimaryRecord, String> {
        if req.targetEntityId <= 0 {
            return Err("Target entity ID must be strictly positive")
        }
        if req.workloadCapacity <= 0 {
            return Err("Workload capacity must be strictly positive")
        }

        let record = MarketplaceVendorSettlementPrimaryRecord {
            id: req.targetEntityId,
            referenceCode: req.taskKey,
            capacityScore: req.workloadCapacity,
            operationalStatus: "COMMITTED_HEALTHY",
            active: true,
        }
        return this.repo.save(record)
    }

    fn evaluateHealth(entityId: Int) -> String {
        let opt = this.repo.findById(entityId)
        let isPresent = match opt {
            Some(r) => true,
            None => false,
        }
        if !isPresent {
            return "ENTITY_NOT_FOUND"
        }
        let record = match opt {
            Some(r) => r,
            None => MarketplaceVendorSettlementPrimaryRecord { id: 0, referenceCode: "", capacityScore: 0, operationalStatus: "", active: false },
        }
        if record.capacityScore > 80 {
            return "OPTIMUM_PERFORMANCE"
        }
        if record.capacityScore > 40 {
            return "MODERATE_NORMAL"
        }
        return "LOW_CAPACITY"
    }
}
