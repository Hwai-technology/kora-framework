// Example 57: Marketplace Vendor Settlement & Escrow Payouts
// Presentation Controller

import { CreateMarketplaceVendorSettlementTaskRequest } from "../models/marketplace_vendor_settlement_request.dto"
import { MarketplaceVendorSettlementResponseDto } from "../models/marketplace_vendor_settlement_response.dto"
import { MarketplaceVendorSettlementCoreService } from "../services/marketplace_vendor_settlement_core.service"

class MarketplaceVendorSettlementController {
    service: MarketplaceVendorSettlementCoreService

    init(service: MarketplaceVendorSettlementCoreService) {
        this.service = service
    }

    fn handleTaskSubmission(req: CreateMarketplaceVendorSettlementTaskRequest) -> MarketplaceVendorSettlementResponseDto {
        let outcome = this.service.executeTask(req)
        return match outcome {
            Ok(rec) => MarketplaceVendorSettlementResponseDto {
                operationId: "TX-" + req.taskKey,
                entityId: rec.id,
                status: "EXECUTION_SUCCESSFUL",
                isVerified: true,
                message: "Operation completed under Clean Architecture invariants",
            },
            Err(reason) => MarketplaceVendorSettlementResponseDto {
                operationId: "TX-FAILED",
                entityId: req.targetEntityId,
                status: "EXECUTION_REJECTED",
                isVerified: false,
                message: reason,
            },
        }
    }

    fn inspectHealth(entityId: Int) -> String {
        return this.service.evaluateHealth(entityId)
    }
}
