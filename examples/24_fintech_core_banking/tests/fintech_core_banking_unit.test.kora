// ============================================================================
// Unit Test Suite: fintech_core_banking
// ============================================================================

import { CreateFintechCoreBankingRequest } from "../models/fintech_core_banking_request.dto"
import { FintechCoreBankingPrimaryRepository } from "../repositories/fintech_core_banking_primary.repository"
import { FintechCoreBankingCoreService } from "../services/fintech_core_banking_core.service"
import { FintechCoreBankingValidationService } from "../services/fintech_core_banking_validation.service"

class FintechCoreBankingUnitTestSuite {
    service: FintechCoreBankingCoreService
    validator: FintechCoreBankingValidationService

    init(service: FintechCoreBankingCoreService, validator: FintechCoreBankingValidationService) {
        this.service = service
        this.validator = validator
    }

    fn test_valid_processing() -> Bool {
        let req = CreateFintechCoreBankingRequest {
            reference: "TEST-REF-100",
            targetId: 10,
            volume: 500,
            currency: "USD",
        }
        let res = this.service.processRequest(req)
        return match res {
            Ok(rec) => rec.status == "COMMITTED" && rec.balance == 500,
            Err(e) => false,
        }
    }

    fn test_invalid_volume() -> Bool {
        let req = CreateFintechCoreBankingRequest {
            reference: "TEST-REF-FAIL",
            targetId: 11,
            volume: -10,
            currency: "USD",
        }
        let res = this.service.processRequest(req)
        return match res {
            Ok(r) => false,
            Err(e) => e == "Volume must be positive",
        }
    }

    fn test_validator() -> Bool {
        let req = CreateFintechCoreBankingRequest {
            reference: "VALID-REF",
            targetId: 12,
            volume: 100,
            currency: "USD",
        }
        let res = this.validator.validateInput(req)
        return match res {
            Ok(v) => v,
            Err(e) => false,
        }
    }

    fn run() -> Unit {
        let t1 = this.test_valid_processing()
        let t2 = this.test_invalid_volume()
        let t3 = this.test_validator()

        if t1 && t2 && t3 {
            print("  ✓ Core Banking Ledger & Accounts Unit Tests: 3/3 passed")
        } else {
            print("  ✗ Core Banking Ledger & Accounts Unit Tests: failed")
        }
    }
}

let repo = FintechCoreBankingPrimaryRepository()
let service = FintechCoreBankingCoreService(repo)
let validator = FintechCoreBankingValidationService()
let suite = FintechCoreBankingUnitTestSuite(service, validator)
suite.run()
