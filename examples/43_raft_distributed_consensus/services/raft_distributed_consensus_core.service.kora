// Example 43: Raft Distributed Consensus Engine
// Core Domain Service Implementation

import { RaftDistributedConsensusNodeState } from "../entities/raft_distributed_consensus_primary.entity"
import { CreateRaftDistributedConsensusTaskRequest } from "../models/raft_distributed_consensus_request.dto"
import { RaftDistributedConsensusRepository } from "../interfaces/raft_distributed_consensus_repository.interface"
import { RaftDistributedConsensusConsensusContract } from "../interfaces/raft_distributed_consensus_service.interface"

class RaftDistributedConsensusCoreService implements RaftDistributedConsensusConsensusContract {
    repo: RaftDistributedConsensusRepository

    init(repo: RaftDistributedConsensusRepository) {
        this.repo = repo
    }

    fn processConsensusCommand(req: CreateRaftDistributedConsensusTaskRequest) -> Result<RaftDistributedConsensusNodeState, String> {
        if req.originatingNodeId <= 0 {
            return Err("Originating node ID must be strictly positive")
        }
        if req.payloadVolume <= 0 {
            return Err("Payload volume must be positive")
        }

        let state = RaftDistributedConsensusNodeState {
            id: req.originatingNodeId,
            nodeIdentifier: "CLUSTER-NODE-" + req.originatingNodeId.toString(),
            currentEpochTerm: 5,
            votedForCandidate: req.originatingNodeId,
            isLeader: true,
            active: true,
        }
        return this.repo.saveNodeState(state)
    }

    fn evaluateClusterQuorum() -> Bool {
        let quorum = this.repo.getActiveQuorumCount()
        return quorum >= 3
    }
}
