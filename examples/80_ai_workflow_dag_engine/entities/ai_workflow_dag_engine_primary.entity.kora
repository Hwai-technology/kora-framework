// Example 80: AI Workflow Directed Acyclic Graph (DAG) Engine
// Persistent Database Entity: Primary Record

@table("ai_workflow_dag_engine_records")
model AiWorkflowDagEnginePrimaryRecord {
    @id
    id: Int
    @unique
    referenceCode: String
    capacityScore: Int
    operationalStatus: String
    active: Bool
}
