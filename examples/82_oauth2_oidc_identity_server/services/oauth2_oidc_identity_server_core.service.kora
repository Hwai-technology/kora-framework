// Example 82: OAuth 2.1 & OpenID Connect Authorization Server
// Core Domain Service Implementation

import { Oauth2OidcIdentityServerPrimaryRecord } from "../entities/oauth2_oidc_identity_server_primary.entity"
import { CreateOauth2OidcIdentityServerTaskRequest } from "../models/oauth2_oidc_identity_server_request.dto"
import { Oauth2OidcIdentityServerRepository } from "../interfaces/oauth2_oidc_identity_server_repository.interface"
import { Oauth2OidcIdentityServerDomainContract } from "../interfaces/oauth2_oidc_identity_server_service.interface"

class Oauth2OidcIdentityServerCoreService implements Oauth2OidcIdentityServerDomainContract {
    repo: Oauth2OidcIdentityServerRepository

    init(repo: Oauth2OidcIdentityServerRepository) {
        this.repo = repo
    }

    fn executeTask(req: CreateOauth2OidcIdentityServerTaskRequest) -> Result<Oauth2OidcIdentityServerPrimaryRecord, String> {
        if req.targetEntityId <= 0 {
            return Err("Target entity ID must be strictly positive")
        }
        if req.workloadCapacity <= 0 {
            return Err("Workload capacity must be strictly positive")
        }

        let record = Oauth2OidcIdentityServerPrimaryRecord {
            id: req.targetEntityId,
            referenceCode: req.taskKey,
            capacityScore: req.workloadCapacity,
            operationalStatus: "COMMITTED_HEALTHY",
            active: true,
        }
        return this.repo.save(record)
    }

    fn evaluateHealth(entityId: Int) -> String {
        let opt = this.repo.findById(entityId)
        let isPresent = match opt {
            Some(r) => true,
            None => false,
        }
        if !isPresent {
            return "ENTITY_NOT_FOUND"
        }
        let record = match opt {
            Some(r) => r,
            None => Oauth2OidcIdentityServerPrimaryRecord { id: 0, referenceCode: "", capacityScore: 0, operationalStatus: "", active: false },
        }
        if record.capacityScore > 80 {
            return "OPTIMUM_PERFORMANCE"
        }
        if record.capacityScore > 40 {
            return "MODERATE_NORMAL"
        }
        return "LOW_CAPACITY"
    }
}
