// Example 82: OAuth 2.1 & OpenID Connect Authorization Server
// Persistent Database Entity: Primary Record

@table("oauth2_oidc_identity_server_records")
model Oauth2OidcIdentityServerPrimaryRecord {
    @id
    id: Int
    @unique
    referenceCode: String
    capacityScore: Int
    operationalStatus: String
    active: Bool
}
