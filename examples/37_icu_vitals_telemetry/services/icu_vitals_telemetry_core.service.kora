// Example 37: ICU Real-Time High-Frequency Vitals Monitor
// Core Domain Service Implementation

import { IcuVitalsTelemetryClinicalEntity } from "../entities/icu_vitals_telemetry_primary.entity"
import { CreateIcuVitalsTelemetryRecordRequest } from "../models/icu_vitals_telemetry_request.dto"
import { IcuVitalsTelemetryRepository } from "../interfaces/icu_vitals_telemetry_repository.interface"
import { IcuVitalsTelemetryDomainContract } from "../interfaces/icu_vitals_telemetry_service.interface"

class IcuVitalsTelemetryCoreService implements IcuVitalsTelemetryDomainContract {
    repo: IcuVitalsTelemetryRepository

    init(repo: IcuVitalsTelemetryRepository) {
        this.repo = repo
    }

    fn processClinicalRecord(req: CreateIcuVitalsTelemetryRecordRequest) -> Result<IcuVitalsTelemetryClinicalEntity, String> {
        if req.patientId <= 0 {
            return Err("Patient ID must be strictly positive")
        }
        if req.clinicalMetricScore < 0 {
            return Err("Clinical metric score cannot be negative")
        }

        let entity = IcuVitalsTelemetryClinicalEntity {
            id: req.patientId + 5000,
            patientId: req.patientId,
            clinicianId: req.clinicianId,
            clinicalMetricScore: req.clinicalMetricScore,
            complianceState: "AUDITED_SECURE",
            active: true,
        }
        return this.repo.save(entity)
    }

    fn evaluateClinicalRisk(patientId: Int) -> String {
        let opt = this.repo.findByPatientId(patientId)
        let isPresent = match opt {
            Some(r) => true,
            None => false,
        }
        if !isPresent {
            return "RECORD_NOT_FOUND"
        }
        let record = match opt {
            Some(r) => r,
            None => IcuVitalsTelemetryClinicalEntity { id: 0, patientId: 0, clinicianId: 0, clinicalMetricScore: 0, complianceState: "", active: false },
        }
        if record.clinicalMetricScore > 80 {
            return "CRITICAL_OBSERVATION"
        }
        if record.clinicalMetricScore > 40 {
            return "MODERATE_ATTENTION"
        }
        return "NOMINAL_STABLE"
    }
}
