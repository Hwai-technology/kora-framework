// Example 37: ICU Real-Time High-Frequency Vitals Monitor
// Persistent Database Entity: Primary Record

@table("icu_vitals_telemetry_clinical_records")
model IcuVitalsTelemetryClinicalEntity {
    @id
    id: Int
    @unique
    patientId: Int
    clinicianId: Int
    clinicalMetricScore: Int
    complianceState: String
    active: Bool
}
