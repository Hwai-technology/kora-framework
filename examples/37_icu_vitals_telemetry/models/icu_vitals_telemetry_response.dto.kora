// Example 37: ICU Real-Time High-Frequency Vitals Monitor
// Transport Model: Standard Responses

model IcuVitalsTelemetryResponseDto {
    recordId: Int
    patientId: Int
    status: String
    isComplianceVerified: Bool
    message: String
}

model IcuVitalsTelemetrySummaryDto {
    patientId: Int
    totalEntries: Int
    severityCategory: String
    lastReviewedTimestamp: Int
}
