{
  "name": "kora-vscode",
  "displayName": "Kora Language Support",
  "description": "Official syntax highlighting, rich language configuration, snippets, and real-time compiler diagnostics for the Kora programming language and framework.",
  "version": "0.1.0",
  "publisher": "kora-lang",
  "engines": {
    "vscode": "^1.80.0"
  },
  "icon": "./icons/kora-file.svg",
  "main": "./client/extension.js",
  "activationEvents": [
    "onLanguage:kora"
  ],
  "categories": [
    "Programming Languages",
    "Snippets",
    "Linters"
  ],
  "keywords": [
    "kora",
    "rust",
    "backend",
    "syntax",
    "framework"
  ],
  "contributes": {
    "languages": [
      {
        "id": "kora",
        "aliases": [
          "Kora",
          "kora"
        ],
        "extensions": [
          ".kora",
          ".kr"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/kora-file.svg",
          "dark": "./icons/kora-file.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "kora",
        "scopeName": "source.kora",
        "path": "./syntaxes/kora.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "kora",
        "path": "./snippets/kora.snippets.json"
      }
    ],
    "commands": [
      {
        "command": "kora.runFile",
        "title": "Kora: Run File",
        "category": "Kora"
      },
      {
        "command": "kora.checkFile",
        "title": "Kora: Check File",
        "category": "Kora"
      },
      {
        "command": "kora.formatFile",
        "title": "Kora: Format Document",
        "category": "Kora"
      }
    ],
    "iconThemes": [
      {
        "id": "kora-icons",
        "label": "Kora File Icons",
        "path": "./kora-icons.json"
      }
    ]
  }
}
