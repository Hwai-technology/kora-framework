{
  "Data Transfer Model": {
    "prefix": "model",
    "body": [
      "model ${1:Name} {",
      "    ${2:field}: ${3:String}",
      "}"
    ],
    "description": "Create an immutable, pure Data Transfer Object (DTO) model"
  },
  "Database Entity Model": {
    "prefix": "entity",
    "body": [
      "@entity",
      "@table(\"${1:users}\")",
      "model ${2:User} {",
      "    @primary",
      "    @autoIncrement",
      "    id: Int",
      "    @required",
      "    ${3:name}: String",
      "}"
    ],
    "description": "Create a database entity model with ORM decorators"
  },
  "Service Class with DI": {
    "prefix": "class",
    "body": [
      "class ${1:Name}Service implements ${2:Interface} {",
      "    db: Database",
      "",
      "    init(db: Database) {",
      "        this.db = db",
      "    }",
      "",
      "    fn ${3:method}() -> ${4:Unit} {",
      "        ${0}",
      "    }",
      "}"
    ],
    "description": "Create a service class with compile-time Dependency Injection"
  },
  "Interface Declaration": {
    "prefix": "interface",
    "body": [
      "interface ${1:Name} {",
      "    fn ${2:find}(id: Int) -> Option<${3:Model}>",
      "}"
    ],
    "description": "Create a behavioral contract interface"
  },
  "Enum Declaration": {
    "prefix": "enum",
    "body": [
      "enum ${1:Status} {",
      "    ${2:Active},",
      "    ${3:Inactive},",
      "    ${4:Pending}",
      "}"
    ],
    "description": "Create a type-safe enumerated type"
  },
  "Actor Concurrency": {
    "prefix": "actor",
    "body": [
      "class ${1:Counter}Actor {",
      "    var state: Int",
      "",
      "    init() {",
      "        this.state = 0",
      "    }",
      "",
      "    fn handle(msg: ${2:String}) -> Int {",
      "        this.state = this.state + 1",
      "        return this.state",
      "    }",
      "}"
    ],
    "description": "Create an isolated stateful Actor"
  },
  "Async Channel": {
    "prefix": "channel",
    "body": [
      "let ch = channel<${1:String}>(${2:100})",
      "ch.send(${3:value})",
      "let item = ch.recv()"
    ],
    "description": "Create and operate a non-blocking MPSC channel"
  },
  "Spawn Concurrent Task": {
    "prefix": "spawn",
    "body": [
      "spawn(async () => {",
      "    ${0}",
      "})"
    ],
    "description": "Spawn an asynchronous concurrent task"
  },
  "HTTP GET Route": {
    "prefix": "get",
    "body": [
      "get(\"${1:/path}\", (${2:svc: Service}) => {",
      "    return ${0}",
      "})"
    ],
    "description": "Create a zero-config HTTP GET endpoint"
  },
  "HTTP POST Route": {
    "prefix": "post",
    "body": [
      "post(\"${1:/path}\", (request: Request, ${2:svc: Service}) => {",
      "    return ${0}",
      "})"
    ],
    "description": "Create a zero-config HTTP POST endpoint"
  },
  "Match Statement": {
    "prefix": "match",
    "body": [
      "match ${1:value} {",
      "    Some(${2:val}) => ${3:val},",
      "    None => ${4:fallback},",
      "}"
    ],
    "description": "Pattern matching expression"
  },
  "Try Catch Block": {
    "prefix": "try",
    "body": [
      "try {",
      "    ${1:// resilient operation}",
      "} catch (${2:err}) {",
      "    ${0:// handle error}",
      "}"
    ],
    "description": "Resilient structured try-catch error block"
  },
  "For In Loop": {
    "prefix": "for",
    "body": [
      "for ${1:item} in ${2:collection} {",
      "    ${0}",
      "}"
    ],
    "description": "Iterate over collections, arrays, or numeric ranges"
  },
  "Compile-time Constant": {
    "prefix": "const",
    "body": [
      "const ${1:MAX_CONNECTIONS} = ${2:100}"
    ],
    "description": "Declare a compile-time immutable constant"
  }
}
