{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Kora",
  "scopeName": "source.kora",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#constants" },
    { "include": "#operators" },
    { "include": "#functions" },
    { "include": "#declarations" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.kora",
          "match": "//.*$"
        },
        {
          "name": "comment.block.kora",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.kora",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.kora",
          "match": "\\\\([\"\\\\/bfnrt]|u[0-9a-fA-F]{4})"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.kora",
          "match": "\\b\\d[\\d_]*\\.\\d[\\d_]*\\b"
        },
        {
          "name": "constant.numeric.integer.kora",
          "match": "\\b\\d[\\d_]*\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.kora",
          "match": "\\b(if|else|while|return|match)\\b"
        },
        {
          "name": "keyword.declaration.kora",
          "match": "\\b(let|var|fn|async|await|init|implements|module|import|pub|extend)\\b"
        },
        {
          "name": "storage.type.kora",
          "match": "\\b(struct|model|class|interface|enum)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.primitive.kora",
          "match": "\\b(Int|Float|Bool|String|Unit|Database|App|Request|Response)\\b"
        },
        {
          "name": "support.type.composite.kora",
          "match": "\\b(List|Option|Result|Channel)\\b"
        },
        {
          "name": "entity.name.type.class.kora",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.kora",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.language.option.kora",
          "match": "\\b(Some|None|Ok|Err)\\b"
        },
        {
          "name": "variable.language.this.kora",
          "match": "\\bthis\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arrow.kora",
          "match": "(->|=>)"
        },
        {
          "name": "keyword.operator.comparison.kora",
          "match": "(==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.logical.kora",
          "match": "(&&|\\|\\||!)"
        },
        {
          "name": "keyword.operator.assignment.kora",
          "match": "="
        },
        {
          "name": "keyword.operator.arithmetic.kora",
          "match": "(\\+|\\-|\\*|\\/|%)"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "support.function.builtin.kora",
          "match": "\\b(run|send|get|post|put|delete|print|channel)\\b"
        },
        {
          "match": "\\b([a-z][a-zA-Z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": { "name": "entity.name.function.kora" }
          }
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "match": "\\b(fn)\\s+([a-zA-Z0-9_]+)",
          "captures": {
            "1": { "name": "keyword.declaration.kora" },
            "2": { "name": "entity.name.function.kora" }
          }
        },
        {
          "match": "\\b(struct|model|class|interface|enum)\\s+([A-Z][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.kora" },
            "2": { "name": "entity.name.type.class.kora" }
          }
        }
      ]
    }
  }
}

