// ============================================================================
// Automated Unit Tests: Game Session & PIN Generator
// ============================================================================

import { GameSession, GameParticipant } from "../src/models/game.models"

fn test_pin_generation_produces_six_digits() -> Bool {
    let sessionId = 42
    let base = 100000 + (sessionId * 137 % 900000)
    return base >= 100000 && base <= 999999
}

fn test_game_initial_state_is_waiting() -> Bool {
    let session = GameSession {
        id: 1,
        quizId: 10,
        hostId: 100,
        pin: "849201",
        status: "WAITING_FOR_PLAYERS",
        currentQuestionIndex: 0,
        totalQuestions: 15,
        activePlayerCount: 0,
    }
    return session.status == "WAITING_FOR_PLAYERS" && session.activePlayerCount == 0
}

fn test_participant_initial_score_is_zero() -> Bool {
    let participant = GameParticipant {
        id: 1,
        sessionId: 1,
        nickname: "Ahmed",
        token: "tok_sec_101",
        totalScore: 0,
        streak: 0,
        isConnected: true,
    }
    return participant.totalScore == 0 && participant.streak == 0
}

fn main() {
    let t1 = test_pin_generation_produces_six_digits()
    let t2 = test_game_initial_state_is_waiting()
    let t3 = test_participant_initial_score_is_zero()

    if t1 && t2 && t3 {
        print("✓ All Game Session tests passed successfully.")
    } else {
        print("✗ Game Session tests failed.")
    }
}
