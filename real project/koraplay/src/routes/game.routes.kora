// ============================================================================
// KoraPlay Games Domain Routes Module (register to app)
// ============================================================================

import { GamesController } from "../features/games/controllers/game.controller"

class GameRoutes {
    controller: GamesController,

    init(controller: GamesController) {
        this.controller = controller
    }

    fn register(app: App) -> App {
        app.get("/api/v1/games", this.controller.list)
        app.get("/api/v1/games/{id}", this.controller.get_by_id)
        app.post("/api/v1/games", this.controller.create)
        return app
    }
}
