// ============================================================================
// KoraPlay Realtime Domain Routes Module (register to app)
// ============================================================================

import { RealtimeController } from "../realtime/realtime.controller"

class RealtimeRoutes {
    controller: RealtimeController,

    init(controller: RealtimeController) {
        this.controller = controller
    }

    fn register(app: App) -> App {
        app.get("/ws/rooms/{sessionId}/presence", this.controller.presence)
        app.post("/ws/rooms/{sessionId}/broadcast", this.controller.broadcast)
        return app
    }
}
