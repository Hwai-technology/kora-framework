// ============================================================================
// KoraPlay Root & Health Routes Module (register to app)
// ============================================================================

class RootRoutes {
    fn register(app: App) -> App {
        app.get("/", () => {
            return "🎮 KoraPlay Interactive Learning Platform Engine (v0.1.0) running on http://127.0.0.1:7582"
        })

        app.get("/health", () => {
            return "{\"status\": \"UP\", \"service\": \"koraplay\", \"engine\": \"kora-v0.2.0\", \"healthy\": true}"
        })

        return app
    }
}
