// ============================================================================
// KoraPlay Initial Database Seeder
// Seeds default users, quizzes, and game sessions for local & test environments
// ============================================================================

import { UserEntity } from "../features/users/models/user.entity"
import { QuizEntity } from "../features/quizzes/models/quiz.entity"
import { GameEntity } from "../features/games/models/game.entity"

class DatabaseSeeder {
    db: Database

    init(db: Database) {
        this.db = db
    }

    fn run() -> Result<Bool, String> {
        // 1. Seed Superadmin User
        this.db.execute("INSERT INTO users (id, name, email, active) VALUES (1, 'Super Admin', 'admin@koraplay.io', true) ON CONFLICT (email) DO NOTHING")

        // 2. Seed Demo Teacher
        this.db.execute("INSERT INTO users (id, name, email, active) VALUES (2, 'Teacher Sarah', 'sarah@koraplay.io', true) ON CONFLICT (email) DO NOTHING")

        // 3. Seed Default Public Quiz
        this.db.execute("INSERT INTO quizzes (id, name, active) VALUES (1, 'World Geography & Science Cup', true) ON CONFLICT (id) DO NOTHING")

        // 4. Seed Live Lobby Session
        this.db.execute("INSERT INTO games (id, name, active) VALUES (1, 'KoraPlay Championship 2026', true) ON CONFLICT (id) DO NOTHING")

        return Ok(true)
    }
}
