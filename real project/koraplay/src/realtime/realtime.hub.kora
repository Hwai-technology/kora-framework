// ============================================================================
// KoraPlay Realtime WebSocket Hub & Event Broadcaster
// ============================================================================

import { WebSocketEnvelope, RoomState } from "../models/realtime.models"

class RealtimeHubService {
    fn broadcastToRoom(sessionId: Int, eventType: String, payload: String) -> WebSocketEnvelope {
        return WebSocketEnvelope {
            eventType: eventType,
            sessionId: sessionId,
            participantId: 0,
            payload: payload,
            timestamp: 1773005500,
        }
    }

    fn sendToParticipant(sessionId: Int, participantId: Int, eventType: String, payload: String) -> WebSocketEnvelope {
        return WebSocketEnvelope {
            eventType: eventType,
            sessionId: sessionId,
            participantId: participantId,
            payload: payload,
            timestamp: 1773005500,
        }
    }

    fn getRoomPresence(sessionId: Int) -> RoomState {
        return RoomState {
            sessionId: sessionId,
            pin: "849201",
            activePlayers: 42,
            status: "QUESTION_ACTIVE",
        }
    }
}
