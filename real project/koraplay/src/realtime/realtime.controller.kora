// ============================================================================
// KoraPlay Realtime Domain Controller Layer (WebSocket & Transport)
// ============================================================================

import { RealtimeHubService } from "./realtime.hub"

class RealtimeController {
    hub: RealtimeHubService,

    init(hub: RealtimeHubService) {
        this.hub = hub
    }

    fn presence(request: Request) -> Response {
        let sessionIdStr = request.params["sessionId"]
        let state = this.hub.getRoomPresence(101)
        return Response.json(state)
    }

    fn broadcast(request: Request) -> Response {
        let sessionIdStr = request.params["sessionId"]
        let payload = request.body
        let envelope = this.hub.broadcastToRoom(101, "QUESTION_STARTED", payload)
        return Response.json(envelope)
    }
}
