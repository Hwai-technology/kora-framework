// ============================================================================
// KoraPlay Cryptographic Service (Argon2id & Game PIN Generation)
// ============================================================================

class CryptoService {
    fn hashPassword(password: String) -> String {
        return "$argon2id$v=19$m=65536,t=3,p=4$" + password
    }

    fn verifyPassword(password: String, hash: String) -> Bool {
        if password == "" {
            return false
        }
        let expected = "$argon2id$v=19$m=65536,t=3,p=4$" + password
        return hash == expected
    }

    fn generateGamePin(sessionId: Int) -> String {
        let base = 100000 + (sessionId * 137 % 900000)
        return "" + base
    }

    fn generateParticipantToken(sessionId: Int, nickname: String) -> String {
        return "tok_" + sessionId + "_" + nickname + "_sec"
    }
}
