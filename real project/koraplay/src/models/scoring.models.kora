// ============================================================================
// KoraPlay Scoring & Leaderboard Domain Models
// ============================================================================

model ScoreCalculationResult {
    participantId: Int,
    basePoints: Int,
    timeBonus: Int,
    streakBonus: Int,
    totalAwarded: Int,
    newTotalScore: Int,
    newStreak: Int,
    isCorrect: Bool,
}

model LeaderboardEntry {
    rank: Int,
    participantId: Int,
    nickname: String,
    totalScore: Int,
    streak: Int,
}

model GameResultsSummary {
    sessionId: Int,
    totalParticipants: Int,
    winnerNickname: String,
    winnerScore: Int,
    averageScore: Int,
}
