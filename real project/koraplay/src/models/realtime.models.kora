// ============================================================================
// KoraPlay Realtime WebSocket Models
// ============================================================================

model WebSocketEnvelope {
    eventType: String,
    sessionId: Int,
    participantId: Int,
    payload: String,
    timestamp: Int,
}

model RoomState {
    sessionId: Int,
    pin: String,
    activePlayers: Int,
    status: String,
}
