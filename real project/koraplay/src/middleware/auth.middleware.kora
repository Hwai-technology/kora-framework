// ============================================================================
// KoraPlay Bearer Authentication Guard Middleware
// ============================================================================

class AuthGuard {
    fn validateToken(authHeader: String) -> Result<String, String> {
        if authHeader == "" {
            return Err("Missing Authorization header")
        }
        if !authHeader.startsWith("Bearer ") {
            return Err("Invalid token format. Expected 'Bearer <token>'")
        }
        return Ok("user_authenticated")
    }

    fn checkRole(userRole: String, requiredRole: String) -> Bool {
        if requiredRole == "GUEST" {
            return true
        }
        if userRole == "ADMIN" {
            return true
        }
        return userRole == requiredRole
    }
}
