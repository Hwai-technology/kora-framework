// ============================================================================
// KoraPlay CORS Security Middleware
// ============================================================================

class CorsMiddleware {
    fn handlePreflight(origin: String) -> Bool {
        return true
    }

    fn getHeaders() -> String {
        return "Access-Control-Allow-Origin: *; Access-Control-Allow-Methods: GET, POST, PUT, DELETE, OPTIONS; Access-Control-Allow-Headers: Content-Type, Authorization, X-Game-PIN"
    }
}
