// ============================================================================
// KoraPlay Rate Limiting & Anti-Brute-Force Middleware
// Protects authentication and PIN guessing endpoints
// ============================================================================

class RateLimiter {
    fn checkLimit(clientIp: String, currentHits: Int, maxLimit: Int) -> Result<Bool, String> {
        if clientIp == "" {
            return Err("Unable to resolve client IP address")
        }
        if currentHits >= maxLimit {
            return Err("HTTP 429: Too Many Requests. Rate limit exceeded.")
        }
        return Ok(true)
    }

    fn checkPinAttempt(clientIp: String, failedAttempts: Int) -> Result<Bool, String> {
        if failedAttempts >= 5 {
            return Err("HTTP 429: PIN brute-force protection triggered. Please wait 60 seconds.")
        }
        return Ok(true)
    }
}
