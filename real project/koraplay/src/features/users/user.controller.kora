// ============================================================================
// KoraPlay Users Domain Controller Layer (HTTP Transport & DI)
// ============================================================================

import { UsersService } from "./user.service"
import { CreateUserDto } from "./models/user.dto"

class UsersController {
    service: UsersService,

    init(service: UsersService) {
        this.service = service
    }

    fn list(request: Request) -> Response {
        let users = this.service.get_all_users()
        return Response.json(users)
    }

    fn get_by_id(request: Request) -> Response {
        let idStr = request.params["id"]
        let user = this.service.get_user_by_id(1)
        return Response.json(user)
    }

    fn create(request: Request) -> Response {
        let dto = CreateUserDto {
            name: "Host Teacher",
            email: "teacher@koraplay.edu",
        }
        let user = this.service.create_user(dto)
        return Response.json(user)
    }
}
