import { CreateScoringDto } from "../models/scoring.dto"
import { ScoringValidator } from "../validators/scoring.validator"
import { ScoringError } from "../errors/scoring.errors"

fn test_validation_passes() -> Bool {
    let validator = ScoringValidator()
    let valid_dto = CreateScoringDto {
        name: "Valid Scoring",
    }
    let res = validator.validate_create(valid_dto)
    return match res {
        Ok(valid) => valid,
        Err(e) => false,
    }
}

fn test_validation_fails_on_empty() -> Bool {
    let validator = ScoringValidator()
    let empty_dto = CreateScoringDto {
        name: "",
    }
    let res = validator.validate_create(empty_dto)
    return match res {
        Ok(valid) => false,
        Err(e) => true,
    }
}

fn main() {
    let p1 = test_validation_passes()
    let p2 = test_validation_fails_on_empty()
    if p1 && p2 {
        print("✓ All Scoring feature tests passed!")
    } else {
        print("✗ Feature tests failed")
    }
}
