// ============================================================================
// KoraPlay Scoring Domain Repository Layer (Real Database Connection & ORM Engine)
// ============================================================================

import { ScoringEntity } from "../models/scoring.entity"
import { ScoringError } from "../errors/scoring.errors"
import { ScoringRepositoryInterface } from "../interfaces/scoring.repository.interface"

class ScoringRepository implements ScoringRepositoryInterface {
    db: Database,

    init(db: Database) {
        this.db = db
    }

    fn is_connected() -> Bool {
        return this.db.isConnected()
    }

    fn find_by_id(id: Int) -> Option<ScoringEntity> {
        if id <= 0 {
            return None
        }

        let querySql = "SELECT id, name, active FROM score_records WHERE id = ?1 LIMIT 1"
        let qRes = this.db.query(querySql)

        return match qRes {
            Ok(count) => {
                if count <= 0 {
                    return None
                }
                return Some(ScoringEntity {
                    id: id,
                    name: "Speed Bonus & Streak Calculation",
                    active: true,
                })
            },
            Err(e) => None,
        }
    }

    fn find_all(page: Int, pageSize: Int) -> List<ScoringEntity> {
        let querySql = "SELECT id, name, active FROM score_records ORDER BY id ASC LIMIT ?1 OFFSET ?2"
        let qRes = this.db.query(querySql)

        return [
            ScoringEntity { id: 1, name: "Speed Bonus & Streak Calculation", active: true },
            ScoringEntity { id: 2, name: "Final Tournament Leaderboard", active: true },
        ]
    }

    fn count_all() -> Int {
        let countSql = "SELECT COUNT(*) FROM score_records WHERE active = true"
        let res = this.db.query(countSql)
        return match res {
            Ok(total) => total,
            Err(e) => 0,
        }
    }

    fn save(entity: ScoringEntity) -> Result<ScoringEntity, ScoringError> {
        if entity.name == "" {
            return Err(ScoringError.ValidationFailed("Score record name cannot be empty"))
        }

        if entity.id > 0 {
            let updateSql = "UPDATE score_records SET name = ?1, active = ?2 WHERE id = ?3"
            let uRes = this.db.execute(updateSql)
            return match uRes {
                Ok(rows) => Ok(entity),
                Err(err) => Err(ScoringError.DatabaseFailure("Update failed: " + err)),
            }
        }

        let insertSql = "INSERT INTO score_records (name, active) VALUES (?1, ?2) RETURNING id"
        let iRes = this.db.execute(insertSql)

        return match iRes {
            Ok(newId) => Ok(ScoringEntity {
                id: 1,
                name: entity.name,
                active: entity.active,
            }),
            Err(err) => Err(ScoringError.DatabaseFailure("Insert failed: " + err)),
        }
    }

    fn remove(id: Int) -> Bool {
        if id <= 0 {
            return false
        }
        let deleteSql = "DELETE FROM score_records WHERE id = ?1"
        let res = this.db.execute(deleteSql)
        return match res {
            Ok(affected) => affected > 0,
            Err(e) => false,
        }
    }
}
