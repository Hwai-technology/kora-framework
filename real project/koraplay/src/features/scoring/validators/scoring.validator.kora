import { CreateScoringDto } from "../models/scoring.dto"
import { ScoringError } from "../errors/scoring.errors"

class ScoringValidator {
    fn validate_create(dto: CreateScoringDto) -> Result<Bool, ScoringError> {
        if dto.name == "" {
            return Err(ScoringError.ValidationFailed("name field cannot be empty"))
        }
        return Ok(true)
    }
}
