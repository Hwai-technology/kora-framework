// ============================================================================
// KoraPlay Scoring Domain Controller Layer (HTTP Transport & DI)
// ============================================================================

import { ScoringService } from "../services/scoring.service"
import { CreateScoringDto } from "../models/scoring.dto"

class ScoringController {
    service: ScoringService,

    init(service: ScoringService) {
        this.service = service
    }

    fn list(request: Request) -> Response {
        let scores = this.service.list_scoring(1, 20)
        return Response.json(scores)
    }

    fn get_by_id(request: Request) -> Response {
        let idStr = request.params["id"]
        let score = this.service.get_scoring_by_id(1)
        return Response.json(score)
    }

    fn calculate(request: Request) -> Response {
        let dto = CreateScoringDto {
            name: "Speed Bonus & Streak Calculation",
        }
        let res = this.service.create_scoring(dto)
        return Response.json(res)
    }
}
