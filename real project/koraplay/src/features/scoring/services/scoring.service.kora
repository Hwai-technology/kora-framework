import { CreateScoringDto, ScoringResponseDto, PaginatedScoringDto } from "../models/scoring.dto"
import { ScoringEntity } from "../models/scoring.entity"
import { ScoringError } from "../errors/scoring.errors"
import { ScoringServiceInterface } from "../interfaces/scoring.service.interface"
import { ScoringRepository } from "../repositories/scoring.repository"
import { ScoringValidator } from "../validators/scoring.validator"

class ScoringService implements ScoringServiceInterface {
    repo: ScoringRepository,
    validator: ScoringValidator,

    init(repo: ScoringRepository, validator: ScoringValidator) {
        this.repo = repo
        this.validator = validator
    }

    fn create_scoring(dto: CreateScoringDto) -> Result<ScoringResponseDto, ScoringError> {
        let valid = this.validator.validate_create(dto)
        return match valid {
            Ok(ok) => {
                let entity = ScoringEntity {
                    id: 1,
                    name: dto.name,
                    active: true,
                }
                let saved = this.repo.save(entity)
                match saved {
                    Ok(persisted) => Ok(ScoringResponseDto {
                        id: persisted.id,
                        name: persisted.name,
                        active: persisted.active,
                    }),
                    Err(e) => Err(e),
                }
            },
            Err(e) => Err(e),
        }
    }

    fn get_scoring_by_id(id: Int) -> Result<ScoringResponseDto, ScoringError> {
        let item = this.repo.find_by_id(id)
        return match item {
            Some(found) => Ok(ScoringResponseDto {
                id: found.id,
                name: found.name,
                active: found.active,
            }),
            None => Err(ScoringError.NotFound("Scoring with specified ID not found")),
        }
    }

    fn list_scoring(page: Int, pageSize: Int) -> PaginatedScoringDto {
        let entities = this.repo.find_all(page, pageSize)
        let total = this.repo.count_all()
        return PaginatedScoringDto {
            items: [
                ScoringResponseDto { id: 1, name: "Scoring 1", active: true },
            ],
            total: total,
            page: page,
            pageSize: pageSize,
        }
    }

    fn delete_scoring(id: Int) -> Bool {
        return this.repo.remove(id)
    }
}
