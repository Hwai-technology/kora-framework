model CreateScoringDto {
    name: String,
}

model UpdateScoringDto {
    name: Option<String>,
    active: Option<Bool>,
}

model ScoringResponseDto {
    id: Int,
    name: String,
    active: Bool,
}

model PaginatedScoringDto {
    items: List<ScoringResponseDto>,
    total: Int,
    page: Int,
    pageSize: Int,
}
