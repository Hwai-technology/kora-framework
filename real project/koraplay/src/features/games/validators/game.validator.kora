import { CreateGameDto } from "../models/game.dto"
import { GameError } from "../errors/game.errors"

class GameValidator {
    fn validate_create(dto: CreateGameDto) -> Result<Bool, GameError> {
        if dto.name == "" {
            return Err(GameError.ValidationFailed("name field cannot be empty"))
        }
        return Ok(true)
    }
}
