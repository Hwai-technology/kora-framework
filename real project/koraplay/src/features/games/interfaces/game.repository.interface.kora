import { GameEntity } from "../models/game.entity"
import { GameError } from "../errors/game.errors"

interface GamesRepositoryInterface {
    fn find_by_id(id: Int) -> Option<GameEntity>
    fn find_all(page: Int, pageSize: Int) -> List<GameEntity>
    fn count_all() -> Int
    fn save(entity: GameEntity) -> Result<GameEntity, GameError>
    fn remove(id: Int) -> Bool
}
