model CreateGameDto {
    name: String,
}

model UpdateGameDto {
    name: Option<String>,
    active: Option<Bool>,
}

model GameResponseDto {
    id: Int,
    name: String,
    active: Bool,
}

model PaginatedGamesDto {
    items: List<GameResponseDto>,
    total: Int,
    page: Int,
    pageSize: Int,
}
