model CreateQuizzeDto {
    name: String,
}

model UpdateQuizzeDto {
    name: Option<String>,
    active: Option<Bool>,
}

model QuizzeResponseDto {
    id: Int,
    name: String,
    active: Bool,
}

model PaginatedQuizzesDto {
    items: List<QuizzeResponseDto>,
    total: Int,
    page: Int,
    pageSize: Int,
}
