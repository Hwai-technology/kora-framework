import { CreateQuizzeDto, QuizzeResponseDto, PaginatedQuizzesDto } from "../models/quiz.dto"
import { QuizzeEntity } from "../models/quiz.entity"
import { QuizzeError } from "../errors/quiz.errors"
import { QuizzesServiceInterface } from "../interfaces/quiz.service.interface"
import { QuizzesRepository } from "../repositories/quiz.repository"
import { QuizzeValidator } from "../validators/quiz.validator"

class QuizzesService implements QuizzesServiceInterface {
    repo: QuizzesRepository,
    validator: QuizzeValidator,

    init(repo: QuizzesRepository, validator: QuizzeValidator) {
        this.repo = repo
        this.validator = validator
    }

    fn create_quizze(dto: CreateQuizzeDto) -> Result<QuizzeResponseDto, QuizzeError> {
        let valid = this.validator.validate_create(dto)
        return match valid {
            Ok(ok) => {
                let entity = QuizzeEntity {
                    id: 1,
                    name: dto.name,
                    active: true,
                }
                let saved = this.repo.save(entity)
                match saved {
                    Ok(persisted) => Ok(QuizzeResponseDto {
                        id: persisted.id,
                        name: persisted.name,
                        active: persisted.active,
                    }),
                    Err(e) => Err(e),
                }
            },
            Err(e) => Err(e),
        }
    }

    fn get_quizze_by_id(id: Int) -> Result<QuizzeResponseDto, QuizzeError> {
        let item = this.repo.find_by_id(id)
        return match item {
            Some(found) => Ok(QuizzeResponseDto {
                id: found.id,
                name: found.name,
                active: found.active,
            }),
            None => Err(QuizzeError.NotFound("Quizze with specified ID not found")),
        }
    }

    fn list_quizzes(page: Int, pageSize: Int) -> PaginatedQuizzesDto {
        let entities = this.repo.find_all(page, pageSize)
        let total = this.repo.count_all()
        return PaginatedQuizzesDto {
            items: [
                QuizzeResponseDto { id: 1, name: "Quizze 1", active: true },
            ],
            total: total,
            page: page,
            pageSize: pageSize,
        }
    }

    fn delete_quizze(id: Int) -> Bool {
        return this.repo.remove(id)
    }
}
