// ============================================================================
// KoraPlay Interactive Learning Platform — Server Application Entrypoint
// Pure Layered Clean Architecture: App -> Middleware -> Routes -> Controller -> Service -> Repository -> Database
// ============================================================================

import { App } from "kora/http"
import { CorsMiddleware } from "./middleware/cors.middleware"
import { RateLimiter } from "./middleware/rate_limit.middleware"
import { AuthGuard } from "./middleware/auth.middleware"
import { RootRoutes } from "./routes/api.routes"
import { UserRoutes } from "./routes/user.routes"
import { QuizRoutes } from "./routes/quiz.routes"
import { GameRoutes } from "./routes/game.routes"
import { ScoringRoutes } from "./routes/scoring.routes"
import { RealtimeRoutes } from "./routes/realtime.routes"

// 1. Application Container Initialization
let app = App()

// 2. Global Security & Rate-Limiting Middleware Pipeline
app.use(CorsMiddleware)
app.use(RateLimiter)
app.use(AuthGuard)

// 3. Domain Route Modules Registration
app.use(RootRoutes)
app.use(UserRoutes)
app.use(QuizRoutes)
app.use(GameRoutes)
app.use(ScoringRoutes)
app.use(RealtimeRoutes)

// 4. Server Listener & Startup
app.listen(7582)
