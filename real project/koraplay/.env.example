# Kora Server Configuration
PORT=7582
HOST=127.0.0.1
ENVIRONMENT=development
LOG_LEVEL=info

# Database Connection (PostgreSQL / SQLite / MySQL)
DATABASE_URL=postgres://kora_user:kora_secret@localhost:5432/koraplay_db
DATABASE_POOL_SIZE=10

# Redis Cache & Realtime WebSocket
REDIS_URL=redis://localhost:6379

# Authentication Secrets
JWT_SECRET=super_secret_kora_jwt_token_change_in_production_32chars
JWT_EXPIRATION_HOURS=24
